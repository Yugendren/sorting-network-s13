+[features]
+# LIMITS-V3: compile-time selection of MAX_CHANNELS.
+#
+# Default (no feature): MAX_CHANNELS = 11 — byte-for-byte the pre-LIMITS-V3
+# code, so every n<=11 run is unaffected and the regression bar is met by
+# construction rather than by measurement.
+#
+# `wide12` raises it to 12, `wide13` to 13. They are additive (wide13 implies
+# wide12) so that `cfg(feature = "wide12")` reads as ">= 12" everywhere.
+#
+# What the wide builds cost, and why this is a feature rather than a plain
+# constant raise: several hot-path types are fixed-capacity arrays sized from
+# MAX_CHANNELS — `PackedSet` is `[u64; 2^MAX_CHANNELS / 64]` and is `Copy`,
+# and `subsumes_permuted_packed` copies two of them per exact test. Raising
+# MAX_CHANNELS to 13 makes that 2 x 1040 bytes instead of 2 x 272 on every
+# exact subsumption test, at every width, including n=9. Feature-gating keeps
+# that cost off the n<=11 builds entirely.
+default = []
+wide12 = []
+wide13 = ["wide12"]
+
 [dependencies]
 log = "0.4.11"
 env_logger = "0.7.1"
