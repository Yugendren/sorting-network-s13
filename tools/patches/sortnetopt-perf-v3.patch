+
+        let output_paths = groups
+            .iter()
+            .map(|group| input.join(&group.name).with_extension("pbin"))
+            .collect::<Vec<_>>();
+
+        if output_paths.iter().all(|path| path.exists()) {
+            log::info!("{} channels: all outputs already exist", channels);
+            continue;
