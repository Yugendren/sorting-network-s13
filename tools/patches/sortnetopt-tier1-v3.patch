+    /// `channels!` permutations, `<= 5040`). For `channels` in `8..=9` only
+    /// the returned-permutation validity is checked exhaustively-in-spirit
+    /// (it is always checked when `Some`), plus a cheap *necessary*
+    /// condition on `None` results: channel permutations preserve Hamming
+    /// weight, so if `hist_subsumes(weight_histogram(a), weight_histogram(b))`
+    /// fails, no permutation of `a` can subsume `b`, and the result must be
+    /// `None`.
+    #[test]
+    fn subsumes_permuted_packed_matches_brute_force() {
+        for channels in 2..=9usize {
+            let mut rng = Xorshift64::new(0xABCD_1234_5678_9ABCu64 ^ (channels as u64).wrapping_mul(0x9E37_79B9_7F4A_7C15));
+            let exhaustive_perms = if channels <= 7 {
+                Some(all_permutations(channels))
+            } else {
+                None
+            };
+
+            let pairs = if channels <= 6 { 200 } else { 120 };
+            let mut saw_hit = false;
+
+            for _ in 0..pairs {
+                let (a_os, b_os) = generate_pair(channels, &mut rng);
+
+                let a_packed = PackedSet::from_bitmap(a_os.as_ref());
+                let b_packed = PackedSet::from_bitmap(b_os.as_ref());
+
+                let result = subsumes_permuted_packed(&a_packed, &b_packed);
