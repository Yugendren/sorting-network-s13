+    impl Xorshift64 {
+        fn new(seed: u64) -> Self {
+            Self(seed | 1)
+        }
+
+        fn next(&mut self) -> u64 {
+            let mut x = self.0;
+            x ^= x << 13;
+            x ^= x >> 7;
+            x ^= x << 17;
+            self.0 = x;
+            x
+        }
+
+        fn below(&mut self, bound: usize) -> usize {
+            (self.next() % bound as u64) as usize
+        }
+
+        fn pair(&mut self, k: usize) -> Option<[usize; 2]> {
+            if k < 2 {
+                return None;
+            }
+            let a = self.below(k);
+            let mut b = self.below(k);
+            while b == a {
+                b = self.below(k);
+            }
+            Some([a, b])
+        }
+    }
+
+    /// Builds `count` snapshots of an `OutputSet` for `channels`, starting
+    /// from `all_values` (an all-true edge case) and applying a
+    /// deterministic pseudo-random sequence of comparators; later
+    /// snapshots trend towards very sparse sets since sorting-network
+    /// comparators only ever merge (never split) reachable outputs.
+    fn build_sets(channels: usize, seed: u64, count: usize) -> Vec<OutputSet<Vec<bool>>> {
+        let mut rng = Xorshift64::new(seed);
+        let mut current = OutputSet::all_values(channels);
+        let mut snapshots = vec![current.clone()];
+
+        let steps = count.max(20) * 2;
+        for _ in 0..steps {
+            if let Some(pair) = rng.pair(channels) {
+                current.apply_comparator(pair);
+                snapshots.push(current.clone());
+            } else {
+                break;
+            }
+        }
