+/// Per-`(width, popcount)` live counts ("shell census"), maintained
+/// incrementally by [`record_entry_added_shell`] / [`record_entry_removed_shell`]
+/// so the shell histogram falls out of a run instead of out of a dump.
+/// `popcount` ranges `0..=2^width`; lazily allocated (only when
+/// [`shell_stats_enabled`] is true) as one `Vec<AtomicU64>` per tracked
+/// width.
+type ShellCensusTable = Vec<Vec<AtomicU64>>;
+
+static SHELL_CENSUS: OnceLock<ShellCensusTable> = OnceLock::new();
+
+fn shell_census_table() -> &'static ShellCensusTable {
+    SHELL_CENSUS.get_or_init(|| {
+        (0..MAX_TRACKED_CHANNELS)
+            .map(|w| (0..=(1usize << w)).map(|_| AtomicU64::new(0)).collect())
+            .collect()
+    })
