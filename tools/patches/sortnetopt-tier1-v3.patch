+//! Bit-packed mirror of [`OutputSet`]'s dense `[bool]` bitmap.
+//!
+//! One bit per Boolean vector, LSB-first, in `u64` words: bit `i` of the
+//! bitmap lives in word `i >> 6`, bit position `i & 63`. This is the same
+//! layout as `OutputSet::pack_into_slice`'s byte layout on a little-endian
+//! machine (byte `b` holds bits `8*b .. 8*b+7`, and here word `w` holds
+//! bytes `8*w .. 8*w+7`).
+
+use super::{OutputSet, WVec, MAX_CHANNELS};
+
+/// Maximum number of live `u64` words for any `channels <= MAX_CHANNELS`.
+pub const MAX_WORDS: usize = super::MAX_BITMAP_SIZE / 64;
+
+/// Table of masks, indexed by bit position `c` in `0..6`: `BIT_MASK[c]` has
+/// bit `p` set (for `p` in `0..64`) iff bit `c` of `p` is set.
+const fn bit_masks() -> [u64; 6] {
+    let mut masks = [0u64; 6];
+    let mut c = 0usize;
+    while c < 6 {
+        let mut p = 0usize;
+        while p < 64 {
+            if (p >> c) & 1 == 1 {
+                masks[c] |= 1u64 << p;
+            }
+            p += 1;
+        }
+        c += 1;
+    }
+    masks
+}
+
+const BIT_MASK: [u64; 6] = bit_masks();
+
+/// Table of masks, indexed by popcount `t` in `0..=6`: `INWORD[t]` has bit
+/// `p` set (for `p` in `0..64`) iff `p.count_ones() == t`.
+const fn inword_masks() -> [u64; 7] {
+    let mut masks = [0u64; 7];
+    let mut p = 0usize;
+    while p < 64 {
+        let t = (p as u32).count_ones() as usize;
+        masks[t] |= 1u64 << p;
+        p += 1;
+    }
+    masks
+}
+
+const INWORD: [u64; 7] = inword_masks();
+
+/// Bit-packed mirror of `OutputSet`'s dense `[bool]` bitmap.
+#[derive(Clone, Copy, Debug)]
+pub struct PackedSet {
+    channels: usize,
+    words: usize,
+    bits: [u64; MAX_WORDS],
+}
+
+impl PartialEq for PackedSet {
+    fn eq(&self, other: &Self) -> bool {
+        self.eq_packed(other)
+    }
+}
+
+impl Eq for PackedSet {}
+
+impl PackedSet {
+    fn words_for_channels(channels: usize) -> usize {
+        ((1usize << channels) / 64).max(1)
+    }
+
+    /// Debug-only invariant check: only `words` words are live, and for
+    /// `channels < 6` only the low `1 << channels` bits of word 0 may ever
+    /// be set.
+    fn check_clean(&self) {
+        debug_assert!(self.channels <= MAX_CHANNELS);
+        debug_assert_eq!(self.words, Self::words_for_channels(self.channels));
+        if self.channels < 6 {
+            let n = 1usize << self.channels;
+            let mask = (1u64 << n) - 1;
+            debug_assert_eq!(self.bits[0] & !mask, 0);
+        }
+    }
+
+    pub fn channels(&self) -> usize {
+        self.channels
+    }
+
+    pub fn words(&self) -> usize {
+        self.words
+    }
+
+    pub fn bits(&self) -> &[u64] {
+        &self.bits[..self.words]
+    }
+
+    pub fn zeros(channels: usize) -> Self {
+        debug_assert!(channels <= MAX_CHANNELS);
+        let result = Self {
+            channels,
+            words: Self::words_for_channels(channels),
+            bits: [0u64; MAX_WORDS],
+        };
+        result.check_clean();
+        result
+    }
+
+    pub fn from_bitmap(set: OutputSet<&[bool]>) -> Self {
+        let channels = set.channels();
+        let mut result = Self::zeros(channels);
+        for (i, &present) in set.bitmap().iter().enumerate() {
+            if present {
+                result.bits[i >> 6] |= 1u64 << (i & 63);
+            }
+        }
+        result.check_clean();
+        result
+    }
+
+    pub fn from_packed_bytes(channels: usize, packed: &[u8]) -> Self {
+        debug_assert_eq!(packed.len(), OutputSet::packed_len_for_channels(channels));
+        let mut result = Self::zeros(channels);
+        for (i, &byte) in packed.iter().enumerate() {
+            result.bits[i / 8] |= (byte as u64) << ((i % 8) * 8);
+        }
+        result.check_clean();
+        result
+    }
+
+    pub fn write_bitmap_into(&self, mut target: OutputSet<&mut [bool]>) {
+        debug_assert_eq!(target.channels(), self.channels);
+        for (i, slot) in target.bitmap_mut().iter_mut().enumerate() {
+            *slot = (self.bits[i >> 6] >> (i & 63)) & 1 != 0;
+        }
+    }
+
+    pub fn to_output_set(&self) -> OutputSet<Vec<bool>> {
+        let mut bitmap = vec![false; 1usize << self.channels];
+        self.write_bitmap_into(OutputSet::from_bitmap(self.channels, bitmap.as_mut_slice()));
+        OutputSet::from_bitmap(self.channels, bitmap)
+    }
+
+    pub fn eq_packed(&self, other: &Self) -> bool {
+        self.channels == other.channels && self.bits[..self.words] == other.bits[..other.words]
+    }
+
+    /// Plain scalar/auto-vectorizable implementation of
+    /// `OutputSet::subsumes_unpermuted`: `self.bits[w] & !other.bits[w] == 0`
+    /// for every live word `w`.
+    pub fn subsumes_unpermuted_scalar(&self, other: &Self) -> bool {
+        debug_assert_eq!(self.channels, other.channels);
+        let mut acc = 0u64;
+        for w in 0..self.words {
+            acc |= self.bits[w] & !other.bits[w];
+        }
+        acc == 0
+    }
+
+    /// `OutputSet::subsumes_unpermuted`-equivalent check.
+    ///
+    /// On `aarch64`, uses an explicit NEON path processing two words (128
+    /// bits) per iteration with a scalar tail. NEON is part of the aarch64
+    /// baseline instruction set (unlike x86 AVX/SSE extensions), so no
+    /// runtime feature detection is required before using it; the `unsafe`
+    /// block below is sound on every aarch64 target Rust supports.
+    /// On every other target this just calls [`Self::subsumes_unpermuted_scalar`].
+    #[cfg(target_arch = "aarch64")]
+    pub fn subsumes_unpermuted(&self, other: &Self) -> bool {
+        use std::arch::aarch64::{vandq_u64, vdupq_n_u64, vgetq_lane_u64, vld1q_u64, vmvnq_u32, vorrq_u64, vreinterpretq_u32_u64, vreinterpretq_u64_u32};
+
+        debug_assert_eq!(self.channels, other.channels);
+
+        let words = self.words;
+        let mut w = 0usize;
+
+        // Safety: aarch64 NEON is a baseline extension on all aarch64
+        // targets, so these intrinsics are always available. `w + 2 <=
+        // words <= MAX_WORDS` keeps every `add(w)` load in-bounds of the
+        // `[u64; MAX_WORDS]` arrays.
+        unsafe {
+            let mut acc = vdupq_n_u64(0);
+            while w + 2 <= words {
+                let a = vld1q_u64(self.bits.as_ptr().add(w));
+                let b = vld1q_u64(other.bits.as_ptr().add(w));
+                let not_b = vreinterpretq_u64_u32(vmvnq_u32(vreinterpretq_u32_u64(b)));
+                let bic = vandq_u64(a, not_b);
+                acc = vorrq_u64(acc, bic);
+                w += 2;
+            }
+            let lane0 = vgetq_lane_u64(acc, 0);
+            let lane1 = vgetq_lane_u64(acc, 1);
+            if lane0 | lane1 != 0 {
+                return false;
+            }
+        }
+
+        let mut tail = 0u64;
+        while w < words {
+            tail |= self.bits[w] & !other.bits[w];
+            w += 1;
+        }
+        tail == 0
+    }
+
+    #[cfg(not(target_arch = "aarch64"))]
+    pub fn subsumes_unpermuted(&self, other: &Self) -> bool {
+        self.subsumes_unpermuted_scalar(other)
+    }
+
+    pub fn swap_channels(&mut self, channels: [usize; 2]) {
+        debug_assert!(channels[0] < self.channels);
+        debug_assert!(channels[1] < self.channels);
+
+        let (c0, c1) = if channels[0] <= channels[1] {
+            (channels[0], channels[1])
+        } else {
+            (channels[1], channels[0])
+        };
+
+        if c0 == c1 {
+            return;
+        }
+
+        if c1 < 6 {
+            // Case A: both bit positions are inside a word. Hacker's
+            // Delight delta swap.
+            let d = (1usize << c1) - (1usize << c0);
+            let m = BIT_MASK[c0] & !BIT_MASK[c1];
+            for w in 0..self.words {
+                let x = self.bits[w];
+                let t = ((x >> d) ^ x) & m;
+                self.bits[w] = x ^ t ^ (t << d);
+            }
+        } else if c0 < 6 {
+            // Case B: c0 is in-word, c1 is a word-index bit.
+            let s = 1usize << c0;
+            let mmask = BIT_MASK[c0];
+            let w_bit = c1 - 6;
+            let bit = 1usize << w_bit;
+            let mut w = 0usize;
+            while w < self.words {
+                if w & bit == 0 {
+                    let w2 = w | bit;
+                    let a = self.bits[w];
+                    let b = self.bits[w2];
+                    self.bits[w] = (a & !mmask) | ((b << s) & mmask);
+                    self.bits[w2] = (b & mmask) | ((a >> s) & !mmask);
+                }
+                w += 1;
+            }
+        } else {
+            // Case C: both are word-index bits -- pure word permutation.
+            let b0 = c0 - 6;
+            let b1 = c1 - 6;
+            let bit0 = 1usize << b0;
+            let bit1 = 1usize << b1;
+            for w in 0..self.words {
+                if (w & bit0) != 0 && (w & bit1) == 0 {
+                    let w2 = w ^ bit0 ^ bit1;
+                    self.bits.swap(w, w2);
+                }
+            }
+        }
+
+        self.check_clean();
+    }
+
+    pub fn invert(&mut self) {
+        if self.words == 1 {
+            let n = 1usize << self.channels;
+            self.bits[0] = self.bits[0].reverse_bits() >> (64 - n);
+        } else {
+            let mut new_bits = [0u64; MAX_WORDS];
+            for j in 0..self.words {
+                new_bits[self.words - 1 - j] = self.bits[j].reverse_bits();
+            }
+            self.bits[..self.words].copy_from_slice(&new_bits[..self.words]);
+        }
+        self.check_clean();
+    }
+
+    pub fn len(&self) -> u32 {
+        self.bits[..self.words].iter().map(|w| w.count_ones()).sum()
+    }
+
+    pub fn weight_histogram(&self) -> WVec<u32> {
