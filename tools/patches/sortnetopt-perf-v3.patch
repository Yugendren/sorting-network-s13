diff -ruN m2a-tree/src/search/subsume.rs source/src/search/subsume.rs
--- a/src/search/subsume.rs	1970-01-01 07:30:00
+++ b/src/search/subsume.rs	2026-08-17 11:57:40
@@ -0,0 +1,297 @@
+//! M2b: the on-line subsumption index, sharded and bucketed by popcount.
+//!
+//! M2a used a single `RwLock<OutputSetIndex<LowerInvert>>` per indexed width.
+//! Profiling of the M2a prototype attributed **31.2 %** of all thread time to
+//! index lookups and **17.5 %** to index inserts (write-lock waiting included),
+//! against 1.0 % for the abstraction computation that had been the predicted
+//! bottleneck. Both of those costs have the same two causes: one lock per
+//! width, and a k-d traversal that visits entries which cannot possibly be in a
+//! subsumption relation with the query.
+//!
+//! Both are fixed by the same key.
+//!
+//! # Popcount is an exact subsumption invariant
+//!
+//! Write `|A|` for the number of Boolean vectors in the output set `A`, i.e.
+//! the popcount of its packed bitmap. The subsumption relation this index
+//! implements is `C ⊆ π(A)` or `C ⊆ π(¬A)` for some channel permutation `π`,
+//! where `¬` is the complement/reversal symmetry. Both `π` and `¬` act as
+//! *bijections of the Boolean cube*, so they preserve cardinality. Hence
+//!
+//! ```text
+//!     C subsumes A   ⟹   |C| ≤ |A|
+//!     C subsumes A and |C| = |A|   ⟹   C = A  (as canonical sets)
+//! ```
+//!
+//! (the second line because the search only ever stores `canonicalize(true)`
+//! representatives, so two sets equal modulo permutation *and* complement have
+//! identical bitmaps).
+//!
+//! Partitioning the stored entries into one `OutputSetIndex` per value of
+//! `|set|` therefore makes both directions exact:
+//!
+//! * a **lookup** for `Q` — "maximum value over stored `C` with `C ⊆ Q`" — only
+//!   has to visit buckets `0 ..= |Q|`;
+//! * the **eviction** pass of an insert of `A` — "remove stored `C` with
+//!   `A ⊆ C`" — only has to visit buckets `|A| ..= 2^k`, and the bucket `|A|`
+//!   can contain no evictable entry at all, only `A` itself.
+//!
+//! Skipped buckets provably contain no entry in a subsumption relation with the
+//! query, so this introduces no false negatives: the index returns exactly the
+//! answers the unsharded M2a index returns.
+//!
+//! # Lock discipline and query monotonicity under sharding
+//!
+//! Each bucket carries its own `RwLock`, so the critical sections are short and
+//! contention is spread over up to `2^k + 1` locks instead of one. A lookup and
+//! an insert never hold two bucket locks at once, so no lock-ordering cycle can
+//! exist, and (as in M2a) no lock is held across an `.await`.
+//!
+//! The one property a single global lock gave for free is
+//! `docs/sortnetopt-internals.md` §3.6 invariant 2: *the maximum over subsuming
+//! entries, as seen by a concurrent reader, never decreases in time.* With one
+//! lock per bucket a lookup is no longer an atomic snapshot, so the invariant
+//! has to be re-established. Two rules do it:
+//!
+//! 1. **Insert before evict.** `insert_collect` publishes `A` into bucket `|A|`
+//!    *before* it removes any dominated `C` from higher buckets. So whenever
+//!    `C` is absent, its evictor `A` (with `value(A) ≥ value(C)`) is already
+//!    present.
+//! 2. **Scan buckets in descending popcount order.** Suppose a reader misses
+//!    `C` in bucket `p = |C|`, i.e. `C` was removed before time `t_p`. Its
+//!    evictor `A` has `|A| < p` strictly, and was inserted before that removal,
+//!    hence before `t_p`, hence before `t_{|A|} > t_p` — the descending scan
+//!    reaches bucket `|A|` *later*, so the reader sees `A`, or (inductively, on
+//!    the strictly decreasing popcount, so the induction terminates) sees `A`'s
+//!    own evictor, whose value is at least as large.
+//!
+//! Therefore the value a reader computes is still monotone non-decreasing in
+//! time, and is in every case realised by some entry that was genuinely in the
+//! index — which is what soundness needs (an ascending scan would *not* have
+//! this property, and would admit a transient dip).
+//!
+//! Every individual bucket read returns a value realised by a stored `C ⊆ Q`,
+//! so the max over buckets is a sound lower bound regardless of interleaving;
+//! non-atomicity can only ever cost precision, never soundness.
+
+use std::{
+    sync::{
+        atomic::{AtomicU64, AtomicU8, Ordering::Relaxed},
+        RwLock,
+    },
+    time::Instant,
+};
+
+use crate::instrument;
+use crate::output_set::{
+    index::{LowerInvert, OutputSetIndex},
+    OutputSet,
+};
+
+struct Bucket {
+    index: RwLock<OutputSetIndex<LowerInvert>>,
+    /// Live entry count. Maintained under the write lock, read without one; a
+    /// stale non-zero read only costs an unnecessary lock acquisition, and it
+    /// can never be a stale zero for a bucket this thread must visit because
+    /// the only writer that could have made it non-zero also published the
+    /// entry before the counter (see `insert_collect`).
+    len: AtomicU64,
+    /// High-water mark of the values ever stored in this bucket. Never
+    /// decreases, so it is always an *upper* bound on the values currently
+    /// stored, which makes `max_value <= best_so_far ⟹ skip` sound for the
+    /// lookup direction (`Lower*::does_improve` is `value > best_so_far`).
+    max_value: AtomicU8,
+    /// Low-water mark, symmetrically: never increases, so it is always a
+    /// *lower* bound on the values currently stored, which makes
+    /// `min_value > value ⟹ skip` sound for the eviction direction
+    /// (`Lower*::would_be_updated` is `candidate_value <= value`).
+    min_value: AtomicU8,
+}
+
+impl Bucket {
+    fn new(channels: usize, point_dim: usize) -> Self {
+        Bucket {
+            index: RwLock::new(OutputSetIndex::new_with_point_dim(channels, point_dim)),
+            len: AtomicU64::new(0),
+            max_value: AtomicU8::new(0),
+            min_value: AtomicU8::new(u8::MAX),
+        }
+    }
+}
+
+/// One indexed width's on-line subsumption index, partitioned by `|set|`.
+pub struct ShardedSubsumeIndex {
+    point_dim: usize,
+    /// `buckets[p]` holds exactly the stored sets with `|set| == p`; length is
+    /// `2^channels + 1`.
+    buckets: Vec<Bucket>,
+}
+
+impl ShardedSubsumeIndex {
+    pub fn new(channels: usize, point_dim: usize) -> Self {
+        let buckets = (0..=(1usize << channels))
+            .map(|_| Bucket::new(channels, point_dim))
+            .collect::<Vec<_>>();
+        let point_dim = buckets[0].index.read().unwrap().point_dim();
+        Self { point_dim, buckets }
+    }
+
+    pub fn point_dim(&self) -> usize {
+        self.point_dim
+    }
+
+    /// Maximum value over stored sets that subsume `output_set`, or `None`.
+    ///
+    /// Visits buckets `|output_set| ..= 0` in **descending** order; see the
+    /// module documentation for why the direction matters.
+    pub fn lookup(&self, output_set: OutputSet<&[bool]>, abstraction: &[u16]) -> Option<u8> {
+        let t_pop = Instant::now();
+        let popcount = output_set.len();
+        instrument::add_ns(&instrument::IDX_NS_POPCOUNT, t_pop);
+
+        let mut best: Option<u8> = None;
+        let mut visited = 0u64;
+        let mut skipped = 0u64;
+
+        for bucket in self.buckets[..=popcount].iter().rev() {
+            if bucket.len.load(Relaxed) == 0 {
+                skipped += 1;
+                continue;
+            }
+            if let Some(best) = best {
+                if bucket.max_value.load(Relaxed) <= best {
+                    skipped += 1;
+                    continue;
+                }
+            }
+
+            visited += 1;
+            // The running maximum is threaded in, not restarted: it is what
+            // lets `can_improve` / `does_improve` discard whole subtrees and
+            // individual entries before the exact `subsumes_permuted` test.
+            best = bucket
+                .index
+                .read()
+                .unwrap()
+                .lookup_with_abstraction_from(output_set, abstraction, best);
+        }
+
+        instrument::add(&instrument::IDX_LOOKUP_BUCKETS, visited);
+        instrument::add(&instrument::IDX_LOOKUP_BUCKETS_SKIPPED, skipped);
+
+        best
+    }
+
+    /// Store-and-evict, sharded. Returns the best value over stored sets that
+    /// subsume `output_set` (a sound lower bound for it), exactly as
+    /// `OutputSetIndex::insert_with_abstraction_collect` does.
+    pub fn insert_collect(
+        &self,
+        output_set: OutputSet<&[bool]>,
+        abstraction: &[u16],
+        value: u8,
+        on_evict: &mut dyn FnMut(&[u8]),
+    ) -> u8 {
+        let popcount = output_set.len();
+
+        let best = self.lookup(output_set, abstraction);
+
+        // `LowerInvert::does_improve`: nothing to publish, and nothing this
+        // insert could dominate that the incumbent does not already dominate.
+        if let Some(best) = best {
+            if value <= best {
+                return best;
+            }
+        }
+
+        // (1) Publish into the home bucket first, so that any entry removed in
+        //     step (2) is already covered for concurrent readers.
+        //
+        //     The unmodified `insert_with_abstraction_collect` is used here on
+        //     purpose: within this bucket every stored entry has the same
+        //     popcount as `output_set`, so its eviction traversal can only ever
+        //     reach the `candidate == output_set` update-in-place branch and
+        //     can never remove anything. `on_evict` is passed through anyway so
+        //     the accounting cannot silently diverge if that reasoning is ever
+        //     violated.
+        let home = &self.buckets[popcount];
+        let inner = {
+            let mut index = home.index.write().unwrap();
+            let inner =
+                index.insert_with_abstraction_collect(output_set, abstraction, value, on_evict);
+            home.len.store(index.len() as u64, Relaxed);
+            inner
+        };
+        home.max_value.fetch_max(value, Relaxed);
+        home.min_value.fetch_min(value, Relaxed);
+
+        // (2) Absorb strictly larger stored sets.
+        let t_evict = Instant::now();
+        let mut visited = 0u64;
+        let mut skipped = 0u64;
+        for bucket in self.buckets[popcount + 1..].iter() {
+            if bucket.len.load(Relaxed) == 0 {
+                skipped += 1;
+                continue;
+            }
+            if bucket.min_value.load(Relaxed) > value {
+                skipped += 1;
+                continue;
+            }
+
+            visited += 1;
+            let mut index = bucket.index.write().unwrap();
+            let removed =
+                index.remove_dominated_with_abstraction(output_set, abstraction, value, on_evict);
+            if removed > 0 {
+                bucket.len.store(index.len() as u64, Relaxed);
+            }
+        }
+
+        instrument::add_ns(&instrument::IDX_NS_EVICT, t_evict);
+        instrument::add(&instrument::IDX_EVICT_BUCKETS, visited);
+        instrument::add(&instrument::IDX_EVICT_BUCKETS_SKIPPED, skipped);
+
+        inner.max(best.unwrap_or(0))
+    }
+
+    pub fn len(&self) -> usize {
+        self.buckets
+            .iter()
+            .map(|bucket| bucket.index.read().unwrap().len())
+            .sum()
+    }
+
+    /// Content bytes, charging `len` — directly comparable with M2a's
+    /// `index_payload_bytes`.
+    pub fn payload_bytes(&self) -> usize {
+        self.buckets
+            .iter()
+            .map(|bucket| bucket.index.read().unwrap().payload_bytes())
+            .sum()
+    }
+
+    /// Heap bytes charging `capacity`, **plus** the bucket array itself, so the
+    /// price of sharding is visible rather than hidden.
+    pub fn estimated_bytes(&self) -> usize {
+        self.buckets.len() * std::mem::size_of::<Bucket>()
+            + self
+                .buckets
+                .iter()
+                .map(|bucket| bucket.index.read().unwrap().estimated_bytes())
+                .sum::<usize>()
+    }
+
+    /// Number of buckets that hold at least one entry (reported so the
+    /// effectiveness of the partition is measurable rather than assumed).
+    pub fn occupied_buckets(&self) -> usize {
+        self.buckets
+            .iter()
+            .filter(|bucket| bucket.len.load(Relaxed) > 0)
+            .count()
+    }
+
+    pub fn bucket_count(&self) -> usize {
+        self.buckets.len()
+    }
+}
