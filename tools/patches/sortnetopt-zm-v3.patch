+            // asserts the channel really is extremal, so every extremal
+            // `(polarity, channel)` is enumerated rather than guessed.
+            if channels + 1 <= super::MAX_CHANNELS {
+                let big_channels = channels + 1;
+                let mut big = OutputSet::all_values(big_channels);
+                big.apply_comparator([1, 0]);
+                big.apply_comparator([2, 1]);
