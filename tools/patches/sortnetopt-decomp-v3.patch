+/// `(shells_nonzero, largest_shell, largest_shell_frac, top16_frac,
+/// top64_frac, nonzero_entries)`, `nonzero_entries` sorted descending by
+/// count. These are exactly the columns of `assessment` §7.2's table.
+/// Callers must already have checked [`shell_stats_enabled`]: this function
+/// reads (and, on first call, allocates) the shell census table.
+pub fn shell_histogram_summary() -> (u64, u64, f64, f64, f64, Vec<((usize, u64), u64)>) {
+    let table = shell_census_table();
+    let mut entries: Vec<((usize, u64), u64)> = Vec::new();
+    for (width, counts) in table.iter().enumerate() {
+        for (popcount, slot) in counts.iter().enumerate() {
+            let count = slot.load(Relaxed);
+            if count > 0 {
+                entries.push(((width, popcount as u64), count));
+            }
+        }
+    }
+    entries.sort_unstable_by(|a, b| b.1.cmp(&a.1).then(a.0.cmp(&b.0)));
+
+    let total: u64 = entries.iter().map(|(_, count)| *count).sum();
+    let frac = |n: u64| {
+        if total > 0 {
+            n as f64 / total as f64
+        } else {
+            0.0
+        }
+    };
+
+    let shells_nonzero = entries.len() as u64;
+    let largest_shell = entries.first().map(|(_, count)| *count).unwrap_or(0);
+    let top16: u64 = entries.iter().take(16).map(|(_, count)| *count).sum();
+    let top64: u64 = entries.iter().take(64).map(|(_, count)| *count).sum();
+
+    (
+        shells_nonzero,
+        largest_shell,
+        frac(largest_shell),
+        frac(top16),
+        frac(top64),
+        entries,
+    )
+}
+
+fn json_shell_census(pairs: &[((usize, u64), u64)]) -> String {
+    let mut out = String::from("{");
+    for (index, ((width, popcount), count)) in pairs.iter().enumerate() {
+        if index > 0 {
+            out.push_str(", ");
+        }
+        let _ = write!(out, "\"{},{}\": {}", width, popcount, count);
+    }
+    out.push('}');
+    out
+}
