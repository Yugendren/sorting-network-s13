+//! ZM-V3, Lemma Z: the rank-<=2 superset-zeta truncation behind
+//! `OutputSet::abstraction`.
+//!
+//! # The lemma
+//!
+//! Let `X` be an output set and `zeta(S) = |{ x in X : x superset-of S }|` its
+//! superset-zeta transform (identifying a Boolean vector with the set of
+//! channels on which it is 1). `OutputSet::channel_pair_abstraction([i, j])`
+//! counts the four quadrants of the channel pair `(i, j)`:
+//!
+//! ```text
+//! group 0 = |{x : x_i = 1, x_j = 1}| = zeta({i,j})
+//! group 1 = |{x : x_i = 0, x_j = 1}| = zeta({j}) - zeta({i,j})
+//! group 2 = |{x : x_i = 1, x_j = 0}| = zeta({i}) - zeta({i,j})
+//! group 3 = |{x : x_i = 0, x_j = 0}| = |X| - zeta({i}) - zeta({j}) + zeta({i,j})
+//! ```
+//!
+//! so the *entire* abstraction vector -- and therefore the whole `Lower` /
+//! `LowerInvert` index filter -- is a function of
+//! `(|X|, zeta({i}) for each i, zeta({i,j}) for each pair)`, i.e. of the
+//! rank-<=2 truncation of `zeta` alone. Nothing of higher rank is ever
+//! consulted.
+//!
+//! # Why that is worth anything
+//!
+//! Upstream computes the abstraction by running `channel_pair_abstraction`
+//! once per *ordered* channel pair, each a stride-`2^k` gather over the dense
+//! `[bool]` bitmap doing 4 loads and 4 adds per visited index:
+//! `n(n-1) * 2^n / 4 * 8` scalar operations, 2,555,904 at n = 13.
+//!
+//! Computing the rank-<=2 zeta truncation *once* and deriving all
+//! `n(n-1)` quadruples from it by inclusion-exclusion needs one contiguous
+//! pass over the *packed* `u64` bitmap with masked popcounts:
+//! `2^n/64` words times (a fixed 22 popcounts plus O(n^2/2) accumulator adds).
+//! At n = 13 that is 128 words * ~90 ops ~= 11.5k operations plus the
+//! O(n^2) inclusion-exclusion, against 2.56M -- and it consumes the packed
+//! representation `PackedSet` (TIER1) already provides, so it needs no
+//! `[bool]` expansion.
+//!
+//! # Bit-identity
+//!
+//! [`write_abstraction_from_counts`] performs exactly
+//! `OutputSet::write_abstraction_into`'s post-processing (descending sort
+//! within each per-channel group, scatter, ascending sort across channels,
+//! rank-block transpose) with `channel_pair_abstraction` replaced by
+//! [`PairCounts::quadrants`]. Every intermediate value is equal by the lemma,
+//! so the emitted `u16` vector is equal bit for bit. This is asserted by the
+//! unit tests in this module and by the standalone differential harness.
+//!
+//! The two sorting steps no longer call `sort_unstable`: they use the
+//! fixed-shape branch-free sorts [`sort2_desc_u16`] / [`sort4_asc_u16`], and
+//! only two of the four groups are sorted at all (see
+//! [`ChannelBlocks::from_counts`] for the reflection that derives the other
+//! two). Both are exact rearrangements of the same multisets, so bit-identity
+//! is untouched -- and is what `bin/zeta_diff` and
+//! `tests::abstraction_bit_identical` check.
+
+use super::packed::PackedSet;
+use super::{AVec, MAX_CHANNELS, PAIR_ABSTRACTION_GROUPS};
+use arrayvec::ArrayVec;
+
+/// `BIT_MASK[c]` has bit `p` set (`p` in `0..64`) iff bit `c` of `p` is set.
+/// Duplicated from `packed.rs` (private there) so this module is standalone.
+const fn bit_masks() -> [u64; 6] {
+    let mut masks = [0u64; 6];
+    let mut c = 0usize;
+    while c < 6 {
+        let mut p = 0usize;
+        while p < 64 {
+            if (p >> c) & 1 == 1 {
+                masks[c] |= 1u64 << p;
+            }
+            p += 1;
+        }
+        c += 1;
+    }
+    masks
+}
+
+const BIT_MASK: [u64; 6] = bit_masks();
+
+/// `LOW_PAIR[c][d] = BIT_MASK[c] & BIT_MASK[d]`, so an in-word pair quadrant
+/// costs one `AND` and one `POPCNT` rather than two `AND`s.
+const fn low_pair_masks() -> [[u64; 6]; 6] {
+    let masks = bit_masks();
+    let mut out = [[0u64; 6]; 6];
+    let mut c = 0usize;
+    while c < 6 {
+        let mut d = 0usize;
+        while d < 6 {
+            out[c][d] = masks[c] & masks[d];
+            d += 1;
+        }
+        c += 1;
+    }
+    out
+}
+
+const LOW_PAIR: [[u64; 6]; 6] = low_pair_masks();
+
+/// The rank-<=2 truncation of the superset-zeta transform of an output set.
+///
+/// `total = zeta(empty) = |X|`, `ones[i] = zeta({i})`,
+/// `pair[i][j] = zeta({i,j})` (symmetric, with `pair[i][i] = ones[i]`).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PairCounts {
+    channels: usize,
+    total: u32,
+    ones: [u32; MAX_CHANNELS],
+    pair: [[u32; MAX_CHANNELS]; MAX_CHANNELS],
+}
+
+impl PairCounts {
+    pub fn channels(&self) -> usize {
+        self.channels
+    }
+
+    pub fn total(&self) -> u32 {
+        self.total
+    }
+
+    pub fn ones(&self, i: usize) -> u32 {
+        self.ones[i]
+    }
+
+    pub fn pair(&self, i: usize, j: usize) -> u32 {
+        self.pair[i][j]
+    }
+
+    /// One contiguous pass over the packed bitmap.
+    ///
+    /// Channels split into the `low` ones (`c < 6`), which are in-word bit
+    /// positions and are handled by masked popcount, and the `high` ones
+    /// (`c >= 6`), which are bits of the *word index* and are handled by
+    /// selecting words.
+    pub fn from_packed(set: &PackedSet) -> Self {
+        let channels = set.channels();
+        debug_assert!(channels <= MAX_CHANNELS);
+        let bits = set.bits();
+
+        let low = channels.min(6);
+        let high = channels.saturating_sub(6);
+
+        let mut total: u32 = 0;
+        let mut ones = [0u32; MAX_CHANNELS];
+        let mut pair = [[0u32; MAX_CHANNELS]; MAX_CHANNELS];
+
+        let mut lowpop = [0u32; 6];
+
+        for (w, &word) in bits.iter().enumerate() {
+            if word == 0 {
+                continue;
+            }
+            let pf = word.count_ones();
+            total += pf;
+
+            for c in 0..low {
+                let p = (word & BIT_MASK[c]).count_ones();
+                lowpop[c] = p;
+                ones[c] += p;
+            }
+            for c in 0..low {
+                for d in (c + 1)..low {
+                    pair[c][d] += (word & LOW_PAIR[c][d]).count_ones();
+                }
+            }
+
+            if high == 0 {
+                continue;
+            }
+            // Only the set high bits of `w` matter; iterate them directly.
+            let mut rest = w as u32;
+            while rest != 0 {
+                let h = rest.trailing_zeros() as usize;
+                rest &= rest - 1;
+                if h >= high {
+                    break;
+                }
+                let hc = 6 + h;
+                ones[hc] += pf;
+                for c in 0..low {
+                    pair[c][hc] += lowpop[c];
+                }
+                let mut rest2 = rest;
+                while rest2 != 0 {
+                    let h2 = rest2.trailing_zeros() as usize;
+                    rest2 &= rest2 - 1;
+                    if h2 >= high {
+                        break;
+                    }
+                    pair[hc][6 + h2] += pf;
+                }
+            }
+        }
+
+        // Symmetrise and fill the diagonal.
+        for i in 0..channels {
+            pair[i][i] = ones[i];
+            for j in 0..i {
+                pair[i][j] = pair[j][i];
+            }
+        }
+
+        Self {
+            channels,
+            total,
+            ones,
+            pair,
+        }
+    }
+
+    /// Exactly `OutputSet::channel_pair_abstraction([i, j])`, by
+    /// inclusion-exclusion on the rank-<=2 zeta truncation (Lemma Z).
+    ///
+    /// `i` is `channel_pair[0]` (the row channel) and `j` is
+    /// `channel_pair[1]`; the group order matches upstream's
+    /// `(1,1) / (0,1) / (1,0) / (0,0)` exactly.
+    #[inline]
+    pub fn quadrants(&self, i: usize, j: usize) -> [u32; PAIR_ABSTRACTION_GROUPS] {
+        let p = self.pair[i][j];
+        let oi = self.ones[i];
+        let oj = self.ones[j];
+        // `total + p - oi - oj` and not `total - oi - oj + p`: every prefix of
+        // the former is a nonnegative integer (`total >= oi`, and
+        // `total + p - oi >= oj` because the group-3 count is a cardinality),
+        // whereas `total - oi - oj` underflows as an intermediate whenever
+        // `oi + oj > total` -- correct after wrapping in release, a panic under
+        // `debug_assertions`. Keeping the crate testable in debug mode matters
+        // more than the (nonexistent) codegen difference.
+        [p, oj - p, oi - p, self.total + p - oi - oj]
+    }
+
+}
+
+/// Sorts two equally long `u16` slices descending, in lockstep.
+///
+/// The slices the abstraction path sorts have `n - 1` or `n` entries -- 2..13
+/// -- a length at which `slice::sort_unstable_by`'s pattern-defeating
+/// quicksort is almost entirely fixed setup: an out-of-line call that
+/// re-derives the length, chooses a pivot strategy and only then falls into
+/// its own insertion sort. Since these are total orders on scalars, any
+/// correct sort emits the identical sequence, so the choice is purely one of
+/// cost.
+///
+/// This is an **odd-even transposition sort**: `len` layers of independent
+/// `(max, min)` compare-exchanges on adjacent pairs. It is branch-free
+/// (`u16::max` / `u16::min` become `cmp` + two `csel`), which matters because
+/// the comparison outcomes here are data-dependent noise that a predictor
+/// cannot learn.
+///
+/// Odd-even transposition is *latency* bound rather than throughput bound --
+/// each layer depends on the previous one -- so the two slices are sorted in
+/// one interleaved loop rather than by two calls. The chains are independent,
+/// so the second sort is nearly free. Measured on the microbenchmark at n=11,
+/// `ChannelBlocks::from_counts`: 625 ns for two insertion sorts, 561 ns for
+/// two separate odd-even sorts, 545 ns interleaved; at n=8, where insertion
+/// sort's early exit is at its best, interleaved odd-even still matches it
+/// (249 ns).
+#[inline]
+fn sort2_desc_u16(x: &mut [u16], y: &mut [u16]) {
+    let len = x.len();
+    debug_assert_eq!(len, y.len());
+    for round in 0..len {
+        let mut t = round & 1;
+        while t + 1 < len {
+            let (a, b) = (x[t], x[t + 1]);
+            x[t] = a.max(b);
+            x[t + 1] = a.min(b);
+            let (c, d) = (y[t], y[t + 1]);
+            y[t] = c.max(d);
+            y[t + 1] = c.min(d);
+            t += 2;
+        }
+    }
+}
+
+/// [`sort2_desc_u16`] the other way round and four slices wide: the
+/// replacement for `<[u16]>::sort_unstable` in
+/// [`write_abstraction_from_counts`].
+///
+/// Four rather than two because that step sorts `4(n - 1)` slices and is
+/// squarely latency bound; widening from two chains to four took
+/// `OutputSet::abstraction` from 1087 ns to 956 ns at n=9 and from 2260 ns to
+/// 2017 ns at n=11. `chunks` is split into four equal parts, which is exactly
+/// how the caller's four consecutive `channels`-long chunks are laid out.
+///
+/// `inline(always)` and not `inline`: the caller passes `len == channels`,
+/// which it also uses for the chunking, and only propagating that equality
+/// into the body recovers the last ~6% (991 ns -> 956 ns at n=9). The reverse
+/// is true of [`sort2_desc_u16`], which regressed under `inline(always)`;
+/// both were measured.
+#[inline(always)]
+fn sort4_asc_u16(chunks: &mut [u16], len: usize) {
+    debug_assert_eq!(chunks.len(), 4 * len);
+    let (xy, zw) = chunks.split_at_mut(2 * len);
+    let (x, y) = xy.split_at_mut(len);
+    let (z, w) = zw.split_at_mut(len);
+    for round in 0..len {
+        let mut t = round & 1;
+        while t + 1 < len {
+            let (a, b) = (x[t], x[t + 1]);
+            x[t] = a.min(b);
+            x[t + 1] = a.max(b);
+            let (c, d) = (y[t], y[t + 1]);
+            y[t] = c.min(d);
+            y[t + 1] = c.max(d);
+            let (e, f) = (z[t], z[t + 1]);
+            z[t] = e.min(f);
+            z[t + 1] = e.max(f);
+            let (g, h) = (w[t], w[t + 1]);
+            w[t] = g.min(h);
+            w[t + 1] = g.max(h);
+            t += 2;
+        }
+    }
+}
+
+/// The post-processing of `OutputSet::write_abstraction_into`, over
+/// [`PairCounts`] instead of `channel_pair_abstraction`.
+///
+/// Structurally identical to upstream -- descending sort within each
+/// per-channel group, scatter, ascending sort across channels, rank-block
+/// transpose -- with the two sorting steps done the way
+/// [`ChannelBlocks::from_counts`] does them:
+///
+/// * the per-channel descending sorts use the group-2/3-from-group-0/1
+///   reflection (see [`ChannelBlocks::from_counts`]), so two sorts run instead
+///   of four and no `CVec` scratch is needed;
+/// * both sorting steps use [`sort2_desc_u16`] / [`sort4_asc_u16`] instead of
+///   `sort_unstable`. The across-channel step is `4(n - 1)` sorts of `n`
+///   elements each, the single largest cost in the old version.
+///
+/// The emitted vector is unchanged bit for bit (`abstraction_bit_identical`,
+/// `pathological_sets_bit_identical`, and `bin/zeta_diff`).
+pub fn write_abstraction_from_counts(counts: &PairCounts, abstraction: &mut [u16]) {
+    let channels = counts.channels();
+    debug_assert_eq!(
+        abstraction.len(),
+        channels * (channels - 1) * PAIR_ABSTRACTION_GROUPS
+    );
+
+    let k = channels - 1;
+    let total = counts.total();
+    // See `ChannelBlocks::from_counts` for the one slot of slack and for the
+    // branch-free diagonal handling.
+    let mut g0 = [0u16; MAX_CHANNELS];
+    let mut g1 = [0u16; MAX_CHANNELS];
+
+    for channel in 0..channels {
+        let ones_i = counts.ones(channel);
+        let pair_row = &counts.pair[channel][..channels];
+        let ones = &counts.ones[..channels];
+
+        let mut t = 0usize;
+        for other in 0..channels {
+            let p = pair_row[other];
+            g0[t] = p as u16;
+            g1[t] = (ones[other] - p) as u16;
+            t += (other != channel) as usize;
+        }
+        debug_assert_eq!(t, k);
+
+        let (g0, g1) = (&mut g0[..k], &mut g1[..k]);
+        sort2_desc_u16(g0, g1);
+
+        let c2 = ones_i as u16;
+        let c3 = (total - ones_i) as u16;
+        for rank in 0..k {
+            let mirror = k - 1 - rank;
+            // Upstream's `channel + channels * (group + PAIR_ABSTRACTION_GROUPS
+            // * index)`, with `group` folded into the four offsets.
+            let base = channel + channels * PAIR_ABSTRACTION_GROUPS * rank;
+            abstraction[base] = g0[rank];
+            abstraction[base + channels] = g1[rank];
+            abstraction[base + 2 * channels] = c2 - g0[mirror];
+            abstraction[base + 3 * channels] = c3 - g1[mirror];
+        }
+    }
+
+    // `4(n - 1)` is a multiple of four, so the `channels`-long chunks group up
+    // exactly four at a time, which is what `sort4_asc_u16` wants.
+    for quad in abstraction.chunks_mut(PAIR_ABSTRACTION_GROUPS * channels) {
+        sort4_asc_u16(quad, channels);
+    }
+
+    for chunk in abstraction.chunks_mut(channels * PAIR_ABSTRACTION_GROUPS) {
+        let mut tmp = ArrayVec::<[u16; 64]>::new();
+        tmp.try_extend_from_slice(chunk).unwrap();
+
+        for i in 0..PAIR_ABSTRACTION_GROUPS {
+            for j in 0..channels {
+                chunk[i + j * PAIR_ABSTRACTION_GROUPS] = tmp[j + i * channels];
+            }
+        }
+    }
+}
+
+/// `OutputSet::abstraction()` computed from a [`PackedSet`].
+pub fn abstraction_from_packed(set: &PackedSet) -> AVec<u16> {
+    let channels = set.channels();
+    let len = channels * (channels - 1) * PAIR_ABSTRACTION_GROUPS;
+    let mut result = std::iter::repeat(0).take(len).collect::<AVec<u16>>();
+    write_abstraction_from_counts(&PairCounts::from_packed(set), &mut result[..]);
+    result
+}
+
+// ---------------------------------------------------------------------------
+// Lemma M support: the per-channel abstraction blocks.
+// ---------------------------------------------------------------------------
+
+/// Width of one per-channel block: `PAIR_ABSTRACTION_GROUPS * (n - 1)`.
+pub const MAX_BLOCK: usize = PAIR_ABSTRACTION_GROUPS * (MAX_CHANNELS - 1);
+
+/// ZM-V3, Lemma M: `v_i(X)` for every channel `i`, *before* the across-channel
+/// sort that `write_abstraction_into` applies.
+///
+/// Row `i` holds the four `channel_pair_abstraction([i, j])` groups over
+/// `j != i`, each sorted **descending**, laid out with the group index in the
+/// low two bits:
+///
+/// ```text
+/// row[i][PAIR_ABSTRACTION_GROUPS * rank + group]
+/// ```
+///
+/// That layout is chosen so that complementing the cube -- which swaps the
+/// quadrants `(1,1) <-> (0,0)` and `(0,1) <-> (1,0)`, i.e. `group <-> group^3`,
+/// and does not touch the descending order within a group -- acts on a row as
+/// the index permutation `t |-> t ^ 3`, exactly as it does on the full
+/// abstraction vector (`index.rs`, `LowerInvert`). No recomputation is needed
+/// for the complement polarity.
+///
+/// **Invariant, relied on by the comparison kernels:** `rows[i][block..]` is
+/// zero for every `i`, and `rows[i]` is all zero for `i >= channels`.
+/// [`Self::from_counts`] establishes it (the array is zero-initialised and it
+/// writes exactly `..block` of the first `channels` rows) and nothing else
+/// writes `rows`. [`Self::row_dominated_by`] and
+/// [`Self::row_dominated_by_inverted`] compare the whole fixed-width row
+/// rather than `..block` precisely so that the trip count is a compile-time
+/// constant, which is only sound because the tail compares equal.
+#[derive(Clone, Copy, Debug)]
+pub struct ChannelBlocks {
+    channels: usize,
+    block: usize,
+    rows: [[u16; MAX_BLOCK]; MAX_CHANNELS],
+}
+
+impl ChannelBlocks {
+    pub fn channels(&self) -> usize {
+        self.channels
+    }
+
+    pub fn block_len(&self) -> usize {
+        self.block
+    }
+
+    #[inline]
+    pub fn row(&self, i: usize) -> &[u16] {
+        &self.rows[i][..self.block]
+    }
+
+    /// Only **two** of the four groups are ever sorted.
+    ///
+    /// Fix a channel `i` and write `p_j = zeta({i, j})`, `o_j = zeta({j})`,
+    /// `T = |X|`. By [`PairCounts::quadrants`] the four multisets over `j != i`
+    /// are
+    ///
+    /// ```text
+    /// group 0 = { p_j }                group 2 = { o_i - p_j }
+    /// group 1 = { o_j - p_j }          group 3 = { (T - o_i) - (o_j - p_j) }
+    /// ```
+    ///
+    /// so groups 2 and 3 are groups 0 and 1 reflected through a constant. `x
+    /// |-> c - x` is order-*reversing*, hence sorting group 2 descending is
+    /// sorting group 0 *ascending*: if `s0` is group 0 sorted descending then
+    /// group 2 descending is `c - s0[k - 1 - r]` at rank `r`, and likewise for
+    /// 3 from 1. The multiset determines the sorted sequence, so this is equal,
+    /// not merely equivalent (asserted by `blocks_match_sorted_reference`).
+    ///
+    /// That halves the sorting and the quadrant arithmetic, and -- more
+    /// important for codegen -- it makes the row fill a single sequential pass
+    /// with compile-time offsets instead of `4(n-1)` stores to data-dependent
+    /// indices. The previous version, four `sort_unstable_by` calls per
+    /// channel plus a scatter, was 887 ns of `from_packed`'s 1079 ns at n=9;
+    /// LLVM unrolled it into ~1200 instructions of stack-spill traffic.
+    pub fn from_counts(counts: &PairCounts) -> Self {
+        let channels = counts.channels();
+        let block = PAIR_ABSTRACTION_GROUPS * (channels - 1);
+        let mut rows = [[0u16; MAX_BLOCK]; MAX_CHANNELS];
+
+        let k = channels - 1;
+        let total = counts.total();
+        // One slot of slack: the gather below writes the `other == channel`
+        // entry too and then lets the next iteration overwrite it, which at
+        // `channel == channels - 1` means a write at index `k`.
+        let mut g0 = [0u16; MAX_CHANNELS];
+        let mut g1 = [0u16; MAX_CHANNELS];
+
+        for channel in 0..channels {
+            let ones_i = counts.ones(channel);
+            let pair_row = &counts.pair[channel][..channels];
+            let ones = &counts.ones[..channels];
+
+            // Branch-free gather: `t` only advances off the diagonal, so the
+            // `other == channel` entry is written and then overwritten rather
+            // than skipped by a `continue`. That keeps the loop a straight
+            // contiguous walk of two `u32` rows -- LLVM was otherwise
+            // specialising the `continue` into ~8 KB of unrolled spill traffic.
+            // The diagonal entry is harmless in its own right:
+            // `pair[i][i] == ones[i]`, so it computes `(ones_i, 0)`.
+            let mut t = 0usize;
+            for other in 0..channels {
+                let p = pair_row[other];
+                g0[t] = p as u16;
+                g1[t] = (ones[other] - p) as u16;
+                t += (other != channel) as usize;
+            }
+            debug_assert_eq!(t, k);
+
+            let (g0, g1) = (&mut g0[..k], &mut g1[..k]);
+            sort2_desc_u16(g0, g1);
+
+            // `ones_i` and `total - ones_i` are the constants groups 2 and 3
+            // reflect through; both are nonnegative (`total >= ones_i`), and
+            // every difference below is a quadrant count, hence nonnegative.
+            let c2 = ones_i as u16;
+            let c3 = (total - ones_i) as u16;
+            let row = &mut rows[channel];
+            for rank in 0..k {
+                let mirror = k - 1 - rank;
+                let out = &mut row[PAIR_ABSTRACTION_GROUPS * rank..][..PAIR_ABSTRACTION_GROUPS];
+                out[0] = g0[rank];
+                out[1] = g1[rank];
+                out[2] = c2 - g0[mirror];
+                out[3] = c3 - g1[mirror];
+            }
+        }
+
+        Self {
+            channels,
+            block,
+            rows,
+        }
+    }
+
+    pub fn from_packed(set: &PackedSet) -> Self {
+        Self::from_counts(&PairCounts::from_packed(set))
+    }
+
+    /// `v_i(A) <= v_j(B)` coordinatewise.
+    ///
+    /// Compared over the whole fixed `MAX_BLOCK` row rather than `..block`,
+    /// and branchlessly rather than with an early `return false`. Both are
+    /// deliberate:
+    ///
+    /// * the tail `block..MAX_BLOCK` is zero in every row (`rows` is
+    ///   zero-initialised and [`Self::from_counts`] writes exactly `..block`),
+    ///   so `0 <= 0` holds there and including it cannot change the answer --
+    ///   but it turns the trip count into a compile-time constant, which is
+    ///   what lets this vectorise into a handful of 8-lane `u16` compares;
+    /// * `gamma_has_matching` runs `n^2` of these and the rows are sorted
+    ///   descending, so the early exit almost always fires at `t == 0` on a
+    ///   *data-dependent, unpredictable* branch. Paying ~5 vector operations
+    ///   beats paying one mispredict.
+    #[inline]
+    pub fn row_dominated_by(&self, i: usize, other: &Self, j: usize) -> bool {
+        debug_assert_eq!(self.block, other.block);
+        let a = &self.rows[i];
+        let b = &other.rows[j];
+        let mut ok = true;
+        for t in 0..MAX_BLOCK {
+            ok &= a[t] <= b[t];
+        }
+        ok
+    }
+
+    /// `v_i(complement(A)) <= v_j(B)` coordinatewise, i.e.
+    /// `for all t: A.row(i)[t ^ 3] <= B.row(j)[t]`, equivalently
+    /// `for all t: A.row(i)[t] <= B.row(j)[t ^ 3]`.
+    ///
+    /// Same fixed-width branchless shape as [`Self::row_dominated_by`]; the
+    /// `t ^ 3` relabelling reverses each aligned group of four, and `MAX_BLOCK`
+    /// is a multiple of four, so the zero tail maps onto itself and stays
+    /// harmless.
+    #[inline]
+    pub fn row_dominated_by_inverted(&self, i: usize, other: &Self, j: usize) -> bool {
+        debug_assert_eq!(self.block, other.block);
+        let a = &self.rows[i];
+        let b = &other.rows[j];
+        let mut ok = true;
+        for c in (0..MAX_BLOCK).step_by(PAIR_ABSTRACTION_GROUPS) {
+            ok &= a[c] <= b[c + 3];
+            ok &= a[c + 1] <= b[c + 2];
+            ok &= a[c + 2] <= b[c + 1];
+            ok &= a[c + 3] <= b[c];
+        }
+        ok
+    }
+}
