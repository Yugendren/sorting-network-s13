+                continue;
+            }
+            let pj = (j as u64).count_ones() as usize;
+            for t in 0..=6usize {
+                if pj + t > self.channels {
+                    break;
+                }
+                let cnt = (word & INWORD[t]).count_ones();
+                hist[pj + t] += cnt;
+            }
+        }
+
+        hist
+    }
+
+    pub fn low_channels_channel_abstraction_len(&self, low_channels: usize) -> usize {
+        let weights = self.channels - low_channels;
+        let low_indices = 1usize << low_channels;
+        weights * low_indices * 3
+    }
+
+    /// Thin wrapper around [`Self::low_channels_channel_abstraction_with`]
+    /// that builds a one-off [`AbstractionTables`] for this single call.
+    ///
+    /// Callers that invoke this repeatedly for the same `(channels,
+    /// low_channels)` pair (e.g. `Subsume::filter_matching`, which calls it
+    /// `2 * (channels - fixed_channels)` times per search node) should build
+    /// an `AbstractionTables` once with [`AbstractionTables::new`] and call
+    /// [`Self::low_channels_channel_abstraction_with`] directly instead, to
+    /// avoid rebuilding the `bit_low`/`bit_hw`/group tables on every call.
+    pub fn low_channels_channel_abstraction(
+        &self,
+        low_channels: usize,
+        channel: usize,
+        buffer: &mut [usize],
+    ) {
+        let tables = AbstractionTables::new(self.channels, low_channels);
+        self.low_channels_channel_abstraction_with(&tables, low_channels, channel, buffer);
+    }
+
+    /// Table-driven variant of [`Self::low_channels_channel_abstraction`].
+    ///
+    /// Requires `tables.channels() == self.channels() && tables.low_channels()
+    /// == low_channels`; this is checked with `debug_assert!` rather than
+    /// stored redundantly on `self`, since `tables` is expected to be reused
+    /// across many `PackedSet`s that all share the same `channels`.
+    pub fn low_channels_channel_abstraction_with(
+        &self,
+        tables: &AbstractionTables,
+        low_channels: usize,
+        channel: usize,
+        buffer: &mut [usize],
+    ) {
+        debug_assert_eq!(tables.channels, self.channels);
+        debug_assert_eq!(tables.low_channels, low_channels);
+        debug_assert!(channel >= low_channels);
+        debug_assert!(channel < self.channels);
+
+        for v in buffer.iter_mut() {
+            *v = 0;
+        }
+
+        let weights = tables.weights;
+        let low_word_bits = tables.low_word_bits;
+        let bit_low = &tables.bit_low;
+        let ct = &tables.per_channel[channel];
+        let high_word_bits = ct.high_word_bits;
+
+        if channel < 6 {
+            let s = ct.shift_or_bit;
+            let mch = ct.mch;
+            let bit_hw = &tables.bit_hw_low[channel];
+
+            for j in 0..self.words {
+                let word = self.bits[j];
+                let hj = word & mch;
+                let lj = (word << s) & mch;
+                if hj == 0 && lj == 0 {
+                    continue;
+                }
+                let base_low = (j & low_word_bits) << 6;
+                let base_hw = (j & high_word_bits).count_ones() as usize;
+                let row_base = 3 * (base_hw + weights * base_low);
+                Self::accumulate_word(
+                    hj,
+                    lj,
+                    row_base,
+                    weights,
+                    &ct.groups,
+                    bit_low,
+                    bit_hw,
+                    buffer,
+                );
+            }
+        } else {
+            let bit = ct.shift_or_bit;
+            let bit_hw = &tables.bit_hw_high;
+
+            for j in 0..self.words {
+                if j & bit == 0 {
+                    continue;
+                }
+                let hj = self.bits[j];
+                let lj = self.bits[j ^ bit];
+                if hj == 0 && lj == 0 {
+                    continue;
+                }
+                let base_low = (j & low_word_bits) << 6;
+                let base_hw = (j & high_word_bits).count_ones() as usize;
+                let row_base = 3 * (base_hw + weights * base_low);
+                Self::accumulate_word(
+                    hj,
+                    lj,
+                    row_base,
+                    weights,
+                    &ct.groups,
+                    bit_low,
+                    bit_hw,
+                    buffer,
+                );
+            }
+        }
+    }
+
+    /// Groups the (up to 64) in-word bit positions selected by `mch` by
+    /// their `(low_b, hw_b)` bucket, so that
+    /// `low_channels_channel_abstraction` can add a whole group's
+    /// contribution at once via masked popcounts. Each group's constant
+    /// `idx_base = 3 * (hw_b + weights * low_b)` is precomputed here (see
+    /// `accumulate_word`'s doc comment for the identity that makes summing
+    /// it with a per-word `row_base` at use time exact), which also removes
+    /// a multiply from the inner loop.
+    ///
+    /// `low_b` ranges over `0..64` (`bit_low` only ever looks at the
+    /// low 6 bits of the low-channel mask) and `hw_b` ranges over `0..=6`
+    /// (popcount of a 6-bit mask), so `key = low_b * 7 + hw_b < 448`. This
+    /// lets each bucket be found in O(1) via a direct-mapped `slot` table
+    /// instead of a linear scan over already-created groups, making the
+    /// whole function a single O(64) pass over the set bits of `mch` plus
+    /// one O(448) table reset.
+    ///
+    /// Returns a `Vec` sized to the actual number of distinct buckets
+    /// touched (at most 64, and in practice `<= 7` for the small
+    /// `low_channels` widths the search spends its time at) rather than a
+    /// fixed 64-entry array: `AbstractionTables` builds one `ChannelTable`
+    /// per channel, and the fixed-size array was most of its footprint.
+    fn build_groups(
+        mch: u64,
+        bit_low: &[u8; 64],
+        bit_hw: &[u8; 64],
+        weights: usize,
+    ) -> Vec<(u64, u32)> {
+        const NO_GROUP: i16 = -1;
+        let mut slot = [NO_GROUP; 448];
+
+        let mut groups: Vec<(u64, u32)> = Vec::new();
+
+        let mut rem = mch;
+        while rem != 0 {
+            let b = rem.trailing_zeros() as usize;
+            rem &= rem - 1;
+
+            let low_b = bit_low[b] as usize;
+            let hw_b = bit_hw[b] as usize;
+            let key = low_b * 7 + hw_b;
+
+            let gi = slot[key];
+            if gi != NO_GROUP {
+                groups[gi as usize].0 |= 1u64 << b;
+            } else {
+                slot[key] = groups.len() as i16;
+                let idx_base = (3 * (hw_b + weights * low_b)) as u32;
+                groups.push((1u64 << b, idx_base));
+            }
+        }
+        groups
+    }
+
+    /// Adds one word's contribution (`hj` = "hi" bits aligned to bit
+    /// `channel` set, `lj` = the matching "lo" partner bits at the same
+    /// positions) into `buffer`, choosing whichever of the grouped or
+    /// per-bit inner loop looks cheaper for this word's live-bit density.
+    ///
+    /// `row_base` is the per-word part of the flattened index, `3 *
+    /// (base_hw + weights * base_low)`. Each group (or, in the per-bit
+    /// fallback, each live bit) then contributes its own `idx_base = 3 *
+    /// (hw_b + weights * low_b)`, and `row_base + idx_base` is exactly the
+    /// original single-shot `3 * ((base_hw + hw_b) + weights * (base_low |
+    /// low_b))`: `base_low` (a multiple of 64, from `(j & low_word_bits) <<
+    /// 6`) and `low_b` (`< 64`, from the low 6 bits of the low-channel mask)
+    /// occupy disjoint bit ranges, so `base_low | low_b == base_low +
+    /// low_b`, and the sum then distributes over that addition:
+    /// `3*((base_hw+hw_b) + weights*(base_low+low_b)) == 3*(base_hw +
+    /// weights*base_low) + 3*(hw_b + weights*low_b)`.
+    #[allow(clippy::too_many_arguments)]
+    fn accumulate_word(
+        hj: u64,
+        lj: u64,
+        row_base: usize,
+        weights: usize,
+        groups: &[(u64, u32)],
+        bit_low: &[u8; 64],
+        bit_hw: &[u8; 64],
+        buffer: &mut [usize],
+    ) {
+        let live = hj | lj;
+        if live == 0 {
+            return;
+        }
+        let live_count = live.count_ones() as usize;
+        let group_count = groups.len();
+
+        if 2 * group_count <= live_count {
+            for &(gm, idx_base) in groups {
+                let a = lj & gm;
+                let c = hj & gm;
+                if a == 0 && c == 0 {
+                    continue;
+                }
+                let idx = row_base + idx_base as usize;
+                buffer[idx] += a.count_ones() as usize;
+                buffer[idx + 1] += c.count_ones() as usize;
+                buffer[idx + 2] += (a & c).count_ones() as usize;
+            }
+        } else {
+            let mut rem = live;
+            while rem != 0 {
+                let b = rem.trailing_zeros() as usize;
+                let bitv = 1u64 << b;
+                rem &= !bitv;
+                let low_b = bit_low[b] as usize;
+                let hw_b = bit_hw[b] as usize;
+                let idx = row_base + 3 * (hw_b + weights * low_b);
+                buffer[idx] += ((lj & bitv) != 0) as usize;
+                buffer[idx + 1] += ((hj & bitv) != 0) as usize;
+                buffer[idx + 2] += ((lj & hj & bitv) != 0) as usize;
+            }
+        }
+    }
+}
+
+/// Per-`channel` slice of [`AbstractionTables`]: everything
+/// `low_channels_channel_abstraction_with` needs that varies with
+/// `channel` (but not with the `PackedSet` being queried).
+#[derive(Clone)]
+struct ChannelTable {
+    /// In-word channel mask (`BIT_MASK[channel]` for `channel < 6`, `!0u64`
+    /// for `channel >= 6`, matching the original per-call computation).
+    mch: u64,
+    /// `1 << channel` (the in-word shift) for `channel < 6`; `1 <<
+    /// (channel - 6)` (the word-index bit) for `channel >= 6`.
+    shift_or_bit: usize,
+    /// `high_mask >> 6` for this channel.
+    high_word_bits: usize,
+    /// `(mask, idx_base)` per group; see `PackedSet::build_groups`. Sized to
+    /// the actual number of distinct `(low_b, hw_b)` buckets touched, not a
+    /// fixed 64-entry array.
+    groups: Vec<(u64, u32)>,
+}
+
+impl ChannelTable {
+    const EMPTY: ChannelTable = ChannelTable {
+        mch: 0,
+        shift_or_bit: 0,
+        high_word_bits: 0,
+        groups: Vec::new(),
+    };
+}
+
+/// Reusable precomputed tables for [`PackedSet::low_channels_channel_abstraction_with`],
+/// built once for a `(channels, low_channels)` pair and shared across every
+/// `channel` in `low_channels..channels` and across every `PackedSet` with
+/// that `channels` count.
+///
+/// `Subsume::filter_matching` calls `low_channels_channel_abstraction` `2 *
+/// (channels - fixed_channels)` times per search node, always with the same
+/// `low_channels` (== `fixed_channels`, which only changes a handful of
+/// times per search). Building `bit_low`/`bit_hw`/the per-channel group
+/// tables once per node (via this type) instead of once per call amortizes
+/// that setup cost across all of those calls; M2c additionally caches whole
+/// `AbstractionTables` instances across `Subsume` instances (see
+/// `output_set::subsume`'s thread-local `TABLE_CACHE`), since a fresh
+/// `Subsume` is built for every exact subsumption test.
+pub struct AbstractionTables {
+    channels: usize,
+    low_channels: usize,
+    weights: usize,
+    /// `low_mask >> 6`; does not depend on `channel`.
+    low_word_bits: usize,
+    /// `bit_low[b] = b & (low_mask & 63)`; does not depend on `channel`
+    /// (the low-channel mask never includes bit `channel`'s in-word
+    /// position by construction: `channel >= low_channels`). Values are
+    /// always `< 64`, hence `u8`.
+    bit_low: [u8; 64],
+    /// One `bit_hw` array per `channel` in `0..6.min(channels)`, since for
+    /// `channel < 6` the in-word high mask excludes bit `channel`. Values
+    /// are popcounts of a 6-bit mask, hence always `<= 6` and `u8`.
+    bit_hw_low: [[u8; 64]; 6],
+    /// Shared `bit_hw` array for every `channel >= 6`: bit `channel`'s
+    /// in-word contribution is always 0 there (it is a word-index bit), so
+    /// the in-word high mask -- and hence this array -- is the same for
+    /// every such channel. Values are `<= 6`, hence `u8`.
+    bit_hw_high: [u8; 64],
+    /// Indexed by `channel`, length exactly `channels`: entries below
+    /// `low_channels` are `ChannelTable::EMPTY` placeholders (never read,
+    /// since every caller checks `channel >= low_channels` first), entries
+    /// in `low_channels..channels` are populated. A `Vec` rather than a
+    /// fixed `[_; MAX_CHANNELS]` array both because `ChannelTable` is no
+    /// longer `Copy` (its `groups` field is itself a `Vec`) and to avoid
+    /// paying for unused tail entries when `channels < MAX_CHANNELS`.
+    per_channel: Vec<ChannelTable>,
+}
+
+impl AbstractionTables {
+    pub fn new(channels: usize, low_channels: usize) -> Self {
+        crate::instrument::bump(&crate::instrument::SUBSUME_TABLE_BUILDS);
+        debug_assert!(channels <= MAX_CHANNELS);
+        debug_assert!(low_channels <= channels);
+
+        let weights = channels - low_channels;
+        let low_indices = 1usize << low_channels;
+        let low_mask = low_indices - 1;
+        let full_mask = (1usize << channels) - 1;
+        let low_in_word = low_mask & 63;
+        let low_word_bits = low_mask >> 6;
+
+        let mut bit_low = [0u8; 64];
+        for b in 0..64usize {
+            bit_low[b] = (b & low_in_word) as u8;
+        }
+
+        // channel >= 6: bit `channel` never lands in the low 6 bits of
+        // `high_mask`, so this in-word high mask (and the `bit_hw` array
+        // derived from it) is shared by every such channel.
+        let high_mask_high = !low_mask & full_mask;
+        let high_in_word_high = high_mask_high & 63;
+        let mut bit_hw_high = [0u8; 64];
+        for b in 0..64usize {
+            bit_hw_high[b] = (b & high_in_word_high).count_ones() as u8;
+        }
+
+        let mut bit_hw_low = [[0u8; 64]; 6];
+        for channel in 0..6.min(channels) {
+            let mask = 1usize << channel;
+            let high_mask = !(low_mask | mask) & full_mask;
+            let high_in_word = high_mask & 63;
+            for b in 0..64usize {
+                bit_hw_low[channel][b] = (b & high_in_word).count_ones() as u8;
+            }
+        }
+
+        let mut per_channel: Vec<ChannelTable> = Vec::with_capacity(channels);
+        for _ in 0..low_channels {
+            per_channel.push(ChannelTable::EMPTY);
+        }
+        for channel in low_channels..channels {
+            let mask = 1usize << channel;
+            let high_mask = !(low_mask | mask) & full_mask;
+            let high_word_bits = high_mask >> 6;
+
+            if channel < 6 {
+                let s = mask;
+                let mch = BIT_MASK[channel];
+                let groups =
+                    PackedSet::build_groups(mch, &bit_low, &bit_hw_low[channel], weights);
+                per_channel.push(ChannelTable {
+                    mch,
+                    shift_or_bit: s,
+                    high_word_bits,
+                    groups,
+                });
+            } else {
+                let bit = 1usize << (channel - 6);
+                let groups = PackedSet::build_groups(!0u64, &bit_low, &bit_hw_high, weights);
+                per_channel.push(ChannelTable {
+                    mch: !0u64,
+                    shift_or_bit: bit,
+                    high_word_bits,
+                    groups,
+                });
+            }
+        }
+
+        Self {
+            channels,
+            low_channels,
+            weights,
+            low_word_bits,
+            bit_low,
+            bit_hw_low,
+            bit_hw_high,
+            per_channel,
+        }
+    }
+
+    pub fn channels(&self) -> usize {
+        self.channels
+    }
+
+    pub fn low_channels(&self) -> usize {
+        self.low_channels
+    }
+
+    /// Same value as `PackedSet::low_channels_channel_abstraction_len`.
+    pub fn abstraction_len(&self) -> usize {
+        self.weights * (1usize << self.low_channels) * 3
+    }
+}
+
+/// Number of rows/columns in [`BINOM`] (indices `0..=MAX_CHANNELS`).
+const BINOM_ROWS: usize = MAX_CHANNELS + 1;
+
+/// Pascal's-triangle table of binomial coefficients, `BINOM[n][k] ==
+/// C(n, k)`, for `n, k` in `0..=MAX_CHANNELS`.
+const fn binomials() -> [[u64; BINOM_ROWS]; BINOM_ROWS] {
+    let mut table = [[0u64; BINOM_ROWS]; BINOM_ROWS];
+    let mut n = 0usize;
+    while n < BINOM_ROWS {
+        table[n][0] = 1;
+        let mut k = 1usize;
+        while k <= n {
+            // `table[n - 1][k]` is still 0 (never written) when `k > n -
+            // 1`, so this is exactly `C(n-1, k-1) + C(n-1, k)` including
+            // the `k == n` boundary case.
+            table[n][k] = table[n - 1][k - 1] + table[n - 1][k];
+            k += 1;
+        }
+        n += 1;
+    }
+    table
+}
+
+const BINOM: [[u64; BINOM_ROWS]; BINOM_ROWS] = binomials();
+
+/// `T(channels, w, j) = ceil(C(channels, w) * (j + 1) / 6)`, computed in
+/// integer arithmetic. Non-decreasing in `j` (since the numerator is
+/// non-decreasing in `j` and the denominator is fixed), and `>= 1` at `j ==
+/// 0` (since `C(channels, w) >= 1` for `w <= channels`).
+fn histogram_threshold(channels: usize, w: usize, j: usize) -> u64 {
+    let numerator = BINOM[channels][w] * (j as u64 + 1);
+    (numerator + 5) / 6
+}
+
+/// `true` iff `a[w] <= b[w]` for all `w`. Necessary condition for "exists
+/// `pi`: `pi(A) subset-of B`" (a channel permutation preserves Hamming
+/// weight, so if such a `pi` exists then, weight class by weight class,
+/// `pi` maps `A`'s weight-`w` elements into a subset of `B`'s weight-`w`
+/// elements).
+pub fn hist_subsumes(a: &[u32], b: &[u32]) -> bool {
+    debug_assert_eq!(a.len(), b.len());
+    a.iter().zip(b.iter()).all(|(&av, &bv)| av <= bv)
+}
+
+/// `true` iff `a[k - w] <= b[w]` for all `w` (equivalently,
+/// `hist_subsumes(&reverse_histogram(a), b)`). Necessary condition for
+/// "exists `pi`: `pi(complement(A)) subset-of B`", since complementation
+/// maps weight `w` to weight `k - w`.
+pub fn hist_subsumes_inverted(a: &[u32], b: &[u32]) -> bool {
+    debug_assert_eq!(a.len(), b.len());
+    let n = a.len();
+    (0..n).all(|w| a[n - 1 - w] <= b[w])
+}
+
+/// The reverse of a histogram (slot `w` -> slot `channels - w`), so that a
+/// caller can compute `histogram_signature(k, &reversed)` once per query
+/// rather than reversing on every `hist_subsumes_inverted`-style comparison.
+pub fn reverse_histogram(hist: &[u32]) -> WVec<u32> {
+    hist.iter().rev().copied().collect()
+}
+
+/// 64-bit monotone "thermometer" signature of a weight histogram: bit `5 *
+/// w + j` (for `w` in `0..=channels`, `j` in `0..5`) is set iff `hist[w] >=
+/// histogram_threshold(channels, w, j)`.
+///
+/// Since the threshold is non-decreasing in `j` for fixed `(channels, w)`,
+/// each 5-bit slot is a monotone (thermometer-coded) encoding of `hist[w]`
+/// against the same 5 breakpoints for any two histograms with the same
+/// `channels`. That is exactly what makes the one-sided filter sound:
+/// `hist_subsumes(a, b)` (i.e. `a[w] <= b[w]` for every `w`) implies
+/// `histogram_signature(k, a) & !histogram_signature(k, b) == 0`, since
+/// `a[w] <= b[w]` and both are compared against the *same* thresholds means
+/// every threshold `a[w]` clears, `b[w]` also clears.
+///
+/// `channels <= MAX_CHANNELS == 11`, so at most `12 * 5 == 60` bits are
+/// used; this fits comfortably in a `u64`.
+pub fn histogram_signature(channels: usize, hist: &[u32]) -> u64 {
+    debug_assert!(channels <= MAX_CHANNELS);
+    debug_assert_eq!(hist.len(), channels + 1);
+
+    let mut sig = 0u64;
+    for w in 0..=channels {
+        let hw = hist[w] as u64;
+        for j in 0..5usize {
+            if hw >= histogram_threshold(channels, w, j) {
+                sig |= 1u64 << (5 * w + j);
+            }
+        }
+    }
+    sig
+}
