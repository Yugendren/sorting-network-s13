+}
+
+pub struct Checkpointer<'a> {
+    states: &'a StateMap,
+    /// The canonicalised search root, kept so the header can carry its bounds.
+    root: OutputSet,
+    channels: usize,
+    identity: String,
+    identity_hash: [u8; 32],
+    dir: PathBuf,
+    keep_prev: bool,
+    started: Instant,
+    seq: AtomicU64,
+}
+
+impl<'a> Checkpointer<'a> {
+    /// `None` when `SORTNETOPT_CHECKPOINT_DIR` is unset.
+    pub fn from_env(
+        states: &'a StateMap,
+        root: OutputSet<&[bool]>,
+        limit: Option<usize>,
+        prefix: &[usize],
+    ) -> io::Result<Option<Self>> {
+        let config = config();
+        match config.dir.as_ref() {
+            None => Ok(None),
+            Some(dir) => Ok(Some(Self::new_at(
+                dir.clone(),
+                config.keep_prev,
+                states,
+                root,
+                limit,
+                prefix,
+            )?)),
+        }
+    }
+
+    pub fn new_at(
+        dir: PathBuf,
+        keep_prev: bool,
+        states: &'a StateMap,
+        root: OutputSet<&[bool]>,
+        limit: Option<usize>,
+        prefix: &[usize],
+    ) -> io::Result<Self> {
+        // macOS: leaf directories must exist before a file is created in them.
+        fs::create_dir_all(&dir)?;
+
+        let channels = root.channels();
+        let identity = identity_string(states, channels, limit, prefix);
+        let identity_hash = sha256(identity.as_bytes());
+
+        Ok(Self {
+            states,
+            root: root.to_owned(),
+            channels,
+            identity,
+            identity_hash,
+            dir,
+            keep_prev,
+            started: Instant::now(),
+            seq: AtomicU64::new(0),
+        })
+    }
+
+    pub fn path(&self) -> PathBuf {
+        self.dir.join(FILE_NAME)
+    }
+
+    /// Take one globally quiesced snapshot and rename it over `checkpoint.bin`.
+    pub fn snapshot(&self) -> io::Result<SnapshotStats> {
+        let t_total = Instant::now();
+        let seq = self.seq.fetch_add(1, Relaxed) + 1;
+
+        let tmp_path = self.dir.join(TMP_NAME);
+        let final_path = self.path();
+
+        // Anti-starvation only: it changes no semantics, it just stops a stream
+        // of `set` readers from indefinitely deferring our write acquisition.
+        self.states.request_checkpoint(true);
+
+        let stats;
+        let stall;
+        let file;
+        {
+            let t_stall = Instant::now();
+            // Every stripe, released together when this block ends.
+            let _quiesced = self.states.checkpoint_gate_write();
+
+            // Everything from here to the end of this block observes a single,
+            // frozen state of the memo table and the subsumption index.
+            let result = self.write_to(&tmp_path, seq);
+            stall = t_stall.elapsed();
+
+            match result {
+                Ok((snapshot_stats, snapshot_file)) => {
+                    stats = snapshot_stats;
+                    file = snapshot_file;
+                }
+                Err(err) => {
+                    self.states.request_checkpoint(false);
+                    return Err(err);
+                }
+            }
+        }
+        self.states.request_checkpoint(false);
+
+        // Durability, outside the quiesce: the bytes are already in the kernel,
+        // and no further read of the frozen state is needed.
+        file.sync_all()?;
+        drop(file);
+
+        if self.keep_prev && final_path.exists() {
+            let _ = fs::rename(&final_path, self.dir.join(PREV_NAME));
+        }
+
+        // Atomic on APFS.
+        fs::rename(&tmp_path, &final_path)?;
+
+        // ... but the rename itself is only durable once the *directory* is
+        // synced, otherwise a power loss can leave neither name pointing at the
+        // new inode.
+        File::open(&self.dir)?.sync_all()?;
+
+        let stats = SnapshotStats {
+            elapsed: t_total.elapsed(),
+            stall,
+            ..stats
+        };
+
+        instrument::bump(&instrument::CKPT_WRITES);
+        instrument::add(&instrument::CKPT_BYTES, stats.bytes);
+        instrument::add(&instrument::CKPT_WRITE_NS, stats.elapsed.as_nanos() as u64);
+        instrument::add(&instrument::CKPT_STALL_NS, stats.stall.as_nanos() as u64);
+
+        Ok(stats)
+    }
+
+    /// Must be called with every checkpoint gate stripe held in write mode.
+    fn write_to(&self, tmp_path: &Path, seq: u64) -> io::Result<(SnapshotStats, File)> {
+        let census = self.states.census();
+        let states_total = census.total();
+
+        let dims = self.states.subsume_index_dims();
+        let index_counts = dims
+            .iter()
+            .map(|&(k, point_dim)| {
+                let count = self
+                    .states
+                    .subsume_index_at(k)
+                    .map(|index| index.len() as u64)
+                    .unwrap_or(0);
+                (k, point_dim, count)
+            })
+            .collect::<Vec<_>>();
+        let index_total: u64 = index_counts.iter().map(|&(_, _, count)| count).sum();
+
+        let root_state = self.states.get(self.root.as_ref());
+
+        let mut flags = 0u32;
+        if !index_counts.is_empty() {
+            flags |= FLAG_INDEX;
+        }
+
+        let file = File::create(tmp_path)?;
+        let mut out = HashWriter::new(BufWriter::with_capacity(1 << 20, file));
+
+        // --- header -----------------------------------------------------
+        let mut header = [0u8; HEADER_LEN];
+        header[0..8].copy_from_slice(&MAGIC);
+        header[8..12].copy_from_slice(&FORMAT_VERSION.to_le_bytes());
+        header[12..16].copy_from_slice(&flags.to_le_bytes());
+        header[16..48].copy_from_slice(&self.identity_hash);
+        header[48..56].copy_from_slice(&(self.channels as u64).to_le_bytes());
+        header[56..64].copy_from_slice(&seq.to_le_bytes());
+        header[64..72].copy_from_slice(&states_total.to_le_bytes());
+        header[72..80].copy_from_slice(&index_total.to_le_bytes());
+        header[80..88].copy_from_slice(&(self.started.elapsed().as_millis() as u64).to_le_bytes());
+        header[88] = root_state.bounds[0];
+        header[89] = root_state.bounds[1];
+        header[90] = root_state.huffman_bounds[0];
+        header[91] = root_state.huffman_bounds[1];
+        // header[92..120] stays zeroed (reserved).
+        let header_hash = fnv1a64(&header[..120]);
+        header[120..128].copy_from_slice(&header_hash.to_le_bytes());
+        out.put(&header)?;
+
+        // --- identity text ----------------------------------------------
+        let identity = self.identity.as_bytes();
+        out.put_u32(identity.len() as u32)?;
+        out.put(identity)?;
+
+        // --- states -----------------------------------------------------
+        let mut written_states = 0u64;
+        for channels in 3..=MAX_CHANNELS {
+            let count = census.entries[channels];
+            out.put_u64(count)?;
+            if count == 0 {
+                continue;
+            }
+
+            let mut emitted = 0u64;
+            let mut error: Option<io::Error> = None;
+            self.states.for_each_state_at(channels, &mut |packed, state| {
+                if error.is_some() {
+                    return;
+                }
+                let mut record = [0u8; 4];
+                record[0] = state.bounds[0];
+                record[1] = state.bounds[1];
+                record[2] = state.huffman_bounds[0];
+                record[3] = state.huffman_bounds[1];
+                if let Err(err) = out.put(packed).and_then(|()| out.put(&record)) {
+                    error = Some(err);
+                    return;
+                }
+                emitted += 1;
+            });
+            if let Some(err) = error {
+                return Err(err);
+            }
+            // Every gate stripe is held, so nothing can have changed under us.
+            assert_eq!(
+                emitted, count,
+                "checkpoint: states section for k={} raced the census",
+                channels
+            );
+            written_states += emitted;
+        }
+        assert_eq!(written_states, states_total);
+
+        // --- index ------------------------------------------------------
+        let mut written_index = 0u64;
+        if flags & FLAG_INDEX != 0 {
+            out.put_u32(index_counts.len() as u32)?;
+            for &(k, point_dim, count) in index_counts.iter() {
+                out.put_u8(k as u8)?;
+                out.put_u32(point_dim as u32)?;
+                out.put_u64(count)?;
+
+                let index = self.states.subsume_index_at(k).unwrap();
+                let mut emitted = 0u64;
+                let mut error: Option<io::Error> = None;
+                index.for_each_entry(&mut |packed, value, abstraction| {
+                    if error.is_some() {
+                        return;
+                    }
+                    debug_assert_eq!(abstraction.len(), point_dim);
+                    let result = out.put(packed).and_then(|()| out.put_u8(value)).and_then(|()| {
+                        for coordinate in abstraction.iter() {
+                            out.put(&coordinate.to_le_bytes())?;
+                        }
+                        Ok(())
+                    });
+                    if let Err(err) = result {
+                        error = Some(err);
+                        return;
+                    }
+                    emitted += 1;
+                });
+                if let Some(err) = error {
+                    return Err(err);
+                }
+                assert_eq!(
+                    emitted, count,
+                    "checkpoint: index section for k={} raced its own len()",
+                    k
+                );
+                written_index += emitted;
+            }
+        }
+        assert_eq!(written_index, index_total);
+
+        // --- trailer ----------------------------------------------------
+        let payload_hash = out.hasher.finalize();
+        let mut inner = out.inner;
+        inner.write_all(&payload_hash)?;
+        inner.write_all(&MAGIC_END)?;
+        let bytes = out.count + TRAILER_LEN as u64;
+
+        inner.flush()?;
+        let file = inner.into_inner().map_err(|err| err.into_error())?;
+
+        // TIER2b: `flush()` (the last `write(2)`) is the last operation that
+        // needs to observe the frozen state. `sync_all()` does not — it only
+        // pushes bytes the kernel already owns down to stable storage — so it
+        // is deliberately *not* done here. The caller drops the quiesce guard
+        // first and fsyncs after, which keeps the search stall proportional to
+        // the walk and not to the device. At n=10 that is worth ~2 ms of a
+        // 12 ms stall; at n=11, where the payload is gigabytes, it is the
+        // difference between a bounded stall and a device-latency stall.
+        Ok((
+            SnapshotStats {
+                seq,
+                bytes,
+                states: states_total,
+                index: index_total,
+                elapsed: Duration::default(),
+                stall: Duration::default(),
+            },
+            file,
+        ))
+    }
+
+    /// One snapshot with the standard log line. Errors are logged, not fatal:
+    /// losing a periodic checkpoint must not kill a multi-hour search.
+    pub fn snapshot_logged(&self, label: &str) {
+        match self.snapshot() {
+            Ok(stats) => log::info!(
+                "checkpoint: wrote seq={} states={} index={} bytes={} in {} ms (stall {} ms){}",
+                stats.seq,
+                stats.states,
+                stats.index,
+                stats.bytes,
+                stats.elapsed.as_millis(),
+                stats.stall.as_millis(),
+                label,
+            ),
+            Err(err) => log::error!("checkpoint: write failed: {}", err),
+        }
+    }
+
+    /// The dedicated checkpoint thread. Not a pool task: it must not occupy a
+    /// worker, and it must not be an async task that a blocked pool could
+    /// starve. Wakes once a second so shutdown is prompt regardless of the
+    /// configured interval.
+    pub fn drive(&self, shutdown: &AtomicBool, interval: Duration) {
+        if interval.is_zero() {
+            // Periodic writes disabled; the final write still happens.
+            while !shutdown.load(Relaxed) {
+                std::thread::sleep(Duration::from_secs(1));
+            }
+            return;
+        }
+
+        let mut next = Instant::now() + interval;
+        loop {
+            std::thread::sleep(Duration::from_secs(1));
+            if shutdown.load(Relaxed) {
+                return;
+            }
+            if Instant::now() >= next {
+                self.snapshot_logged("");
+                next = Instant::now() + interval;
+            }
+        }
+    }
+
+    // --- reading ---------------------------------------------------------
+
+    /// Resume from `<dir>/checkpoint.bin` when `SORTNETOPT_CHECKPOINT_RESUME`
+    /// asks for it. A missing file is not an error (logged, start fresh); any
+    /// *invalid* file is fatal, with no override.
+    pub fn resume_if_requested(&self) -> Option<ResumeInfo> {
+        if !config().resume {
+            return None;
+        }
+
+        let path = self.path();
+        if !path.exists() {
+            log::info!(
+                "checkpoint: resume requested but {} does not exist; starting fresh",
+                path.display()
+            );
+            return None;
+        }
+
+        match self.restore_from(&path) {
+            Ok(info) => {
+                let root = self.states.get(self.root.as_ref());
+                log::info!(
+                    "checkpoint: resumed seq={} states={} index={} root={:?} in {} ms",
+                    info.seq,
+                    info.states,
+                    info.index,
+                    root,
+                    info.elapsed.as_millis()
+                );
+                Some(info)
+            }
+            Err(message) => {
+                // No silent fallback to a fresh start, and no override flag: a
+                // measurement that quietly restarted would be worse than one
+                // that stopped.
+                log::error!("checkpoint: refusing to resume from {}", path.display());
+                for line in message.lines() {
+                    log::error!("checkpoint: {}", line);
+                }
+                eprintln!(
+                    "checkpoint: refusing to resume from {}\n{}",
+                    path.display(),
+                    message
+                );
+                std::process::exit(3);
+            }
+        }
+    }
+
+    /// Validate, then restore. Single-threaded, before any worker starts, so no
+    /// gate is needed.
+    pub fn restore_from(&self, path: &Path) -> Result<ResumeInfo, String> {
+        let t0 = Instant::now();
+
+        let header = self.validate(path)?;
+
+        let file = File::open(path).map_err(|err| format!("cannot open: {}", err))?;
+        let mut reader = BufReader::with_capacity(1 << 20, file);
+        let mut skip = vec![0u8; HEADER_LEN + 4 + header.identity_len];
+        reader
+            .read_exact(&mut skip)
+            .map_err(|err| format!("truncated before sections: {}", err))?;
+
+        // --- states -----------------------------------------------------
+        let mut restored_states = 0u64;
+        for channels in 3..=MAX_CHANNELS {
+            let count = read_u64(&mut reader)?;
+            let packed_len = OutputSet::packed_len_for_channels(channels);
+            let mut record = vec![0u8; packed_len + 4];
+            for _ in 0..count {
+                reader
+                    .read_exact(&mut record)
+                    .map_err(|err| format!("truncated in states k={}: {}", channels, err))?;
+                let state = State {
+                    bounds: [record[packed_len], record[packed_len + 1]],
+                    huffman_bounds: [record[packed_len + 2], record[packed_len + 3]],
+                };
+                self.states
+                    .restore_state(channels, &record[..packed_len], state);
+                restored_states += 1;
+            }
+        }
+
+        // --- index ------------------------------------------------------
+        let mut restored_index = 0u64;
+        if header.flags & FLAG_INDEX != 0 {
+            let n_widths = read_u32(&mut reader)? as usize;
+            for _ in 0..n_widths {
+                let k = read_u8(&mut reader)? as usize;
+                let point_dim = read_u32(&mut reader)? as usize;
+                let count = read_u64(&mut reader)?;
+                let packed_len = OutputSet::packed_len_for_channels(k);
+                let record_len = packed_len + 1 + point_dim * 2;
+                let mut record = vec![0u8; record_len];
+
+                let live = self.states.subsume_index_at(k);
+                // Cannot happen: the width/point_dim list is in the identity
+                // hash, which has already been checked. Assert loudly anyway.
+                let live_dim = live.map(|index| index.point_dim());
+                assert_eq!(
+                    live_dim,
+                    Some(point_dim),
+                    "checkpoint: stored index width k={} point_dim={} disagrees with the live \
+                     index ({:?}) despite a matching identity hash",
+                    k,
+                    point_dim,
+                    live_dim
+                );
+
+                let mut abstraction = vec![0u16; point_dim];
+                for _ in 0..count {
+                    reader
+                        .read_exact(&mut record)
+                        .map_err(|err| format!("truncated in index k={}: {}", k, err))?;
+                    let value = record[packed_len];
+                    for (slot, chunk) in abstraction
+                        .iter_mut()
+                        .zip(record[packed_len + 1..].chunks_exact(2))
+                    {
+                        *slot = u16::from_le_bytes([chunk[0], chunk[1]]);
+                    }
+                    live.unwrap()
+                        .restore_entry(&record[..packed_len], value, &abstraction);
+                    restored_index += 1;
+                }
+            }
+        }
+
+        if restored_states != header.states_total {
+            return Err(format!(
+                "states section holds {} entries, header claims {}",
+                restored_states, header.states_total
+            ));
+        }
+        if restored_index != header.index_total {
+            return Err(format!(
+                "index section holds {} entries, header claims {}",
+                restored_index, header.index_total
+            ));
+        }
+
+        let elapsed = t0.elapsed();
+        instrument::add(&instrument::CKPT_RESTORE_NS, elapsed.as_nanos() as u64);
+        instrument::add(&instrument::CKPT_RESTORED_STATES, restored_states);
+        instrument::add(&instrument::CKPT_RESTORED_INDEX, restored_index);
+        // A resumed run continues the sequence rather than restarting it.
+        self.seq.store(header.seq, Relaxed);
+
+        Ok(ResumeInfo {
+            seq: header.seq,
+            states: restored_states,
+            index: restored_index,
+            elapsed,
+        })
+    }
+
+    /// Validation pass. The order is deliberate, and each step has its own
+    /// actionable message: magic, format_version, header_hash, identity_hash,
+    /// trailer magic, payload_hash. Nothing is restored until all of them pass.
+    fn validate(&self, path: &Path) -> Result<Header, String> {
+        let mut file = File::open(path).map_err(|err| format!("cannot open: {}", err))?;
+        let file_len = file
+            .metadata()
+            .map_err(|err| format!("cannot stat: {}", err))?
+            .len();
+
+        if file_len < (HEADER_LEN + 4 + TRAILER_LEN) as u64 {
+            return Err(format!(
+                "file is {} bytes, smaller than the {}-byte minimum (header + identity + trailer); \
+                 it is truncated or not a checkpoint",
+                file_len,
+                HEADER_LEN + 4 + TRAILER_LEN
+            ));
+        }
+
+        let mut raw = [0u8; HEADER_LEN];
+        file.read_exact(&mut raw)
+            .map_err(|err| format!("cannot read header: {}", err))?;
+
+        // 1. magic
+        if raw[0..8] != MAGIC {
+            return Err(format!(
+                "bad magic: found {:?}, expected {:?}. This is not a sortnetopt checkpoint.",
+                &raw[0..8],
+                &MAGIC
+            ));
+        }
+
+        // 2. format_version
+        let format_version = u32::from_le_bytes([raw[8], raw[9], raw[10], raw[11]]);
+        if format_version != FORMAT_VERSION {
+            return Err(format!(
+                "format_version {} is not supported by this binary (which writes and reads {}). \
+                 Re-run the search from scratch with this binary.",
+                format_version, FORMAT_VERSION
+            ));
+        }
+
+        // 3. header_hash
+        let stored_header_hash = u64::from_le_bytes([
+            raw[120], raw[121], raw[122], raw[123], raw[124], raw[125], raw[126], raw[127],
+        ]);
+        let computed_header_hash = fnv1a64(&raw[..120]);
+        if stored_header_hash != computed_header_hash {
+            return Err(format!(
+                "header hash mismatch: stored {:#018x}, computed {:#018x}. The header is corrupt; \
+                 no field in it can be trusted.",
+                stored_header_hash, computed_header_hash
+            ));
+        }
+
+        let header = Header {
+            flags: u32::from_le_bytes([raw[12], raw[13], raw[14], raw[15]]),
+            identity_hash: {
+                let mut hash = [0u8; 32];
+                hash.copy_from_slice(&raw[16..48]);
+                hash
+            },
+            channels: u64::from_le_bytes([
+                raw[48], raw[49], raw[50], raw[51], raw[52], raw[53], raw[54], raw[55],
+            ]),
+            seq: u64::from_le_bytes([
+                raw[56], raw[57], raw[58], raw[59], raw[60], raw[61], raw[62], raw[63],
+            ]),
+            states_total: u64::from_le_bytes([
+                raw[64], raw[65], raw[66], raw[67], raw[68], raw[69], raw[70], raw[71],
+            ]),
+            index_total: u64::from_le_bytes([
+                raw[72], raw[73], raw[74], raw[75], raw[76], raw[77], raw[78], raw[79],
+            ]),
+            identity_len: 0,
+        };
+
+        // identity text (needed to explain a hash mismatch)
+        let mut length = [0u8; 4];
+        file.read_exact(&mut length)
+            .map_err(|err| format!("cannot read identity length: {}", err))?;
+        let identity_len = u32::from_le_bytes(length) as usize;
+        if identity_len as u64 > file_len {
+            return Err(format!(
+                "identity length {} exceeds the file size {}",
+                identity_len, file_len
+            ));
+        }
+        let mut identity = vec![0u8; identity_len];
+        file.read_exact(&mut identity)
+            .map_err(|err| format!("cannot read identity string: {}", err))?;
+        let stored_identity = String::from_utf8_lossy(&identity).into_owned();
+
+        // 4. identity_hash
+        if header.identity_hash != self.identity_hash {
+            let mut message = String::new();
+            message.push_str(
+                "identity mismatch: this checkpoint was written by a search with different \
+                 semantics, so resuming from it would produce an unsound or incomparable result.\n",
+            );
+            let stored_lines: Vec<&str> = stored_identity.lines().collect();
+            let current_lines: Vec<&str> = self.identity.lines().collect();
+            let differing: Vec<String> = diff_lines(&stored_lines, &current_lines);
+            message.push_str("differing lines:\n");
+            for line in differing.iter() {
+                message.push_str("  ");
+                message.push_str(line);
+                message.push('\n');
+            }
+            message.push_str(&format!(
+                "stored identity (sha256 {}):\n{}\ncurrent identity (sha256 {}):\n{}",
+                hex(&header.identity_hash),
+                stored_identity,
+                hex(&self.identity_hash),
+                self.identity
+            ));
+            return Err(message);
+        }
+
+        // 5. trailer magic
+        let mut trailer = [0u8; TRAILER_LEN];
+        file.seek(SeekFrom::Start(file_len - TRAILER_LEN as u64))
+            .map_err(|err| format!("cannot seek to trailer: {}", err))?;
+        file.read_exact(&mut trailer)
+            .map_err(|err| format!("cannot read trailer: {}", err))?;
+        if trailer[32..40] != MAGIC_END {
+            return Err(format!(
+                "bad trailer magic: found {:?}, expected {:?}. The file was truncated, or the \
+                 writing process was killed mid-write (in which case the *.tmp rename never ran, \
+                 so this file should not exist).",
+                &trailer[32..40],
+                &MAGIC_END
+            ));
+        }
+
+        // 6. payload_hash
+        file.seek(SeekFrom::Start(0))
+            .map_err(|err| format!("cannot rewind: {}", err))?;
+        let mut hasher = Sha256::new();
+        let mut remaining = file_len - TRAILER_LEN as u64;
+        let mut buffer = vec![0u8; 1 << 20];
+        while remaining > 0 {
+            let want = (buffer.len() as u64).min(remaining) as usize;
+            file.read_exact(&mut buffer[..want])
+                .map_err(|err| format!("cannot read payload: {}", err))?;
+            hasher.update(&buffer[..want]);
+            remaining -= want as u64;
+        }
+        let computed = hasher.finalize();
+        if computed != trailer[..32] {
+            return Err(format!(
+                "payload hash mismatch: stored {}, computed {}. The checkpoint body is corrupt \
+                 (bit rot, a partial write, or an edit).",
+                hex(&trailer[..32]),
+                hex(&computed)
+            ));
+        }
+
+        if header.channels != self.channels as u64 {
+            // Unreachable while `channels` is in the identity string, but the
+            // header field is what the restore loop trusts, so check it too.
+            return Err(format!(
+                "header channels={} but this search has channels={}",
+                header.channels, self.channels
+            ));
+        }
+
+        Ok(Header {
+            identity_len,
+            ..header
+        })
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Header {
+    flags: u32,
+    identity_hash: [u8; 32],
+    channels: u64,
+    seq: u64,
+    states_total: u64,
+    index_total: u64,
+    identity_len: usize,
+}
+
+/// Line-level set difference in both directions, formatted for a refusal
+/// message. The identity string is a sorted key=value text, so this is enough
+/// to name the offending setting exactly.
+fn diff_lines(stored: &[&str], current: &[&str]) -> Vec<String> {
+    let mut out = vec![];
+    for line in stored.iter() {
+        if !current.contains(line) {
+            out.push(format!("stored  : {}", line));
+        }
+    }
+    for line in current.iter() {
+        if !stored.contains(line) {
+            out.push(format!("current : {}", line));
+        }
+    }
+    if out.is_empty() {
+        out.push("(no textual difference; the stored identity text is itself corrupt)".to_owned());
+    }
+    out
+}
+
+fn read_exact_n<R: Read>(reader: &mut R, buffer: &mut [u8]) -> Result<(), String> {
+    reader
+        .read_exact(buffer)
+        .map_err(|err| format!("truncated checkpoint: {}", err))
+}
+
+fn read_u8<R: Read>(reader: &mut R) -> Result<u8, String> {
+    let mut buffer = [0u8; 1];
+    read_exact_n(reader, &mut buffer)?;
+    Ok(buffer[0])
+}
+
+fn read_u32<R: Read>(reader: &mut R) -> Result<u32, String> {
+    let mut buffer = [0u8; 4];
+    read_exact_n(reader, &mut buffer)?;
+    Ok(u32::from_le_bytes(buffer))
+}
+
+fn read_u64<R: Read>(reader: &mut R) -> Result<u64, String> {
+    let mut buffer = [0u8; 8];
+    read_exact_n(reader, &mut buffer)?;
+    Ok(u64::from_le_bytes(buffer))
+}
