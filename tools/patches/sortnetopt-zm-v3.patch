+    /// Random reachable-ish corpora: random comparator chains from the full
+    /// cube, keeping every intermediate set (the population `prune.rs` and the
+    /// on-line index actually see).
+    fn corpus(channels: usize, nets: usize, seed: u64) -> Vec<OutputSet<Vec<bool>>> {
+        let mut rng = Xs(seed);
+        let mut out = vec![];
+        for _ in 0..nets {
+            let mut set = OutputSet::all_values(channels);
+            out.push(set.clone());
+            for _ in 0..(channels * 3) {
+                let i = (rng.next() as usize) % channels;
+                let j = (rng.next() as usize) % channels;
+                if i == j {
+                    continue;
+                }
+                let hi = i.max(j);
+                let lo = i.min(j);
+                if set.apply_comparator([hi, lo]) {
+                    out.push(set.clone());
+                }
+            }
+        }
+        out
+    }
+
+    /// Upstream `channel_pair_abstraction`, kept here as the oracle.
+    fn oracle_pair(set: &OutputSet<Vec<bool>>, i: usize, j: usize) -> [usize; 4] {
+        set.channel_pair_abstraction([i, j])
+    }
+
+    #[test]
+    fn quadrants_match_channel_pair_abstraction() {
+        for channels in 3..=super::MAX_CHANNELS {
+            for set in corpus(channels, 6, 0x1234_5678 + channels as u64) {
+                let packed = PackedSet::from_bitmap(set.as_ref());
+                let counts = PairCounts::from_packed(&packed);
+                assert_eq!(counts.total() as usize, set.len());
+                for i in 0..channels {
+                    for j in 0..channels {
+                        if i == j {
+                            continue;
+                        }
+                        let want = oracle_pair(&set, i, j);
+                        let got = counts.quadrants(i, j);
+                        assert_eq!(
+                            [
+                                got[0] as usize,
+                                got[1] as usize,
+                                got[2] as usize,
+                                got[3] as usize
+                            ],
+                            want,
+                            "channels={} pair=({},{})",
