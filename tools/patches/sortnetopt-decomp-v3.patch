+/// V3-DECOMP-CANON. For each input prefix, reproduces exactly the state
+/// `Search::search` looks up as its root:
+///
+/// ```ignore
+/// let mut initial = OutputSet::all_values(opt.channels);
+/// for pair in opt.prefix.chunks(2) {
+///     initial.apply_comparator([pair[0], pair[1]]);
+/// }
+/// // (this is `cmd_search`'s own prefix-application loop, verbatim)
+/// initial.canonicalize(true);
+/// // `Search::search` then does `search.states.get(initial.as_ref())`, and
+/// // `StateMap::get`/`set` key exclusively on `output_set.packed_pvec()` of
+/// // exactly that canonicalised set (src/search/states.rs) -- no further
+/// // reduction (forced-channel pruning only ever applies to *descendants*
+/// // inside `Search::improve`, never to the literal root). So
+/// // `canonicalize(true)` followed by `packed_pvec()` is precisely the memo
+/// // key the search would use for this prefix's root.
+/// ```
+///
+/// This performs no search: no thread pool, no stats thread, no `StateMap`,
+/// no `instrument::init()`. It is therefore fast (no 10 s wall floor) and
+/// cannot perturb anything `search` touches.
+fn cmd_canon_key(opt: OptCanonKey) {
+    log::info!("options: {:?}", opt);
+
+    assert!(
+        opt.channels <= MAX_CHANNELS,
+        "this build supports at most {} channels (requested {}); \
+         rebuild with `--features wide12` or `--features wide13`",
+        MAX_CHANNELS,
+        opt.channels
+    );
+
+    let mut prefixes: Vec<String> = Vec::new();
+
+    if let Some(path) = opt.prefix_file.as_ref() {
+        let contents = std::fs::read_to_string(path)
+            .unwrap_or_else(|err| panic!("canon-key: cannot read {}: {}", path.display(), err));
+        for line in contents.lines() {
+            prefixes.push(line.to_owned());
+        }
+    }
+
+    if let Some(prefix) = opt.prefix.as_ref() {
+        prefixes.push(prefix.clone());
+    }
+
+    // Convention documented on `OptCanonKey` and proved in the report: `a-b`
+    // is `apply_comparator([a, b])` verbatim, so `a` gets the pairwise max
+    // and `b` the pairwise min.
+    println!(
+        "# sortnetopt-canon-key/v1 channels={} pair=a-b->apply_comparator([a,b]) \
+         (a=channels[0]=pairwise max, b=channels[1]=pairwise min; empty line/string = empty prefix)",
+        opt.channels
+    );
+
+    for prefix_str in prefixes {
+        let comparators = parse_canon_key_prefix(&prefix_str);
+
+        let mut set = OutputSet::all_values(opt.channels);
+        for [a, b] in comparators {
+            assert!(
+                a < opt.channels && b < opt.channels,
+                "canon-key: prefix {:?} has a channel index out of range for channels={}",
+                prefix_str,
+                opt.channels
+            );
+            assert_ne!(
+                a, b,
+                "canon-key: prefix {:?} has a degenerate pair {}-{}",
+                prefix_str, a, b
+            );
+            set.apply_comparator([a, b]);
+        }
+
+        set.canonicalize(true);
+
+        let packed = set.packed_pvec();
+        let popcount: u32 = packed.iter().map(|byte| byte.count_ones()).sum();
+        let mut key_hex = String::with_capacity(packed.len() * 2);
+        for byte in packed.iter() {
+            key_hex.push_str(&format!("{:02x}", byte));
+        }
+
+        println!("{}\t{}\t{}\t{}", prefix_str, opt.channels, popcount, key_hex);
+    }
+}
+
+/// Parses one `--prefix`/`--prefix-file`-line value: a comma-separated list
+/// of `a-b` pairs, or the empty string/whitespace-only string for the empty
+/// prefix. `a`/`b` become `apply_comparator`'s two arguments in that order --
+/// see `cmd_canon_key`'s doc comment for what that means.
+fn parse_canon_key_prefix(spec: &str) -> Vec<[usize; 2]> {
+    let spec = spec.trim();
+    if spec.is_empty() {
+        return Vec::new();
+    }
+
+    spec.split(',')
+        .map(|pair| {
+            let pair = pair.trim();
+            let mut parts = pair.split('-');
+            let a = parts
+                .next()
+                .unwrap_or_else(|| panic!("canon-key: malformed pair {:?}", pair))
+                .trim()
+                .parse::<usize>()
+                .unwrap_or_else(|err| panic!("canon-key: bad channel in {:?}: {}", pair, err));
+            let b = parts
+                .next()
+                .unwrap_or_else(|| panic!("canon-key: malformed pair {:?} (expected a-b)", pair))
+                .trim()
+                .parse::<usize>()
+                .unwrap_or_else(|err| panic!("canon-key: bad channel in {:?}: {}", pair, err));
+            assert!(
+                parts.next().is_none(),
+                "canon-key: malformed pair {:?} (too many '-')",
+                pair
+            );
+            [a, b]
+        })
+        .collect()
 }
