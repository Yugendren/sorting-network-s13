+/// Tier-2a Change E: per-thread accumulator for the `Subsume` diagnostic
+/// counters (`instrument::SUBSUME_CALLS`, `..._NODES`, `..._FILTER_MATCHING`,
+/// `..._ABSTRACTIONS`, `..._D0_CACHE_HITS`, `..._D0_CACHE_MISSES`,
+/// `..._FILTER_FAIL`).
+///
+/// `Drop for Subsume` used to flush its diagnostic fields straight into
+/// those `AtomicU64`s (one contended `fetch_add` each, ~280ns measured on
+/// this hardware, across the ~3.9M exact tests a search runs) -- see
+/// `instrument::Batch`'s doc comment for the measured cost this caused.
+/// `LocalBatch` instead accumulates counts into a plain `instrument::Batch`
+/// (lock-free field adds, see `note_subsume_counts`) and only checks in with
+/// the wider process every [`FLUSH_EVERY`] calls, via `shared`: an
+/// `Arc<Mutex<instrument::Batch>>` this thread registered once with
+/// `instrument::register_batch()`. Locking `shared` is a lock/unlock of a
+/// handle only this thread normally touches (the only other locker is
+/// `instrument::drain_all_batches`, which runs once, at `report` time), so
+/// it is cheap and, crucially, not cross-thread-contended the way the
+/// atomics were.
+struct LocalBatch {
+    counts: instrument::Batch,
+    shared: Arc<Mutex<instrument::Batch>>,
+}
+
+impl LocalBatch {
+    fn new() -> Self {
+        Self {
+            counts: instrument::Batch::default(),
+            shared: instrument::register_batch(),
+        }
+    }
+
+    /// Folds `counts` into `shared` and zeroes `counts`.
+    fn flush(&mut self) {
+        let mut shared = self.shared.lock().unwrap();
+        shared.calls += self.counts.calls;
+        shared.nodes += self.counts.nodes;
+        shared.filter_matching += self.counts.filter_matching;
+        shared.abstractions += self.counts.abstractions;
+        shared.d0_hits += self.counts.d0_hits;
+        shared.d0_misses += self.counts.d0_misses;
+        shared.filter_fail += self.counts.filter_fail;
+        self.counts = instrument::Batch::default();
+    }
+}
+
+impl Drop for LocalBatch {
+    fn drop(&mut self) {
+        // A joined thread's thread-local destructors run at thread exit, so
+        // this flushes whatever is left uncommitted rather than losing it.
+        // Rayon's *global* thread pool (used by `-m prune-all` / `-m
+        // gen-proof`) parks and kills its workers instead of joining them,
+        // so this never fires for those threads -- but any count that
+        // already crossed a `FLUSH_EVERY` boundary was checked into `shared`
+        // long before thread exit, and `instrument::drain_all_batches` can
+        // recover `shared` from any thread regardless of whether this ever
+        // runs. Only a same-thread remainder smaller than `FLUSH_EVERY`,
+        // pending at the moment such a worker is parked forever, can still
+        // be lost; see `instrument::BATCH_REGISTRY`'s doc comment.
+        self.flush();
+    }
+}
+
+/// Number of `Subsume` lifetimes' worth of counts a thread accumulates
+/// locally before paying one lock/unlock of its shared handle to check them
+/// in (see `LocalBatch`). Chosen so that cost is negligible next to the
+/// ~1,126ns a bare exact test itself takes.
+const FLUSH_EVERY: u32 = 1024;
+
+thread_local! {
+    static BATCH: RefCell<LocalBatch> = RefCell::new(LocalBatch::new());
+}
+
+/// Adds one `Subsume` instance's worth of diagnostic counts into this
