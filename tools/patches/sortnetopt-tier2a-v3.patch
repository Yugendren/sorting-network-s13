+/// Tier-2a Change B: thread-local cache of the *fully materialized* set of
+/// per-channel `low_channels == 0` (depth-0) abstractions for a `PackedSet`.
+///
+/// At `fixed_channels == 0` the working sets have not been permuted yet, so a
+/// side's `channels` depth-0 abstractions are a pure function of that side's
+/// `PackedSet` (channel count + bitmap). In the real workload one side of a
+/// `Subsume` pair is typically a fixed query reused across many consecutive
+/// exact tests (see `output_set::index::test_precise_packed` /
+/// `test_precise_packed_update`), so recomputing that side's abstractions
+/// from scratch on every call is pure waste. This cache closes that gap.
+///
+/// Capped at [`DEPTH0_SLOTS`] entries, round-robin eviction. Lookups only
+/// ever hand back a value that a full computation would have produced --
+/// this changes no answer, only how often the underlying (deterministic)
+/// computation is repeated.
+struct Depth0Cache {
+    /// `channels` this cache's `slots` were built for; a mismatch means the
+    /// whole cache is stale (a different search width is running on this
+    /// thread) and must be cleared before use.
+    channels: usize,
+    /// `(key, key_len, abstractions)` triples, capped at `DEPTH0_SLOTS`.
+    /// `key[..key_len]` is the set's live `u64` words (the rest of `key` is
+    /// unused padding, never read); `abstractions` is the `channels`-many
+    /// per-channel depth-0 abstractions laid out contiguously (channel `c`
+    /// at offset `c * abstraction_len(0)`).
+    slots: Vec<([u64; MAX_WORDS], usize, Rc<Vec<usize>>)>,
+    /// Round-robin victim index once `slots.len() == DEPTH0_SLOTS`.
+    next: usize,
+}
+
+/// Fixed cache capacity for [`Depth0Cache`]; kept as a named constant so it
+/// is easy to sweep during evaluation.
+const DEPTH0_SLOTS: usize = 4;
+
+impl Depth0Cache {
+    fn new() -> Self {
+        Self {
+            channels: usize::MAX,
+            slots: Vec::new(),
+            next: 0,
+        }
+    }
+
+    /// Clears the cache if it was built for a different `channels` count.
+    fn ensure_channels(&mut self, channels: usize) {
+        if self.channels != channels {
+            self.channels = channels;
+            self.slots.clear();
+            self.next = 0;
+        }
+    }
+
+    /// Key-comparison-only lookup (no abstraction computation, and -- unlike
+    /// the pre-optimization version -- no 256-byte zero-padded key
+    /// materialization either). `bits` is the set's live `u64` words
+    /// (`PackedSet::bits()`) taken directly; each stored key is compared
+    /// against it by slicing to the stored key's own live length, so a
+    /// mismatched length is simply never equal (and in practice never
+    /// occurs within one `ensure_channels` epoch, since `bits().len()` is a
+    /// pure function of `channels`). Clears the cache first if it is stale
+    /// for `channels`.
+    fn probe(&mut self, channels: usize, bits: &[u64]) -> Option<Rc<Vec<usize>>> {
+        self.ensure_channels(channels);
+        self.slots
+            .iter()
+            .find(|(key, len, _)| &key[..*len] == bits)
+            .map(|(_, _, v)| Rc::clone(v))
+    }
+
+    /// Inserts `bits` (the set's live `u64` words) as the key for `value`.
+    /// This is the only place a full `[u64; MAX_WORDS]` key is
+    /// materialized (zero-padded), since it is the only place one needs to
+    /// be stored.
+    fn insert(&mut self, channels: usize, bits: &[u64], value: Rc<Vec<usize>>) {
+        self.ensure_channels(channels);
+        let mut key = [0u64; MAX_WORDS];
+        let len = bits.len();
+        key[..len].copy_from_slice(bits);
+        if self.slots.len() < DEPTH0_SLOTS {
+            self.slots.push((key, len, value));
+        } else {
+            self.slots[self.next] = (key, len, value);
+            self.next = (self.next + 1) % DEPTH0_SLOTS;
+        }
+    }
+}
+
+thread_local! {
+    static DEPTH0_CACHE: RefCell<Depth0Cache> = RefCell::new(Depth0Cache::new());
+}
