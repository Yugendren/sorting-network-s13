+/// Called once from `Search::search`, immediately after the main loop returns
+/// and while the pool is still alive.
+pub fn record_pool_search_phase(park_ns: u64, wall_ns: u64) {
+    POOL_SEARCH_PARK_NS.store(park_ns, Relaxed);
+    POOL_SEARCH_WALL_NS.store(wall_ns, Relaxed);
+}
