+    /// Semantic cross-check tying `hist_subsumes`/`hist_subsumes_inverted`/
+    /// `histogram_signature` to `OutputSet::subsumes_permuted` on real
+    /// `OutputSet`s.
+    ///
+    /// Pairs are generated so a decent number of them are *genuine*
+    /// subsumptions, via two constructions that are guaranteed hits:
+    ///   - direct: `A = perm(S)`, `B = S`, so `A.subsumes_permuted(B)` holds
+    ///     via the inverse permutation (`pi(A) == B` exactly).
+    ///   - inverted: `A = perm(invert(S))`, `B = S`. Since `invert` and
+    ///     `swap_channels` commute (both act on independent "aspects" -- bit
+    ///     value complementation vs. bit position permutation -- of the
+    ///     bitmap index), `invert(A) == perm(invert(invert(S))) ==
+    ///     perm(S)`, so `invert(A).subsumes_permuted(B)` holds via the
+    ///     inverse permutation, same as the direct case.
+    /// Every pair (including these two, plus general pool pairs and pairs
+    /// derived by applying an extra comparator to a second copy) is also
+    /// run through the one-sided implication check unconditionally, so a
+    /// failing implication is always caught even for pairs that don't hit
+    /// either guaranteed-subsumption construction.
+    #[test]
+    fn hist_subsumes_and_signature_match_real_subsumes_permuted() {
+        for channels in 1..=MAX_CHANNELS {
+            let pool = build_sets(channels, 0x1357_9BDF ^ (channels as u64), 6);
+            let mut rng = Xorshift64::new(0x2468_ACE0 ^ (channels as u64));
+
+            let hist_of = |os: &OutputSet<Vec<bool>>| -> WVec<u32> {
+                PackedSet::from_bitmap(os.as_ref()).weight_histogram()
+            };
+
+            let random_perm = |os: &OutputSet<Vec<bool>>,
+                                rng: &mut Xorshift64|
+             -> OutputSet<Vec<bool>> {
+                let mut result = os.clone();
+                for _ in 0..5 {
+                    if let Some(pair) = rng.pair(channels) {
+                        result.swap_channels(pair);
+                    }
+                }
+                result
+            };
+
+            let check_direct = |x: &OutputSet<Vec<bool>>, y: &OutputSet<Vec<bool>>| -> bool {
+                let hit = x.subsumes_permuted(y.as_ref()).is_some();
+                if hit {
+                    let hist_x = hist_of(x);
+                    let hist_y = hist_of(y);
+                    assert!(hist_subsumes(&hist_x, &hist_y));
+                    let sig_x = histogram_signature(channels, &hist_x);
+                    let sig_y = histogram_signature(channels, &hist_y);
+                    assert_eq!(sig_x & !sig_y, 0);
+                }
+                hit
+            };
+
+            let check_inverted = |x: &OutputSet<Vec<bool>>, y: &OutputSet<Vec<bool>>| -> bool {
+                let mut x_inv = x.clone();
+                x_inv.invert();
+                let hit = x_inv.subsumes_permuted(y.as_ref()).is_some();
+                if hit {
+                    let hist_x = hist_of(x);
+                    let hist_y = hist_of(y);
+                    assert!(hist_subsumes_inverted(&hist_x, &hist_y));
+                    let sig_y = histogram_signature(channels, &hist_y);
+                    let sig_rev_x = histogram_signature(channels, &reverse_histogram(&hist_x));
+                    assert_eq!(sig_rev_x & !sig_y, 0);
+                }
+                hit
+            };
+
+            let mut saw_direct_hit = false;
+            let mut saw_inverted_hit = false;
+
+            for s in &pool {
+                // Guaranteed direct hit.
+                let a = random_perm(s, &mut rng);
+                let b = s.clone();
+                saw_direct_hit |= check_direct(&a, &b);
+
+                // Guaranteed inverted hit.
+                let mut base = s.clone();
+                base.invert();
+                let a_inv_source = random_perm(&base, &mut rng);
+                let b2 = s.clone();
+                saw_inverted_hit |= check_inverted(&a_inv_source, &b2);
+
+                // General pairs, including one derived from applying an
+                // extra comparator to a second copy: checked
+                // unconditionally (the check itself is conditional on the
+                // subsumption actually being found), for extra coverage
+                // beyond the two guaranteed constructions above.
+                let mut extra = s.clone();
+                if let Some(pair) = rng.pair(channels) {
+                    extra.apply_comparator(pair);
+                }
+                for (x, y) in [(s, &extra), (&extra, s)] {
+                    saw_direct_hit |= check_direct(x, y);
+                    saw_inverted_hit |= check_inverted(x, y);
+                }
+
+                for other in &pool {
+                    saw_direct_hit |= check_direct(s, other);
+                    saw_inverted_hit |= check_inverted(s, other);
+                }
+            }
+
+            assert!(
+                saw_direct_hit,
+                "channels={}: no direct subsumption hit generated",
+                channels
+            );
+            assert!(
+                saw_inverted_hit,
+                "channels={}: no inverted subsumption hit generated",
+                channels
+            );
+        }
+    }
+}
