+// --- Objective 1: shell instrumentation (`SORTNETOPT_SHELL_STATS`) ----------
+//
+// A state's *shell* is the pair `(width, popcount)` where `width` is the
+// `channels` field carried out-of-band and `popcount = |X|` is the number of
+// set bits in the packed key (exact: `packed_len_for_channels(k) = 2^(k-3)`
+// bytes with no padding bits, so `popcount(packed) == |X|`).
+// `docs/lowmem-endgame-assessment.md` §7.1 measures `(width, |X|)` as a
+// topological quasi-order on the DP DAG: every edge goes to a strictly
+// smaller shell except a measured 4-7% of comparator edges (after channel
+// pruning) that stay in the same shell. Those ties are what force an inner
+// fixpoint in a shell-bucketed external memo (§7); the counters here turn
+// that "k-pass merge" indication into a number instead of leaving it a
+// property only visible in an offline dump.
+//
+// Entirely OFF by default and behaviour-preserving when off: every branch
+// that touches a popcount or the census below is gated by
+// [`shell_stats_enabled`], a single `OnceLock<bool>` read cached at first
+// use (the same idiom as `output_set::index`'s `env_flag_default_on`
+// family). With the flag unset, no popcount is ever computed, the
+// `ShellCensus` table is never allocated, and every counter registered in
+// `counter_lines_core` below reads 0.
+//
+// Chain measurement: exact, not approximate. `Search::improve`'s successor
+// expansion is async but *not* a work-stealing pool where a task's parent is
+// statically unknown -- `search::Edges::add_edge` builds one `EdgeTarget` per
+// distinct successor and `Edges::improve_next` is the only place that spawns
+// `Search::improve_boxed` for it, so the edge that produced a given
+// recursive call is always in hand at the call site. A `same_shell_run: u32`
+// argument is threaded through `improve` / `improve_boxed` / `EdgeTarget`
+// (`parent_run + 1` on a same-shell comparator edge, `0` on every other
+// edge kind, including every extremal-channel-pruning edge, which always
+// drops width and therefore always breaks a chain) and `fetch_max`'d into
+// [`SAME_SHELL_CHAIN_MAX`] at the point each edge is examined. This is exact
+// over the real DAG traversal actually performed by the run, not a sampled
+// or per-thread approximation.
+
+fn shell_stats_env_flag(name: &str) -> bool {
+    match std::env::var(name) {
+        Ok(val) => {
+            let val = val.trim().to_ascii_lowercase();
+            val == "1" || val == "true" || val == "yes"
+        }
+        Err(_) => false,
+    }
+}
+
+static SHELL_STATS: OnceLock<bool> = OnceLock::new();
+
+/// Whether `SORTNETOPT_SHELL_STATS` is enabled, read from the environment
+/// exactly once (subsequent calls hit the cached `OnceLock`). Default OFF.
 #[inline]
+pub fn shell_stats_enabled() -> bool {
+    *SHELL_STATS.get_or_init(|| shell_stats_env_flag("SORTNETOPT_SHELL_STATS"))
+}
