+// --- Tier-2a Change E: thread-local batching for the Subsume counters -------
+//
+// `Subsume` is constructed and dropped once per exact subsumption test --
+// about 3.9 million times per n=10 search, across 10 threads. Flushing each
+// instance's diagnostic fields straight into `SUBSUME_CALLS` /
+// `SUBSUME_NODES` / ... via `fetch_add` (as TIER1 / early Tier-2a did) means
+// every exact test pays for a *contended* atomic RMW (all 10 threads bounce
+// the same cache lines): measured at roughly 280ns per op on this hardware,
+// which alone accounted for a measured 13% search-wall regression between
+// Tier-1 and Tier-2a with all Tier-2a gates disabled. `Batch` lets a thread
+// accumulate many `Subsume` lifetimes' worth of counts locally (plain field
+// adds, no atomics, no cross-thread traffic) and pay the real `fetch_add`s
+// only once every [`FLUSH_EVERY`]-ish calls (see `output_set::subsume`'s
+// thread-local usage of this type).
+#[derive(Clone, Default)]
+pub struct Batch {
+    pub calls: u64,
+    pub nodes: u64,
+    pub filter_matching: u64,
+    pub abstractions: u64,
+    pub d0_hits: u64,
+    pub d0_misses: u64,
+    pub filter_fail: u64,
+    pub since_flush: u32,
+}
+
+/// Flushes one batch's worth of accumulated counts into the real
+/// `SUBSUME_*` atomics (one `fetch_add` per nonzero field, via [`add`]) and
+/// zeroes `b` in place.
+pub fn flush_batch(b: &mut Batch) {
+    add(&SUBSUME_CALLS, b.calls);
+    add(&SUBSUME_NODES, b.nodes);
+    add(&SUBSUME_FILTER_MATCHING, b.filter_matching);
+    add(&SUBSUME_ABSTRACTIONS, b.abstractions);
+    add(&SUBSUME_D0_CACHE_HITS, b.d0_hits);
+    add(&SUBSUME_D0_CACHE_MISSES, b.d0_misses);
+    add(&SUBSUME_FILTER_FAIL, b.filter_fail);
+    *b = Batch::default();
+}
+
+/// Every thread's shared batch handle, registered once (on first use) via
+/// [`register_batch`]. Exists purely as a safety net: `-m prune-all` and
+/// `-m gen-proof` drive work through rayon's *global* thread pool, whose
+/// worker threads are parked and eventually killed rather than joined at
+/// process exit, so thread-local destructors never run for them and any
+/// unflushed remainder sitting in a thread-local batch would otherwise be
+/// silently lost. Every entry here is periodically folded into the shared
+/// handle by its owning thread (see `output_set::subsume`), so
+/// [`drain_all_batches`] can recover it from any thread, at any time,
+/// without needing that owning thread to have exited cleanly.
+static BATCH_REGISTRY: Mutex<Vec<Arc<Mutex<Batch>>>> = Mutex::new(Vec::new());
+
+/// Registers a new shared batch handle for the calling thread and returns it.
+/// Call once per thread (e.g. from a thread-local's initializer).
+pub fn register_batch() -> Arc<Mutex<Batch>> {
+    let handle = Arc::new(Mutex::new(Batch::default()));
+    BATCH_REGISTRY.lock().unwrap().push(Arc::clone(&handle));
+    handle
+}
+
+/// Locks every registered shared batch and flushes it into the `SUBSUME_*`
+/// atomics. Called at the start of [`report`] so the final counters include
+/// every thread's most recently checkpointed (but not-yet-atomic) counts.
+/// Safe to call more than once: a drained batch is left at zero, so a
+/// repeat call folds in nothing new.
+pub fn drain_all_batches() {
+    let registry = BATCH_REGISTRY.lock().unwrap();
+    for handle in registry.iter() {
+        let mut batch = handle.lock().unwrap();
+        flush_batch(&mut batch);
+    }
+}
