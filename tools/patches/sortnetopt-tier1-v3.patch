+    /// Applies a `Subsume::search`-convention permutation to `set`.
+    ///
+    /// Convention, derived from `Subsume::rollback`'s `UndoAction::Swap` arm
+    /// (`output_set.swap_channels([target_channel, source_channel]);
+    /// perm.swap(target_channel, source_channel);`, i.e. every
+    /// `swap_channels` call on the working copy is mirrored by the same
+    /// `swap` on `perms[side]`) composed with `search`'s final
+    /// `perm[self.perms[1][i]] = self.perms[0][i]`: the returned `perm`
+    /// satisfies `perm[d] = perms0[perms1^-1[d]]`, and unwinding the
+    /// `perms[side]` invariant (`currentSet.bitmap[index] ==
+    /// originalSet.bitmap[map(index)]` where `map` relocates bit `c` of
+    /// `index` to bit `perms[side][c]`) shows that `perm` is exactly the
+    /// channel relabeling under which `originalSet0` permuted by `perm` (in
+    /// the sense implemented here) subsumes (unpermuted) `originalSet1`.
+    ///
+    /// Concretely: `result.bitmap[index] = set.bitmap[map(index)]` where
+    /// `map(index)` moves bit `d` of `index` to bit `perm[d]` of `map(index)`.
+    fn apply_perm_convention(set: &OutputSet<Vec<bool>>, perm: &[usize]) -> OutputSet<Vec<bool>> {
+        let channels = set.channels();
+        assert_eq!(perm.len(), channels);
+        let bitmap = set.bitmap();
+        let size = 1usize << channels;
+        let mut result = vec![false; size];
+        for (index, slot) in result.iter_mut().enumerate() {
+            let mut mapped = 0usize;
+            for d in 0..channels {
+                if index & (1 << d) != 0 {
+                    mapped |= 1 << perm[d];
+                }
+            }
+            *slot = bitmap[mapped];
+        }
