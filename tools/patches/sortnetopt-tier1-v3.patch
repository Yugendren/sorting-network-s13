+    struct Xorshift64(u64);
+
+    impl Xorshift64 {
+        fn new(seed: u64) -> Self {
+            Self(seed | 1)
+        }
+
+        fn next(&mut self) -> u64 {
+            let mut x = self.0;
+            x ^= x << 13;
+            x ^= x >> 7;
+            x ^= x << 17;
+            self.0 = x;
+            x
+        }
+
+        fn below(&mut self, bound: usize) -> usize {
+            (self.next() % bound as u64) as usize
+        }
+
+        fn pair(&mut self, k: usize) -> Option<[usize; 2]> {
+            if k < 2 {
+                return None;
+            }
+            let a = self.below(k);
+            let mut b = self.below(k);
+            while b == a {
+                b = self.below(k);
+            }
+            Some([a, b])
+        }
+    }
+
+    fn random_chain(channels: usize, rng: &mut Xorshift64, steps: usize) -> OutputSet<Vec<bool>> {
+        let mut current = OutputSet::all_values(channels);
+        for _ in 0..steps {
+            if let Some(pair) = rng.pair(channels) {
+                current.apply_comparator(pair);
+            }
+        }
+        current
+    }
