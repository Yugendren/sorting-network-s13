+/// child (`parent_run + 1` if this edge stayed in the same shell, `0`
+/// otherwise), per [`SAME_SHELL_CHAIN_MAX`]'s doc comment.
+pub fn record_shell_edge(
+    parent_width: usize,
+    parent_popcount: usize,
+    child_width: usize,
+    child_popcount: usize,
+    parent_run: u32,
