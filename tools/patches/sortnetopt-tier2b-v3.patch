+            let from_bytes = SubsumeFilter::from_packed_bytes(channels, &set.packed());
+            assert_eq!(from_bitmap.sig, from_bytes.sig);
+            assert_eq!(from_bitmap.sig_rev, from_bytes.sig_rev);
+            assert_eq!(from_bitmap.hist, from_bytes.hist);
+        }
+    }
+}
