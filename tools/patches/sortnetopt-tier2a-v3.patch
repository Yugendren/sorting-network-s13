+impl std::ops::Deref for InnerAbs {
+    type Target = [usize];
+
+    fn deref(&self) -> &[usize] {
+        match self {
+            InnerAbs::Cached(rc) => &rc[..],
+            InnerAbs::Owned(buf) => &buf[..],
