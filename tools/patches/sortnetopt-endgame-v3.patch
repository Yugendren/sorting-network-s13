+}
+
+/// THEOREM E1. `set` must satisfy `state.bounds[1] == 1` and be unsorted at
+/// the call site (both preconditions are the caller's responsibility to
+/// check; this function does not re-check them, mirroring
+/// `verify_endgame.py::f_bound1_unique`'s use of its `b` argument only as a
+/// precondition gate).
+///
+/// Groups `set`'s vectors by Hamming weight. Returns `Some([i, j])` (engine
+/// convention: `i > j`, matching how `Search::improve`'s `i in 0..channels,
+/// j in 0..i` double loop enumerates pairs -- MIN always goes to the
+/// lower-indexed channel) for the unique comparator that sorts `set`, or
+/// `None` if the structural precondition the theorem requires does not
+/// actually hold (every weight class of size `<= 2`, all size-2 classes
+/// differing in exactly one, common, channel pair): a weight class bigger
+/// than 2, a size-2 class whose two vectors differ in something other than
+/// exactly 2 channels, or two size-2 classes disagreeing on which pair they
+/// differ in, are all `None`. `None` proves `bound(X) >= 2`, contradicting
+/// the `state.bounds[1] == 1` precondition, so in a correct caller this is
+/// only ever a defensive case (see the module doc comment's fallback note).
+pub fn bound1_unique_pair(set: OutputSet<&[bool]>) -> Option<[usize; 2]> {
+    let channels = set.channels();
+    let bitmap = set.bitmap();
+
+    let mut first: WVec<Option<usize>> = repeat(None).take(channels + 1).collect();
+    let mut second: WVec<Option<usize>> = repeat(None).take(channels + 1).collect();
+
+    for (index, &present) in bitmap.iter().enumerate() {
+        if !present {
+            continue;
+        }
+        let weight = index.count_ones() as usize;
+        if first[weight].is_none() {
+            first[weight] = Some(index);
+        } else if second[weight].is_none() {
+            second[weight] = Some(index);
+        } else {
+            // Weight class of size > 2.
+            return None;
+        }
+    }
+
+    let mut pair: Option<[usize; 2]> = None;
+
+    for weight in 0..=channels {
+        if let (Some(u), Some(v)) = (first[weight], second[weight]) {
+            let diff = u ^ v;
+            if diff.count_ones() != 2 {
+                return None;
+            }
+            let mut bits = [0usize; 2];
+            let mut found = 0;
+            for c in 0..channels {
+                if diff & (1 << c) != 0 {
+                    bits[found] = c;
+                    found += 1;
+                }
+            }
+            // `c` ascends, so `bits[0] < bits[1]`; the engine convention is
+            // `[i, j]` with `i > j` (MIN to the lower-indexed channel).
+            let candidate = [bits[1], bits[0]];
+            match pair {
+                None => pair = Some(candidate),
+                Some(existing) if existing == candidate => {}
+                Some(_) => return None,
+            }
+        }
+    }
+
+    pair
+}
+
+/// THEOREM E2. `target` is a successor set (post-`apply_comparator`,
+/// pre-`canonicalize`); `b` is the *parent's* stored upper bound (not
+/// `target`'s). A comparator is at most 2-to-1 within a Hamming weight
+/// class, so `bound(target) >= ceil(log2 max_l |target_l|)`; since any
+/// optimal successor has `bound(target) <= b - 1`, `target` can only be
+/// optimal if `max_l |target_l| <= 2^(b-1)`.
+///
+/// Returns `true` (no rejection) once `b - 1 >= 31`, since `1 << 31` already
+/// exceeds every weight-class size this engine can ever produce
+/// (`MAX_CHANNELS <= 13`, so a class has at most `2^13` vectors) -- the gate
+/// in `search.rs` (`b <= budget_cap()`, default 4) already keeps `b` far
+/// below this, so the check is dead weight kept only as a defensive cap
+/// against a future `SORTNETOPT_ENDGAME_BUDGET` misconfiguration.
+pub fn halving_ok(target: OutputSet<&[bool]>, b: u8) -> bool {
+    if b == 0 {
+        return true;
+    }
+    let shift = (b - 1) as u32;
+    if shift >= 31 {
+        return true;
+    }
+    let cap = 1usize << shift;
+    target
+        .weight_histogram()
+        .iter()
+        .all(|&count| count <= cap)
+}
+
+/// The *live support* `L(Z)`: the bitmask of channels on which two vectors
+/// of equal Hamming weight in `Z` disagree. See the module doc comment for
+/// the proof that `bound(Z) >= ceil(|L(Z)| / 2)`.
+///
+/// Computed in one pass over the bitmap: for each Hamming weight `l`, let
+/// `or_l` / `and_l` be the bitwise OR / AND of every present vector of
+/// weight `l` (as a `channels`-bit value); `L(Z) = OR_l (or_l & !and_l)`.
+/// A weight class with 0 or 1 members contributes nothing (`or_l` is either
+/// `0`, or equal to `and_l`, in both cases `or_l & !and_l == 0`), matching
+/// the definition ("two vectors ... that disagree").
+pub fn live_support(target: OutputSet<&[bool]>) -> usize {
+    let channels = target.channels();
+    let all_mask = if channels == 0 {
+        0
+    } else {
+        (1usize << channels) - 1
+    };
+
+    let mut or_l: WVec<usize> = repeat(0usize).take(channels + 1).collect();
+    let mut and_l: WVec<usize> = repeat(all_mask).take(channels + 1).collect();
+
+    for (index, &present) in target.bitmap().iter().enumerate() {
+        if !present {
+            continue;
+        }
+        let weight = index.count_ones() as usize;
+        or_l[weight] |= index;
+        and_l[weight] &= index;
+    }
+
+    let mut live_mask = 0usize;
+    for weight in 0..=channels {
+        live_mask |= or_l[weight] & !and_l[weight];
+    }
+
+    (live_mask & all_mask).count_ones() as usize
+}
+
+/// THEOREM E4 (as a filter, using [`live_support`]). `target` is a successor
+/// set (post-`apply_comparator`, pre-`canonicalize`); `b` is the *parent's*
+/// stored upper bound. `target` can only be optimal if
+/// `|L(target)| <= 2 * (b - 1)` -- each comparator of an optimal
+/// `(b - 1)`-comparator network for `target` clears at most 2 channels from
+/// its live support.
+pub fn live_budget_ok(target: OutputSet<&[bool]>, b: u8) -> bool {
+    if b == 0 {
+        return true;
+    }
+    let limit = 2 * (b as usize - 1);
+    live_support(target) <= limit
+}
