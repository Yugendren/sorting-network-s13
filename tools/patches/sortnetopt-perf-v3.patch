+                let output_set = OutputSet::from_packed(channels, packed);
+
+                index.insert_new_unchecked_with_abstraction(
+                    output_set.as_ref(),
+                    &output_set.abstraction(),
+                    bounds[g],
+                );
+
+                survivors_by_group[g].push(i);
+            }
+        }
+
+        let mut total_survivors = 0usize;
+
+        for (g, group) in groups.iter().enumerate() {
+            let output_path = input.join(&group.name).with_extension("pbin");
+            let output_tmp_path = input.join(&group.name).with_extension("tmp");
+            let mut output_file = BufWriter::new(File::create(&output_tmp_path).unwrap());
+
+            for &i in &survivors_by_group[g] {
+                output_file
+                    .write_all(packed_output_sets[g].get_packed(i))
+                    .unwrap();
+            }
+
+            total_survivors += survivors_by_group[g].len();
+
+            drop(output_file);
+            fs::rename(output_tmp_path, output_path).unwrap();
+        }
+
+        log::info!(
+            "{} channels: {} input records, {} survivors",
+            channels,
+            total_input_len,
+            total_survivors
+        );
     }
 }
