+    /// Write a small synthetic checkpoint and read it back into a fresh map.
+    #[test]
+    fn round_trip_states() {
+        let dir = scratch_dir("roundtrip");
+
+        let channels = 6;
+        let mut root = OutputSet::all_values(channels);
+        root.canonicalize(true);
+
+        let written = StateMap::new(channels);
+
+        // A handful of genuinely reachable output sets at three widths.
+        let mut expected = vec![];
+        for (i, j) in [(1usize, 0usize), (2, 0), (3, 1), (4, 2), (5, 3)].iter() {
+            let mut set = OutputSet::all_values(channels);
+            set.apply_comparator([*i, *j]);
+            set.canonicalize(true);
+            let state = State {
+                bounds: [*i as u8 + 1, *i as u8 + 7],
+                huffman_bounds: [*i as u8 + 1, *i as u8 + 7],
+            };
+            written.set(set.as_ref(), state);
+            expected.push(set);
+        }
+        for k in 3..=5 {
+            let mut set = OutputSet::all_values(k);
+            set.apply_comparator([1, 0]);
+            set.canonicalize(true);
+            let state = State {
+                bounds: [1, k as u8],
+                huffman_bounds: [1, k as u8],
+            };
+            written.set(set.as_ref(), state);
+            expected.push(set);
+        }
+
+        // Several of the comparators above canonicalise to the same set, so the
+        // authority on what should come back is the map itself, not the states
+        // that were handed to `set`.
+        let expected = expected
+            .into_iter()
+            .map(|set| {
+                let state = written.get(set.as_ref());
+                (set, state)
+            })
+            .collect::<Vec<_>>();
+
+        let writer =
+            Checkpointer::new_at(dir.clone(), false, &written, root.as_ref(), Some(29), &[1, 0])
+                .unwrap();
+        let stats = writer.snapshot().unwrap();
+        assert_eq!(stats.states, written.census().total());
+        assert!(stats.bytes > HEADER_LEN as u64);
+
+        let restored = StateMap::new(channels);
+        let reader =
+            Checkpointer::new_at(dir.clone(), false, &restored, root.as_ref(), Some(29), &[1, 0])
+                .unwrap();
+        let info = reader.restore_from(&writer.path()).unwrap();
+
+        assert_eq!(info.states, stats.states);
+        assert_eq!(info.seq, stats.seq);
+        assert_eq!(restored.census().total(), written.census().total());
+        for (set, state) in expected.iter() {
+            assert_eq!(restored.get(set.as_ref()), *state, "set {:?}", set.packed());
+        }
+
+        // A different channel count must be refused by the identity check.
+        let other = StateMap::new(channels);
+        let mut other_root = OutputSet::all_values(5);
+        other_root.canonicalize(true);
+        let other_reader = Checkpointer::new_at(
+            dir.clone(),
+            false,
+            &other,
+            other_root.as_ref(),
+            Some(29),
+            &[1, 0],
+        )
+        .unwrap();
+        let err = other_reader.restore_from(&writer.path()).unwrap_err();
+        assert!(err.contains("identity mismatch"), "{}", err);
+        assert!(err.contains("channels="), "{}", err);
+
+        // A flipped byte in the body must be caught by the payload hash.
+        let corrupt = dir.join("corrupt.bin");
+        let mut bytes = fs::read(writer.path()).unwrap();
+        let middle = bytes.len() / 2;
+        bytes[middle] ^= 0x01;
+        fs::write(&corrupt, &bytes).unwrap();
+        let err = reader.restore_from(&corrupt).unwrap_err();
+        assert!(err.contains("payload hash mismatch"), "{}", err);
+
+        // A flipped byte in the header must be caught by the header hash first.
+        let corrupt_header = dir.join("corrupt_header.bin");
+        let mut bytes = fs::read(writer.path()).unwrap();
+        bytes[56] ^= 0x01; // seq
+        fs::write(&corrupt_header, &bytes).unwrap();
+        let err = reader.restore_from(&corrupt_header).unwrap_err();
+        assert!(err.contains("header hash mismatch"), "{}", err);
+
+        // A flipped magic byte is caught before anything else.
+        let corrupt_magic = dir.join("corrupt_magic.bin");
+        let mut bytes = fs::read(writer.path()).unwrap();
+        bytes[3] ^= 0x01;
+        fs::write(&corrupt_magic, &bytes).unwrap();
+        let err = reader.restore_from(&corrupt_magic).unwrap_err();
+        assert!(err.contains("bad magic"), "{}", err);
+
+        let _ = fs::remove_dir_all(&dir);
+    }
+
+    /// `restore_entry` must rebuild an index that answers lookups identically
+    /// to the one that was enumerated. This is the piece the states round-trip
+    /// cannot cover without mutating the process environment.
+    #[test]
+    fn round_trip_subsume_index() {
+        let channels = 6;
+        let point_dim = 12;
+
+        let source = ShardedSubsumeIndex::new(channels, point_dim);
+
+        let mut sets = vec![];
+        for i in 1..channels {
+            for j in 0..i {
+                let mut set = OutputSet::all_values(channels);
+                set.apply_comparator([i, j]);
+                set.apply_comparator([(i + 2) % channels, (j + 1) % channels]);
+                set.canonicalize(true);
+                sets.push(set);
+            }
+        }
+
+        for (index, set) in sets.iter().enumerate() {
+            let abstraction = set.abstraction_prefix(source.point_dim());
+            source.insert_collect(set.as_ref(), &abstraction, (index % 7) as u8 + 1, &mut |_| {});
+        }
