+        // incremental `update` path with a buffer boundary that is not a
+        // multiple of the 64-byte block.
+        let mut hasher = Sha256::new();
+        let chunk = vec![b'a'; 1000];
+        for _ in 0..1000 {
+            hasher.update(&chunk);
