+//! Project-owned search instrumentation (Mericanii S(13) programme, M0b).
+//!
+//! Every value recorded here is read from an already-computed result at a point
+//! where no branch depends on it. Nothing in this module is ever consulted by
+//! the search: there is no code path in which a counter influences which output
+//! sets are visited, which bound is derived, or how work is scheduled.
+//!
+//! Cost discipline (docs/sortnetopt-internals.md section 7):
+//!
+//! * hot-path recording is `AtomicU64::fetch_add` with `Ordering::Relaxed`
+//!   only -- no allocation, no locking, no formatting;
+//! * counters are incremented *outside* the `StateMap` shard `RwLock` critical
+//!   sections (the shard guard is a statement temporary that has been dropped
+//!   before `record_*` is called);
+//! * the per-channel-count census walks `BTreeMap::len` (O(1) each) over the
+//!   shards and is only taken from `Search::log_stats`, which already runs on
+//!   its own 10-second task, plus once per bound iteration and once at exit.
+//!
+//! Output is written to stderr (the search's own `log` target is stdout, so the
+//! two never interleave) and, if `SORTNETOPT_INSTRUMENT_JSON` names a path, as
+//! a JSON document at exit.
+
+use std::{
+    fmt::Write as _,
+    sync::{
+        atomic::{AtomicU64, Ordering::Relaxed},
+        Mutex, OnceLock,
+    },
+    time::Instant,
+};
+
+/// One past the largest channel count that gets its own histogram bucket.
+/// `OutputSetMap` currently has arms for 3..=11; the extra headroom is so a
+/// later `MAX_CHANNELS` bump does not silently drop buckets.
+pub const MAX_TRACKED_CHANNELS: usize = 16;
+
+// --- StateMap::get -----------------------------------------------------------
+
+pub static GET_CALLS: AtomicU64 = AtomicU64::new(0);
+pub static GET_HITS: AtomicU64 = AtomicU64::new(0);
+pub static GET_MISSES: AtomicU64 = AtomicU64::new(0);
+
+// --- StateMap::set -----------------------------------------------------------
+
+pub static SET_CALLS: AtomicU64 = AtomicU64::new(0);
+/// `set` calls that created a new key (the whole-run "states inserted" total).
+pub static SET_INSERTS: AtomicU64 = AtomicU64::new(0);
+/// `set` calls that overwrote an existing key (a bound refinement).
+pub static SET_UPDATES: AtomicU64 = AtomicU64::new(0);
+
+// --- per-set async lock ------------------------------------------------------
+
+pub static LOCK_ACQUIRED: AtomicU64 = AtomicU64::new(0);
+pub static LOCK_CONTENDED: AtomicU64 = AtomicU64::new(0);
+
+// --- work generation ---------------------------------------------------------
+
+pub static IMPROVE_CALLS: AtomicU64 = AtomicU64::new(0);
+pub static IMPROVE_HUFFMAN_CALLS: AtomicU64 = AtomicU64::new(0);
+/// Non-redundant comparator successors generated in `Search::improve`.
+pub static SUCCESSORS_GENERATED: AtomicU64 = AtomicU64::new(0);
+/// Forced-channel (van Voorhis) prunings taken in `Search::improve`.
+pub static FORCED_PRUNINGS: AtomicU64 = AtomicU64::new(0);
+/// Extremal-channel prunings generated in `Search::improve_huffman`.
+pub static HUFFMAN_PRUNINGS: AtomicU64 = AtomicU64::new(0);
+
+/// Highest total `StateMap` entry count ever observed by a census.
+pub static PEAK_ENTRIES: AtomicU64 = AtomicU64::new(0);
+
+static INSERTS_BY_CHANNELS: [AtomicU64; MAX_TRACKED_CHANNELS] = [
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+];
+
+static ITERATIONS: Mutex<Vec<BoundIteration>> = Mutex::new(Vec::new());
+static START: OnceLock<Instant> = OnceLock::new();
+
+/// Milliseconds since the first instrumented event.
+fn elapsed_ms() -> u128 {
+    START.get_or_init(Instant::now).elapsed().as_millis()
+}
+
+/// Call once as early as possible so `elapsed_ms` is anchored to process start.
+pub fn init() {
+    let _ = START.get_or_init(Instant::now);
+}
+
+/// Packed key size in bytes for a `channels`-wide output set. Mirrors
+/// `OutputSet::packed_len_for_channels`; duplicated so this module stays a leaf.
+pub fn packed_len_for_channels(channels: usize) -> u64 {
+    ((1u64 << channels) + 7) / 8
+}
+
+#[inline]
+pub fn record_get(hit: bool) {
+    GET_CALLS.fetch_add(1, Relaxed);
+    if hit {
+        GET_HITS.fetch_add(1, Relaxed);
+    } else {
+        GET_MISSES.fetch_add(1, Relaxed);
+    }
+}
+
+#[inline]
+pub fn record_set(channels: usize, newly_inserted: bool) {
+    SET_CALLS.fetch_add(1, Relaxed);
+    if newly_inserted {
+        SET_INSERTS.fetch_add(1, Relaxed);
+        if channels < MAX_TRACKED_CHANNELS {
+            INSERTS_BY_CHANNELS[channels].fetch_add(1, Relaxed);
+        }
+    } else {
+        SET_UPDATES.fetch_add(1, Relaxed);
+    }
+}
+
+#[inline]
+pub fn record_lock(contended: bool) {
+    if contended {
+        LOCK_CONTENDED.fetch_add(1, Relaxed);
+    } else {
+        LOCK_ACQUIRED.fetch_add(1, Relaxed);
+    }
+}
+
+#[inline]
+pub fn bump(counter: &AtomicU64) {
+    counter.fetch_add(1, Relaxed);
+}
+
+/// A per-channel-count population snapshot of the `StateMap`.
+#[derive(Clone, Debug)]
+pub struct Census {
+    pub entries: [u64; MAX_TRACKED_CHANNELS],
+}
+
+impl Default for Census {
+    fn default() -> Self {
+        Census {
+            entries: [0; MAX_TRACKED_CHANNELS],
+        }
+    }
+}
+
+impl Census {
+    pub fn add(&mut self, other: &Census) {
+        for (slot, value) in self.entries.iter_mut().zip(other.entries.iter()) {
+            *slot += value;
+        }
+    }
+
+    pub fn total(&self) -> u64 {
+        self.entries.iter().sum()
+    }
+
+    /// Packed-key bytes held per channel count (`entries[k] * 2^max(0, k-3)`).
+    pub fn bytes(&self) -> [u64; MAX_TRACKED_CHANNELS] {
+        let mut result = [0u64; MAX_TRACKED_CHANNELS];
+        for channels in 0..MAX_TRACKED_CHANNELS {
+            result[channels] = self.entries[channels] * packed_len_for_channels(channels);
+        }
+        result
+    }
+
+    pub fn total_bytes(&self) -> u64 {
+        self.bytes().iter().sum()
+    }
+
+    /// Resident estimate: packed key plus the 4-byte `State`, ignoring B-tree
+    /// node overhead (measured at roughly 1.9x by Harder's n=11 figures).
+    pub fn total_key_plus_state_bytes(&self) -> u64 {
+        (0..MAX_TRACKED_CHANNELS)
+            .map(|channels| self.entries[channels] * (packed_len_for_channels(channels) + 4))
+            .sum()
+    }
+}
+
+/// Record the highest total entry count seen so far. `state_shards` has no
+/// removal path, so in the unmodified search this is monotone and peak == final.
+pub fn note_peak(total: u64) {
+    PEAK_ENTRIES.fetch_max(total, Relaxed);
+}
+
+#[derive(Clone, Debug)]
+pub struct BoundIteration {
+    pub index: usize,
+    pub bounds: [u8; 2],
+    pub huffman_bounds: [u8; 2],
+    pub elapsed_ms: u128,
+    /// Live `StateMap` entries at the end of this iteration.
+    pub states: u64,
+    /// New keys created during this iteration.
+    pub new_states: u64,
+    pub census: Census,
+}
+
+/// Called once per successive-approximation iteration of `Search::search`.
+pub fn record_bound_iteration(bounds: [u8; 2], huffman_bounds: [u8; 2], census: &Census) {
+    let states = census.total();
+    note_peak(states);
+    let inserts = SET_INSERTS.load(Relaxed);
+
+    let mut iterations = ITERATIONS.lock().unwrap();
+    let index = iterations.len();
+    let already: u64 = iterations.iter().map(|it| it.new_states).sum();
+    iterations.push(BoundIteration {
+        index,
+        bounds,
+        huffman_bounds,
+        elapsed_ms: elapsed_ms(),
+        states,
+        new_states: inserts.saturating_sub(already),
+        census: census.clone(),
+    });
+}
+
+fn counter_lines() -> Vec<(&'static str, u64)> {
+    vec![
+        ("get_calls", GET_CALLS.load(Relaxed)),
+        ("get_hits", GET_HITS.load(Relaxed)),
+        ("get_misses", GET_MISSES.load(Relaxed)),
+        ("set_calls", SET_CALLS.load(Relaxed)),
+        ("set_inserts", SET_INSERTS.load(Relaxed)),
+        ("set_updates", SET_UPDATES.load(Relaxed)),
+        ("lock_acquired", LOCK_ACQUIRED.load(Relaxed)),
+        ("lock_contended", LOCK_CONTENDED.load(Relaxed)),
+        ("improve_calls", IMPROVE_CALLS.load(Relaxed)),
+        ("improve_huffman_calls", IMPROVE_HUFFMAN_CALLS.load(Relaxed)),
+        ("successors_generated", SUCCESSORS_GENERATED.load(Relaxed)),
+        ("forced_prunings", FORCED_PRUNINGS.load(Relaxed)),
+        ("huffman_prunings", HUFFMAN_PRUNINGS.load(Relaxed)),
+        ("peak_entries", PEAK_ENTRIES.load(Relaxed)),
+    ]
+}
+
+fn json_u64_map(pairs: &[(usize, u64)]) -> String {
+    let mut out = String::from("{");
+    for (index, (key, value)) in pairs.iter().enumerate() {
+        if index > 0 {
+            out.push_str(", ");
+        }
+        let _ = write!(out, "\"{}\": {}", key, value);
+    }
+    out.push('}');
+    out
+}
+
+/// Final report. Called from `Search::search` after the main loop has closed the
+/// interval and before `dump_states` consumes the map.
+pub fn report(channels: usize, result: usize, final_census: &Census) {
+    note_peak(final_census.total());
+
+    let counters = counter_lines();
+    let inserts_by_channels: Vec<(usize, u64)> = (0..MAX_TRACKED_CHANNELS)
+        .map(|k| (k, INSERTS_BY_CHANNELS[k].load(Relaxed)))
+        .filter(|(_, v)| *v > 0)
+        .collect();
+    let entries: Vec<(usize, u64)> = (0..MAX_TRACKED_CHANNELS)
+        .map(|k| (k, final_census.entries[k]))
+        .filter(|(_, v)| *v > 0)
+        .collect();
+    let bytes_array = final_census.bytes();
+    let bytes: Vec<(usize, u64)> = entries
+        .iter()
+        .map(|(k, _)| (*k, bytes_array[*k]))
+        .collect();
+
+    eprintln!("=== sortnetopt instrumentation (M0b) ===");
+    eprintln!("channels = {}, result = {}", channels, result);
+    for (name, value) in counters.iter() {
+        eprintln!("counter {:<22} {}", name, value);
+    }
+    eprintln!(
+        "statemap total_entries {} packed_key_bytes {} key_plus_state_bytes {}",
+        final_census.total(),
+        final_census.total_bytes(),
+        final_census.total_key_plus_state_bytes()
+    );
+    eprintln!("channels  entries      inserts      packed_bytes  pct_entries  pct_bytes");
+    let total_entries = final_census.total().max(1);
+    let total_bytes = final_census.total_bytes().max(1);
+    for (k, count) in entries.iter() {
+        let ins = INSERTS_BY_CHANNELS[*k].load(Relaxed);
+        eprintln!(
+            "{:>8}  {:>11}  {:>11}  {:>12}  {:>10.3}%  {:>8.3}%",
+            k,
+            count,
+            ins,
+            bytes_array[*k],
+            100.0 * (*count as f64) / (total_entries as f64),
+            100.0 * (bytes_array[*k] as f64) / (total_bytes as f64),
+        );
+    }
+
+    let iterations = ITERATIONS.lock().unwrap();
+    eprintln!("iteration  lower  upper  elapsed_ms  states  new_states");
+    for it in iterations.iter() {
+        eprintln!(
+            "{:>9}  {:>5}  {:>5}  {:>10}  {:>8}  {:>10}",
+            it.index, it.bounds[0], it.bounds[1], it.elapsed_ms, it.states, it.new_states
+        );
+    }
+
+    if let Ok(path) = std::env::var("SORTNETOPT_INSTRUMENT_JSON") {
+        let mut out = String::new();
+        let _ = writeln!(out, "{{");
+        let _ = writeln!(out, "  \"schema\": \"sortnetopt-instrumentation/v3-m0b\",");
+        let _ = writeln!(out, "  \"channels\": {},", channels);
+        let _ = writeln!(out, "  \"result\": {},", result);
+        let _ = writeln!(out, "  \"counters\": {{");
+        for (index, (name, value)) in counters.iter().enumerate() {
+            let comma = if index + 1 == counters.len() { "" } else { "," };
+            let _ = writeln!(out, "    \"{}\": {}{}", name, value, comma);
+        }
+        let _ = writeln!(out, "  }},");
+        let _ = writeln!(
+            out,
+            "  \"statemap\": {{\"total_entries\": {}, \"packed_key_bytes\": {}, \"key_plus_state_bytes\": {}}},",
+            final_census.total(),
+            final_census.total_bytes(),
+            final_census.total_key_plus_state_bytes()
+        );
+        let _ = writeln!(
+            out,
+            "  \"entries_by_channels\": {},",
+            json_u64_map(&entries)
+        );
+        let _ = writeln!(out, "  \"bytes_by_channels\": {},", json_u64_map(&bytes));
+        let _ = writeln!(
+            out,
+            "  \"inserts_by_channels\": {},",
+            json_u64_map(&inserts_by_channels)
+        );
+        let _ = writeln!(out, "  \"bound_iterations\": [");
+        for (index, it) in iterations.iter().enumerate() {
+            let comma = if index + 1 == iterations.len() {
+                ""
+            } else {
+                ","
+            };
+            let census_entries: Vec<(usize, u64)> = (0..MAX_TRACKED_CHANNELS)
+                .map(|k| (k, it.census.entries[k]))
+                .filter(|(_, v)| *v > 0)
+                .collect();
+            let _ = writeln!(
+                out,
+                "    {{\"index\": {}, \"bounds\": [{}, {}], \"huffman_bounds\": [{}, {}], \"elapsed_ms\": {}, \"states\": {}, \"new_states\": {}, \"entries_by_channels\": {}}}{}",
+                it.index,
+                it.bounds[0],
+                it.bounds[1],
+                it.huffman_bounds[0],
+                it.huffman_bounds[1],
+                it.elapsed_ms,
+                it.states,
+                it.new_states,
+                json_u64_map(&census_entries),
+                comma
+            );
+        }
+        let _ = writeln!(out, "  ]");
+        let _ = writeln!(out, "}}");
+
+        match std::fs::write(&path, out) {
+            Ok(()) => eprintln!("instrumentation json written to {}", path),
+            Err(err) => eprintln!("instrumentation json write to {} failed: {}", path, err),
+        }
+    }
+}
