+        }
+        return 0;
+    }
+
+    if child_popcount == parent_popcount {
+        bump(&SUCC_SAME_SHELL);
+        let run = parent_run + 1;
+        SAME_SHELL_CHAIN_MAX.fetch_max(run as u64, Relaxed);
