--- a/src/search/checkpoint.rs	1970-01-01 07:30:00
+++ b/src/search/checkpoint.rs	2026-08-17 22:29:32
@@ -0,0 +1,1415 @@
+//! Tier-2b: durable checkpoint / restart for the `StateMap` search.
+//!
+//! A prior n=11 run was SIGKILLed 4 h 10 m in and lost everything, because the
+//! engine had no durable state (`evidence/v3/n11-attempt1-oom.md`). This module
+//! adds one, and nothing else: it never influences which output sets are
+//! visited or which bound is derived.
+//!
+//! # What is captured, and what is not
+//!
+//! 1. The `StateMap` memo table: `(channels, packed bitmap, State)` for every
+//!    live entry. That is the entire persistent state of the search.
+//! 2. The on-line subsumption index (`StateMap::subsume_indexes[k]`):
+//!    `(k, packed bitmap, abstraction point, value)` for every live entry. The
+//!    popcount bucket is *derivable* from the packed bitmap (the packed length
+//!    is an exact multiple of 8 bits for every k >= 3, so there are no padding
+//!    bits and `popcount(packed) == |set|`), so it is not stored.
+//! 3. Nothing else. The successive-approximation position in `Search::search`
+//!    is *implicit*: the loop reads the root's state out of the `StateMap` and
+//!    continues from it, so restoring the table restores the iteration
+//!    position. In-flight async frames are deliberately not captured --
+//!    `improve` recomputes them from the memo table.
+//!
+//! # Why the snapshot is globally quiesced rather than torn
+//!
+//! It is tempting to copy the shards one at a time under their own locks and
+//! never stop the search. Every stored interval is sound *in isolation*, so
+//! such a torn snapshot would still be a sound memo table, and a resumed search
+//! would still terminate with a correct bound.
+//!
+//! It would not, however, still be a state the search could have been *in*. A
+//! tear can retain a parent whose bound was derived from a child that the tear
+//! dropped. That is invisible to the search itself, but `GenProof::prove_all`
+//! *panics* with "no valid proof step found" when a retained set has no
+//! justification (`docs/sortnetopt-internals.md` §3.6 invariant 4), so a torn
+//! snapshot could produce a run that searches correctly and then cannot emit a
+//! certificate -- exactly the failure mode that costs the most wall time to
+//! discover.
+//!
+//! A globally quiesced snapshot needs no new argument at all. It is precisely a
+//! state the live run passed through, so everything that was true of the
+//! running search at that instant is true of the resumed one, including every
+//! invariant in §3.6. The price is a stall, which is measured
+//! (`ckpt_stall_ns`) rather than assumed.
+//!
+//! Quiescing is implemented with `StateMap::checkpoint_gate`, an array of
+//! cache-line-padded `RwLock<()>` stripes, one per CPU. `StateMap::set` -- the
+//! *only* write path, covering the index insert/evict, the `remove_state`
+//! mirroring and the shard write -- takes **its own thread's stripe** in read
+//! mode for its whole body, and the checkpointer takes **every** stripe in
+//! write mode, in ascending index order, for the duration of the snapshot.
+//!
+//! Striping costs nothing in soundness. The snapshot is still globally
+//! consistent: a `set` is in flight only while holding some stripe in read
+//! mode, and the checkpointer holds all stripes simultaneously, so no `set`
+//! can be in flight anywhere while the snapshot runs. Nor can the stripes
+//! deadlock -- the checkpointer acquires them in ascending order and a `set`
+//! only ever holds one, so no thread holds a higher-indexed stripe while
+//! waiting on a lower one.
+//!
+//! What striping buys is that each worker keeps hammering its own cache line
+//! rather than all workers sharing one atomic, which is where the measured
+//! gate overhead came from.
+//!
+//! The lock order is unchanged: `gate stripes -> {index buckets, state
+//! shards}` in both paths, consistently, and `set` contains no `.await`, so no
+//! stripe guard is ever held across a suspension point (§3.6 invariant 3).
+//! When checkpointing is disabled no stripes are even allocated and the gate
+//! is not touched at all, so such a run is bit-for-bit the pre-Tier-2b code
+//! path.
+
+use std::{
+    fs::{self, File},
+    io::{self, BufReader, BufWriter, Read, Seek, SeekFrom, Write},
+    path::{Path, PathBuf},
+    sync::{
+        atomic::{AtomicBool, AtomicU64, Ordering::Relaxed},
+        OnceLock,
+    },
+    time::{Duration, Instant},
+};
+
+use super::states::{State, StateMap};
+use crate::{
+    instrument,
+    output_set::{OutputSet, MAX_CHANNELS},
+};
+
+/// Compile-time build identity, folded into the identity hash so a checkpoint
+/// written by one binary is never resumed by a semantically different one.
+/// Override at build time with `SORTNETOPT_BUILD_ID=...`.
+const BUILD_ID_FALLBACK: &str = "tier2b-v3-1";
+
+const MAGIC: [u8; 8] = *b"SNOCKPT\x01";
+const MAGIC_END: [u8; 8] = *b"SNOCKPTE";
+const FORMAT_VERSION: u32 = 1;
+const HEADER_LEN: usize = 128;
+const TRAILER_LEN: usize = 40;
+const FLAG_INDEX: u32 = 1;
+
+const FILE_NAME: &str = "checkpoint.bin";
+const TMP_NAME: &str = "checkpoint.bin.tmp";
+const PREV_NAME: &str = "checkpoint.prev.bin";
+
+// --- SHA-256 (FIPS 180-4) ----------------------------------------------------
+//
+// Implemented here rather than pulled in as a dependency: the Tier-2b brief
+// forbids new `Cargo.toml` entries, and a checkpoint's integrity check must not
+// itself be a supply-chain surface. Verified against the three standard test
+// vectors in the unit tests at the bottom of this file.
+
+const SHA256_K: [u32; 64] = [
+    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+];
+
+pub struct Sha256 {
+    state: [u32; 8],
+    buffer: [u8; 64],
+    buffered: usize,
+    length: u64,
+}
+
+impl Sha256 {
+    pub fn new() -> Self {
+        Self {
+            state: [
+                0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab,
+                0x5be0cd19,
+            ],
+            buffer: [0; 64],
+            buffered: 0,
+            length: 0,
+        }
+    }
+
+    fn compress(&mut self, block: &[u8]) {
+        let mut w = [0u32; 64];
+        for (index, chunk) in block.chunks_exact(4).enumerate().take(16) {
+            w[index] = u32::from_be_bytes([chunk[0], chunk[1], chunk[2], chunk[3]]);
+        }
+        for index in 16..64 {
+            let s0 = w[index - 15].rotate_right(7)
+                ^ w[index - 15].rotate_right(18)
+                ^ (w[index - 15] >> 3);
+            let s1 = w[index - 2].rotate_right(17)
+                ^ w[index - 2].rotate_right(19)
+                ^ (w[index - 2] >> 10);
+            w[index] = w[index - 16]
+                .wrapping_add(s0)
+                .wrapping_add(w[index - 7])
+                .wrapping_add(s1);
+        }
+
+        let [mut a, mut b, mut c, mut d, mut e, mut f, mut g, mut h] = self.state;
+
+        for index in 0..64 {
+            let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
+            let ch = (e & f) ^ ((!e) & g);
+            let temp1 = h
+                .wrapping_add(s1)
+                .wrapping_add(ch)
+                .wrapping_add(SHA256_K[index])
+                .wrapping_add(w[index]);
+            let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
+            let maj = (a & b) ^ (a & c) ^ (b & c);
+            let temp2 = s0.wrapping_add(maj);
+
+            h = g;
+            g = f;
+            f = e;
+            e = d.wrapping_add(temp1);
+            d = c;
+            c = b;
+            b = a;
+            a = temp1.wrapping_add(temp2);
+        }
+
+        self.state[0] = self.state[0].wrapping_add(a);
+        self.state[1] = self.state[1].wrapping_add(b);
+        self.state[2] = self.state[2].wrapping_add(c);
+        self.state[3] = self.state[3].wrapping_add(d);
+        self.state[4] = self.state[4].wrapping_add(e);
+        self.state[5] = self.state[5].wrapping_add(f);
+        self.state[6] = self.state[6].wrapping_add(g);
+        self.state[7] = self.state[7].wrapping_add(h);
+    }
+
+    pub fn update(&mut self, mut data: &[u8]) {
+        self.length = self.length.wrapping_add(data.len() as u64);
+
+        if self.buffered > 0 {
+            let want = (64 - self.buffered).min(data.len());
+            self.buffer[self.buffered..self.buffered + want].copy_from_slice(&data[..want]);
+            self.buffered += want;
+            data = &data[want..];
+            if self.buffered == 64 {
+                let block = self.buffer;
+                self.compress(&block);
+                self.buffered = 0;
+            }
+        }
+
+        let mut chunks = data.chunks_exact(64);
+        for chunk in &mut chunks {
+            self.compress(chunk);
+        }
+
+        let remainder = chunks.remainder();
+        if !remainder.is_empty() {
+            self.buffer[..remainder.len()].copy_from_slice(remainder);
+            self.buffered = remainder.len();
+        }
+    }
+
+    pub fn finalize(mut self) -> [u8; 32] {
+        let bit_length = self.length.wrapping_mul(8);
+
+        self.update(&[0x80]);
+        // `update` counted the padding byte; the length field must not.
+        self.length = self.length.wrapping_sub(1);
+        while self.buffered != 56 {
+            self.update(&[0x00]);
+            self.length = self.length.wrapping_sub(1);
+        }
+        self.update(&bit_length.to_be_bytes());
+
+        let mut out = [0u8; 32];
+        for (index, word) in self.state.iter().enumerate() {
+            out[index * 4..index * 4 + 4].copy_from_slice(&word.to_be_bytes());
+        }
+        out
+    }
+}
+
+pub fn sha256(data: &[u8]) -> [u8; 32] {
+    let mut hasher = Sha256::new();
+    hasher.update(data);
+    hasher.finalize()
+}
+
+/// FNV-1a, 64 bit. Used only for the fixed-size header, where the point is to
+/// catch a torn or bit-flipped header *before* any field in it is trusted.
+fn fnv1a64(data: &[u8]) -> u64 {
+    let mut hash: u64 = 0xcbf2_9ce4_8422_2325;
+    for &byte in data {
+        hash ^= byte as u64;
+        hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    hash
+}
+
+fn hex(bytes: &[u8]) -> String {
+    let mut out = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        out.push_str(&format!("{:02x}", byte));
+    }
+    out
+}
+
+// --- configuration -----------------------------------------------------------
+
+#[derive(Clone, Debug)]
+pub struct CheckpointConfig {
+    /// `None` disables checkpointing entirely, including the `StateMap` gate.
+    pub dir: Option<PathBuf>,
+    /// Zero disables periodic writes (the final write still happens).
+    pub interval: Duration,
+    pub resume: bool,
+    pub keep_prev: bool,
+    pub final_write: bool,
+}
+
+fn env_flag(name: &str) -> bool {
+    match std::env::var(name) {
+        Ok(value) => {
+            let value = value.trim().to_ascii_lowercase();
+            value == "1" || value == "true" || value == "yes"
+        }
+        Err(_) => false,
+    }
+}
+
+fn env_flag_default_on(name: &str) -> bool {
+    match std::env::var(name) {
+        Ok(value) => {
+            let value = value.trim().to_ascii_lowercase();
+            !(value == "0" || value == "false" || value == "no")
+        }
+        Err(_) => true,
+    }
+}
+
+impl CheckpointConfig {
+    fn from_env() -> Self {
+        let dir = match std::env::var("SORTNETOPT_CHECKPOINT_DIR") {
+            Ok(value) if !value.trim().is_empty() => Some(PathBuf::from(value.trim())),
+            _ => None,
+        };
+        let interval_secs: u64 = std::env::var("SORTNETOPT_CHECKPOINT_INTERVAL_SECS")
+            .ok()
+            .and_then(|value| value.trim().parse().ok())
+            .unwrap_or(600);
+
+        Self {
+            dir,
+            interval: Duration::from_secs(interval_secs),
+            resume: env_flag("SORTNETOPT_CHECKPOINT_RESUME"),
+            keep_prev: env_flag("SORTNETOPT_CHECKPOINT_KEEP_PREV"),
+            final_write: env_flag_default_on("SORTNETOPT_CHECKPOINT_FINAL"),
+        }
+    }
+}
+
+static CONFIG: OnceLock<CheckpointConfig> = OnceLock::new();
+
+pub fn config() -> &'static CheckpointConfig {
+    CONFIG.get_or_init(CheckpointConfig::from_env)
+}
+
+/// Whether `StateMap::set` has to take the quiescing gate. Read once, at
+/// `StateMap::new`, and stored on the map.
+pub fn enabled() -> bool {
+    config().dir.is_some()
+}
+
+// --- identity ----------------------------------------------------------------
+
+/// The canonical, sorted, newline-separated key=value text covering everything
+/// that changes search semantics. Its SHA-256 goes in the header; the text
+/// itself is stored too, so a refusal can print *what* differed.
+///
+/// Deliberately **excluded**: the `StateMap` shard count and `num_cpus::get()`.
+/// Shard assignment is recomputed from the packed key on load (`restore_state`
+/// runs the same `FxHasher`-of-`PVec` rule `get`/`set` use), and the worker
+/// count changes nothing semantic -- so a checkpoint stays portable between
+/// machines with different core counts.
+pub fn identity_string(states: &StateMap, channels: usize, limit: Option<usize>, prefix: &[usize]) -> String {
+    let build = option_env!("SORTNETOPT_BUILD_ID").unwrap_or(BUILD_ID_FALLBACK);
+
+    let limit = match limit {
+        Some(limit) => limit.to_string(),
+        None => "none".to_owned(),
+    };
+
+    let prefix = if prefix.is_empty() {
+        "none".to_owned()
+    } else {
+        prefix
+            .iter()
+            .map(|value| value.to_string())
+            .collect::<Vec<_>>()
+            .join(",")
+    };
+
+    let dims = states.subsume_index_dims();
+    let subsume_index = if dims.is_empty() {
+        "none".to_owned()
+    } else {
+        dims.iter()
+            .map(|(k, point_dim)| format!("{}:{}", k, point_dim))
+            .collect::<Vec<_>>()
+            .join(",")
+    };
+
+    let mut lines = vec![
+        "sortnetopt-checkpoint".to_owned(),
+        format!("format={}", FORMAT_VERSION),
+        format!("build={}", build),
+        format!("channels={}", channels),
+        format!("limit={}", limit),
+        format!("prefix={}", prefix),
+        format!("max_channels={}", MAX_CHANNELS),
+        format!("subsume_mode={}", states.subsume_mode().name()),
+        format!("subsume_index={}", subsume_index),
+        format!(
+            "tier1_sig={}",
+            crate::output_set::index::sig_filter_enabled() as u8
+        ),
+        format!(
+            "tier1_hist={}",
+            crate::output_set::index::hist_filter_enabled() as u8
+        ),
+    ];
+    // The leading tag stays first; everything after it is sorted so the text is
+    // canonical regardless of the order the fields were assembled in.
+    lines[1..].sort();
+    lines.join("\n")
+}
+
+// --- writing -----------------------------------------------------------------
+
+struct HashWriter<W: Write> {
+    inner: W,
+    hasher: Sha256,
+    count: u64,
+}
+
+impl<W: Write> HashWriter<W> {
+    fn new(inner: W) -> Self {
+        Self {
+            inner,
+            hasher: Sha256::new(),
+            count: 0,
+        }
+    }
+
+    fn put(&mut self, bytes: &[u8]) -> io::Result<()> {
+        self.hasher.update(bytes);
+        self.count += bytes.len() as u64;
+        self.inner.write_all(bytes)
+    }
+
+    fn put_u8(&mut self, value: u8) -> io::Result<()> {
+        self.put(&[value])
+    }
+
+    fn put_u32(&mut self, value: u32) -> io::Result<()> {
+        self.put(&value.to_le_bytes())
+    }
+
+    fn put_u64(&mut self, value: u64) -> io::Result<()> {
+        self.put(&value.to_le_bytes())
+    }
+}
+
