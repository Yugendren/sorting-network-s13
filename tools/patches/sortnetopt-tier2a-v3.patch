+/// Tier-2a Change D: thread-local pool of `Subsume`'s three per-instance
+/// scratch buffers (`buffer`, `inner`, `undo_stack`).
+///
+/// A fresh `Subsume` is built and dropped for *every* exact subsumption
+/// test -- millions per search -- so leaving these as `vec![]` in `new` and
+/// letting them grow on first use costs one malloc (and, once the
+/// `Subsume` is dropped, one free) per test, same shape of waste as
+/// `TABLE_CACHE` / `DEPTH0_CACHE` were built to avoid for
+/// `AbstractionTables` / depth-0 abstractions. Since exactly one `Subsume`
+/// is ever live on a given thread at a time (see `Subsume::new` / `Drop for
+/// Subsume`), a single pooled triple of buffers, taken out on construction
+/// and returned (length cleared, capacity kept) on drop, amortizes the
+/// allocation to "at most a few, ever, per thread" instead of "one per
+/// test".
+///
+/// Wrapped in `Option` so a (never-expected-but-checked-for) nested
+/// `Subsume` construction on the same thread -- i.e. a second `new()` while
+/// the first pool borrower has not yet dropped -- degrades to a fresh,
+/// unpooled `Vec` rather than corrupting the pooled buffers out from under
+/// the live outer `Subsume`. See `Subsume::pool_borrowed`.
+struct ScratchPool {
+    buffer: Vec<usize>,
+    inner: Vec<usize>,
+    undo: Vec<UndoAction>,
+}
+
+impl ScratchPool {
+    fn new() -> Self {
+        Self {
+            buffer: Vec::new(),
+            inner: Vec::new(),
+            undo: Vec::new(),
+        }
+    }
+}
+
+thread_local! {
+    static SCRATCH: RefCell<Option<ScratchPool>> = RefCell::new(Some(ScratchPool::new()));
+}
