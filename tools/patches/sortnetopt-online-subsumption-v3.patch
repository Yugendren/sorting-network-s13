+/// M2a: how much of the on-line permutation-subsumption prototype is active.
+///
+/// `Off` reproduces the unmodified search exactly: no index is allocated and
+/// neither `get` nor `set` gains a single branch that touches one.
+#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Debug)]
+pub enum SubsumeMode {
+    /// Baseline. No subsumption index at all.
+    Off,
+    /// Write side only: `set` routes the bound through
+    /// `OutputSetIndex::insert_with_abstraction`, which returns the best bound
+    /// over already-stored sets that subsume this one. That bound is a sound
+    /// lower bound, so it is written into the memo table.
+    Write,
+    /// `Write`, plus: an exact-key miss in `get` consults the index instead of
+    /// falling straight through to the `known_bounds` seed.
+    WriteRead,
+    /// `WriteRead`, plus: entries the index evicts as dominated are removed
+    /// from the memo table too. This is the only mode that reduces peak
+    /// entries; it depends on the read side for bound monotonicity.
+    Evict,
+}
+
+impl SubsumeMode {
+    fn from_env() -> Self {
+        match std::env::var("SORTNETOPT_SUBSUME")
+            .unwrap_or_default()
+            .to_ascii_lowercase()
+            .as_str()
+        {
+            "write" => SubsumeMode::Write,
+            "writeread" | "read" => SubsumeMode::WriteRead,
+            "evict" => SubsumeMode::Evict,
+            _ => SubsumeMode::Off,
+        }
+    }
+
+    pub fn name(self) -> &'static str {
+        match self {
+            SubsumeMode::Off => "off",
+            SubsumeMode::Write => "write",
+            SubsumeMode::WriteRead => "writeread",
+            SubsumeMode::Evict => "evict",
+        }
+    }
+}
