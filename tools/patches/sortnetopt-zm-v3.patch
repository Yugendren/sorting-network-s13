# ZM-V3: Lemma Z (zeta-based abstraction) and Lemma M (bipartite-matching
# index filter), plus the `filter_exact_hits` counter.
#
# Implements the two PROMOTED lemmas of docs/transforms-assessment.md
# (§1.5 Lemma Z, §4.4 Lemma M) and the one instrumentation ask of §4.3.
#
# Applies on top of, in order:
#   tools/patches/sortnetopt-macos-proc.patch
#   tools/patches/sortnetopt-instrumentation-v3.patch
#   tools/patches/sortnetopt-online-subsumption-v3.patch
#   tools/patches/sortnetopt-perf-v3.patch
#   tools/patches/sortnetopt-tier1-v3.patch
#   tools/patches/sortnetopt-tier2a-v3.patch
#   tools/patches/sortnetopt-tier2b-v3.patch
#   tools/patches/sortnetopt-limits-v3.patch
# against the pinned upstream commit 0b5d09c47446096f9e3a0812b35afc72b7f2a718.
# Apply with:  patch -V none -p1 -i <this file>
#
# checker/ is NOT touched. Neither are src/search.rs, src/search/states.rs,
# src/search/subsume.rs, src/search/checkpoint.rs, src/prune.rs, src/proof.rs,
# src/thread_pool.rs, src/output_set/canon.rs, src/output_set/subsume.rs or
# Cargo.toml. Eight files change or appear:
#
#   src/output_set/zeta.rs      (new)  Lemma Z + the per-channel blocks
#   src/output_set/matching.rs  (new)  Lemma M: Hall / Kuhn perfect matching
#   src/output_set.rs                  `pub mod` lines; `write_abstraction_into`
#                                      routed through zeta; the old body kept
#                                      verbatim as `..._reference` (the
#                                      differential oracle); two packed-input
#                                      abstraction entry points
#   src/output_set/packed.rs           `PackedSet::from_bitmap` byte-at-a-time
#   src/output_set/index.rs            `SubsumeFilter::blocks`,
#                                      `match_filter_enabled()`, the six
#                                      per-branch Lemma M guards, the audit
#                                      path, `FILTER_EXACT_HITS`
#   src/instrument.rs                  four new counters
#   src/bin/zeta_diff.rs        (new)  randomized bit-identity harness
#   src/bin/zm_bench.rs         (new)  single-threaded microbenchmark
#
# ---------------------------------------------------------------------------
# LEMMA Z
#
# `OutputSet::channel_pair_abstraction([i,j])` counts the four quadrants of a
# channel pair, which are exactly the rank-<=2 superset-zeta transform of the
# output set read through inclusion-exclusion:
#
#   group 0 = zeta({i,j})
#   group 1 = zeta({j}) - zeta({i,j})
#   group 2 = zeta({i}) - zeta({i,j})
#   group 3 = |X| - zeta({i}) - zeta({j}) + zeta({i,j})
#
# So the whole abstraction vector, and hence the whole `Lower`/`LowerInvert`
# index filter, is a function of (|X|, zeta({i}), zeta({i,j})) alone. Upstream
# recomputes it with n(n-1) stride-2^k gathers over the dense `[bool]` bitmap;
# this patch computes the rank-<=2 truncation once, in a single contiguous
# masked-popcount pass over the packed `u64` bitmap that TIER1's `PackedSet`
# already provides, and derives all n(n-1) quadruples arithmetically.
#
# The emitted `u16` vector is BIT-IDENTICAL. The pre-ZM route is retained as
# `write_abstraction_into_reference` / `abstraction_reference` and is the
# oracle for the unit tests and for `src/bin/zeta_diff.rs`.
#
# ---------------------------------------------------------------------------
# LEMMA M
#
# For channel i let v_i(X) be the four `channel_pair_abstraction([i,j])` groups
# over j != i, each sorted descending. If pi(A) is a subset of B for a channel
# permutation pi then v_i(A) <= v_{pi(i)}(B) coordinatewise for every i, so
# pi is a perfect matching in Gamma(A,B) = { (i,j) : v_i(A) <= v_j(B) }.
# "Gamma(A,B) has no perfect matching" is therefore a SOUND one-sided rejection
# of permuted containment, strictly stronger than `Dir::test_abstraction`,
# which is the across-channel-sorted relaxation of the same data.
#
# The test is placed AFTER the existing signature + coordinatewise-abstraction
# + histogram chain and IMMEDIATELY BEFORE the `subsumes_permuted_packed` it
# guards, once per branch (the identity and complement branches of
# `LowerInvert` keep separate guards; merging them would be sound but strictly
# weaker). Complementing acts on a block row as the index permutation
# `t |-> t ^ 3`, so the complement polarity needs no second construction.
#
# Env gate `SORTNETOPT_MATCH_FILTER`, default ON. Under
# `SORTNETOPT_FILTER_AUDIT=1` a match-filter rejection does not skip the exact
# test: the exact test runs anyway and any disagreement bumps
# `filter_match_audit_violations`, logs both block matrices and panics.
#
# ---------------------------------------------------------------------------
# NEW COUNTERS
#
#   filter_exact_hits              exact tests that returned a match (the
#                                  §4.3 ask: makes the ceiling fraction
#                                  measurable in-engine)
#   filter_match_calls             Lemma M evaluations
#   filter_match_rejects           Lemma M rejections
#   filter_match_audit_violations  must be 0
#
# ---------------------------------------------------------------------------
diff -ruN a/src/bin/zeta_diff.rs b/src/bin/zeta_diff.rs
--- a/src/bin/zeta_diff.rs	1970-01-01 07:30:00
+++ b/src/bin/zeta_diff.rs	2026-08-18 04:34:41
@@ -0,0 +1,464 @@
+//! ZM-V3, Lemma Z: standalone randomized differential harness.
+//!
+//! Checks, over randomly generated *reachable* output sets at every width in a
+//! range, that the Lemma Z route to the abstraction vector
+//! (`OutputSet::abstraction`, now `zeta::write_abstraction_from_counts` over
+//! `zeta::PairCounts::from_packed`) is **bit-identical** to the pre-ZM upstream
+//! route (`OutputSet::abstraction_reference`), and that
+//! `zeta::PairCounts::quadrants` reproduces `OutputSet::channel_pair_abstraction`
+//! for every ordered channel pair.
+//!
+//! Sets are generated and checked in bounded batches (`--batch`, default 4096)
+//! that are dropped between batches, so peak RSS stays in the tens of
+//! megabytes even at `MAX_CHANNELS` (4096 x 2^13 `bool`s is 33 MB).
+//!
+//! Only sets obtained from `OutputSet::all_values` by `apply_comparator`,
+//! `prune_extremal_channel_into`, `swap_channels` and `invert` are generated,
+//! per the repo rule that nothing else is a genuine output set. Note that this
+//! rules out the "single vector" pathological case the abstract asks for:
+//! comparators preserve the all-zeros and all-ones vectors, so every genuine
+//! output set has at least two elements. The minimal genuine sets are the
+//! fully sorted ones (`channels + 1` elements), which are generated instead.
+//!
+//! ```text
+//! zeta_diff --channels-min 3 --channels-max 11 --sets 20000 --seed 1
+//! zeta_diff --channels-min 3 --channels-max 11 --seed 1 --timing
+//! ```
+
+use std::{hint::black_box, process::exit, time::Instant};
+
+use structopt::StructOpt;
+
+use sortnetopt::output_set::{
+    packed::PackedSet,
+    zeta::{abstraction_from_packed, PairCounts},
+    OutputSet, MAX_CHANNELS,
+};
+
+#[derive(Debug, StructOpt)]
+#[structopt(
+    name = "zeta_diff",
+    about = "ZM-V3 Lemma Z differential harness: abstraction() vs abstraction_reference()"
+)]
+struct Opt {
+    /// Lowest width to test (the abstraction is only defined for >= 2, and the
+    /// search never sees fewer than 3 channels)
+    #[structopt(long, default_value = "3")]
+    channels_min: usize,
+    /// Highest width to test; capped at this build's MAX_CHANNELS
+    #[structopt(long, default_value = "13")]
+    channels_max: usize,
+    /// Number of output sets to check per width
+    #[structopt(long, default_value = "10000")]
+    sets: usize,
+    /// PRNG seed
+    #[structopt(long, default_value = "1")]
+    seed: u64,
+    /// Number of sets held in memory at once
+    #[structopt(long, default_value = "4096")]
+    batch: usize,
+    /// Instead of differential checking, report ns/call for both abstraction
+    /// routes at each width over a fixed corpus
+    #[structopt(long)]
+    timing: bool,
+    /// Corpus size for --timing
+    #[structopt(long, default_value = "256")]
+    timing_corpus: usize,
+    /// Number of passes over the timing corpus per route
+    #[structopt(long, default_value = "20")]
+    timing_reps: usize,
+}
+
+// ---------------------------------------------------------------------------
+// PRNG
+// ---------------------------------------------------------------------------
+
+/// Marsaglia xorshift64, same shift triple as the one used by the unit tests
+/// in `output_set::packed` and `output_set::zeta`.
+struct Xorshift64(u64);
+
+impl Xorshift64 {
+    fn new(seed: u64) -> Self {
+        Self(seed | 1)
+    }
+
+    fn next(&mut self) -> u64 {
+        let mut x = self.0;
+        x ^= x << 13;
+        x ^= x >> 7;
+        x ^= x << 17;
+        self.0 = x;
+        x
+    }
+
+    fn below(&mut self, bound: usize) -> usize {
+        (self.next() % bound as u64) as usize
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Reachable-output-set generation
+// ---------------------------------------------------------------------------
+
+/// A stateful stream of genuine output sets at one width.
+///
+/// The first few sets are the pathological ones (full cube, fully sorted,
+/// pruned-from-above); after that it is a random walk that applies a
+/// comparator / channel swap / inversion to the running set and restarts from
+/// the full cube periodically, so the stream keeps hitting the whole density
+/// range rather than converging on sorted sets.
+struct SetGen {
+    channels: usize,
+    rng: Xorshift64,
+    current: OutputSet<Vec<bool>>,
+    emitted: usize,
+    since_restart: usize,
+    restart_period: usize,
+}
+
+impl SetGen {
+    fn new(channels: usize, seed: u64) -> Self {
+        Self {
+            channels,
+            rng: Xorshift64::new(seed),
+            current: OutputSet::all_values(channels),
+            emitted: 0,
+            since_restart: 0,
+            restart_period: 3 * channels + 8,
+        }
+    }
+
+    /// The fully sorted set: bubble sort is a sorting network, so this is
+    /// reachable by comparators alone.
+    fn sorted(channels: usize) -> OutputSet<Vec<bool>> {
+        let mut set = OutputSet::all_values(channels);
+        for i in 0..channels {
+            for j in 0..channels.saturating_sub(1 + i) {
+                set.apply_comparator([j + 1, j]);
+            }
+        }
+        debug_assert!(set.is_sorted());
+        set
+    }
+
+    /// A `channels`-wide set obtained by pruning an extremal channel off a
+    /// `channels + 1`-wide one, exercising the only other set-producing
+    /// operation the search uses.
+    fn pruned(channels: usize, rng: &mut Xorshift64) -> Option<OutputSet<Vec<bool>>> {
+        if channels + 1 > MAX_CHANNELS {
+            return None;
+        }
+        let big_channels = channels + 1;
+        let mut big = OutputSet::all_values(big_channels);
+        for _ in 0..(2 * big_channels) {
+            let a = rng.below(big_channels);
+            let b = rng.below(big_channels);
+            if a != b {
+                big.apply_comparator([a.max(b), a.min(b)]);
+            }
+        }
+        let polarity = rng.next() & 1 != 0;
+        let channel = rng.below(big_channels);
+        if !big.channel_is_extremal(polarity, channel) {
+            return None;
+        }
+        let mut small = OutputSet::all_values(channels);
+        big.prune_extremal_channel_into(polarity, channel, small.as_mut());
+        Some(small)
+    }
+
+    fn step(&mut self) {
+        if self.since_restart >= self.restart_period {
+            self.current = OutputSet::all_values(self.channels);
+            self.since_restart = 0;
+            return;
+        }
+        self.since_restart += 1;
+
+        match self.rng.below(16) {
+            14 => {
+                let a = self.rng.below(self.channels);
+                let b = self.rng.below(self.channels);
+                self.current.swap_channels([a, b]);
+            }
+            15 => self.current.invert(),
+            _ => {
+                let a = self.rng.below(self.channels);
+                let b = self.rng.below(self.channels);
+                if a != b {
+                    self.current.apply_comparator([a.max(b), a.min(b)]);
+                }
+            }
+        }
+    }
+
+    fn next_set(&mut self) -> OutputSet<Vec<bool>> {
+        let index = self.emitted;
+        self.emitted += 1;
+
+        match index {
+            0 => return OutputSet::all_values(self.channels),
+            1 => return Self::sorted(self.channels),
+            2 => {
+                if let Some(set) = Self::pruned(self.channels, &mut self.rng) {
+                    return set;
+                }
+            }
+            _ => (),
+        }
+
+        self.step();
+        self.current.clone()
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Checking
+// ---------------------------------------------------------------------------
+
+#[derive(Default, Clone, Copy)]
+struct WidthStats {
+    sets: u64,
+    abstraction_mismatches: u64,
+    quadrant_mismatches: u64,
+}
+
+/// Returns `(abstraction_mismatches, quadrant_mismatches)` for one set, and
+/// prints up to `report_budget` mismatches in full.
+fn check_set(set: &OutputSet<Vec<bool>>, report_budget: &mut usize) -> (u64, u64) {
+    let channels = set.channels();
+    let packed = PackedSet::from_bitmap(set.as_ref());
+
+    let mut abstraction_mismatches = 0u64;
+    let mut quadrant_mismatches = 0u64;
+
+    let want = set.abstraction_reference();
+    let got = set.abstraction();
+    let got_packed = abstraction_from_packed(&packed);
+
+    if want[..] != got[..] || want[..] != got_packed[..] {
+        abstraction_mismatches += 1;
+        if *report_budget > 0 {
+            *report_budget -= 1;
+            eprintln!(
+                "MISMATCH abstraction channels={} packed={:?}\n  reference     = {:?}\n  abstraction() = {:?}\n  from_packed() = {:?}",
+                channels,
+                set.packed(),
+                &want[..],
+                &got[..],
+                &got_packed[..],
+            );
+        }
+    }
+
+    let counts = PairCounts::from_packed(&packed);
+    if counts.total() as usize != set.len() {
+        quadrant_mismatches += 1;
+        if *report_budget > 0 {
+            *report_budget -= 1;
+            eprintln!(
+                "MISMATCH total channels={} packed={:?} zeta_total={} len={}",
+                channels,
+                set.packed(),
+                counts.total(),
+                set.len(),
+            );
+        }
+    }
+
+    for i in 0..channels {
+        for j in 0..channels {
+            if i == j {
+                continue;
+            }
+            let want = set.channel_pair_abstraction([i, j]);
+            let got = counts.quadrants(i, j);
+            let got = [
+                got[0] as usize,
+                got[1] as usize,
+                got[2] as usize,
+                got[3] as usize,
+            ];
+            if got != want {
+                quadrant_mismatches += 1;
+                if *report_budget > 0 {
+                    *report_budget -= 1;
+                    eprintln!(
+                        "MISMATCH quadrants channels={} pair=({},{}) packed={:?} want={:?} got={:?}",
+                        channels,
+                        i,
+                        j,
+                        set.packed(),
+                        want,
+                        got,
+                    );
+                }
+            }
+        }
+    }
+
+    (abstraction_mismatches, quadrant_mismatches)
+}
+
+fn run_diff(opt: &Opt, channels_max: usize) -> i32 {
+    let batch_size = opt.batch.max(1);
+    let mut report_budget = 20usize;
+
+    let mut per_width: Vec<(usize, WidthStats)> = vec![];
+
+    for channels in opt.channels_min..=channels_max {
+        let mut gen = SetGen::new(
+            channels,
+            opt.seed ^ (0x9E37_79B9_7F4A_7C15u64 * channels as u64),
+        );
+        let mut stats = WidthStats::default();
+
+        let mut remaining = opt.sets;
+        while remaining > 0 {
+            let this_batch = remaining.min(batch_size);
+
+            // Bounded batch: built, checked, then dropped before the next one.
+            let mut batch: Vec<OutputSet<Vec<bool>>> = Vec::with_capacity(this_batch);
+            for _ in 0..this_batch {
+                batch.push(gen.next_set());
+            }
+
+            for set in &batch {
+                let (a, q) = check_set(set, &mut report_budget);
+                stats.sets += 1;
+                stats.abstraction_mismatches += a;
+                stats.quadrant_mismatches += q;
+            }
+
+            drop(batch);
+            remaining -= this_batch;
+        }
+
+        per_width.push((channels, stats));
+    }
+
+    let mut total_sets = 0u64;
+    let mut total_mismatches = 0u64;
+    for &(channels, stats) in &per_width {
+        println!(
+            "width={} sets={} abstraction_mismatches={} quadrant_mismatches={}",
+            channels, stats.sets, stats.abstraction_mismatches, stats.quadrant_mismatches
+        );
+        total_sets += stats.sets;
+        total_mismatches += stats.abstraction_mismatches + stats.quadrant_mismatches;
+    }
+    println!("TOTAL sets={} mismatches={}", total_sets, total_mismatches);
+
+    (total_mismatches != 0) as i32
+}
+
+fn run_timing(opt: &Opt, channels_max: usize) -> i32 {
+    let corpus_size = opt.timing_corpus.max(1);
+    let reps = opt.timing_reps.max(1);
+
+    println!(
+        "# timing: corpus={} sets/width, {} passes/route",
+        corpus_size, reps
+    );
+
+    for channels in opt.channels_min..=channels_max {
+        let mut gen = SetGen::new(
+            channels,
+            opt.seed ^ (0x9E37_79B9_7F4A_7C15u64 * channels as u64),
+        );
+        let corpus: Vec<OutputSet<Vec<bool>>> = (0..corpus_size).map(|_| gen.next_set()).collect();
+
+        // Warm up both routes (page-in, branch predictor, caches).
+        for set in &corpus {
+            black_box(set.abstraction_reference());
+            black_box(set.abstraction());
+        }
+
+        let calls = (corpus.len() * reps) as f64;
+
+        let start = Instant::now();
+        for _ in 0..reps {
+            for set in &corpus {
+                black_box(set.abstraction_reference());
+            }
+        }
+        let old_ns = start.elapsed().as_nanos() as f64 / calls;
+
+        let start = Instant::now();
+        for _ in 0..reps {
+            for set in &corpus {
+                black_box(set.abstraction());
+            }
+        }
+        let new_ns = start.elapsed().as_nanos() as f64 / calls;
+
+        // The `&self` route also pays for the `[bool]` -> `PackedSet` pack on
+        // every call; callers that already hold a `PackedSet` (the search's
+        // hot path) skip that, so time it separately.
+        let packed_corpus: Vec<PackedSet> = corpus
+            .iter()
+            .map(|set| PackedSet::from_bitmap(set.as_ref()))
+            .collect();
+        let start = Instant::now();
+        for _ in 0..reps {
+            for packed in &packed_corpus {
+                black_box(abstraction_from_packed(packed));
+            }
+        }
+        let packed_ns = start.elapsed().as_nanos() as f64 / calls;
+
+        println!(
+            "width={} reference_ns={:.1} zeta_ns={:.1} zeta_from_packed_ns={:.1} \
+             speedup={:.2}x speedup_from_packed={:.2}x",
+            channels,
+            old_ns,
+            new_ns,
+            packed_ns,
+            old_ns / new_ns,
+            old_ns / packed_ns,
+        );
+    }
+
+    0
+}
+
+fn main() {
+    let opt = Opt::from_args();
+
+    assert!(
+        opt.channels_min >= 2,
+        "the abstraction is empty below 2 channels (requested --channels-min {})",
+        opt.channels_min
+    );
+    assert!(
+        opt.channels_min <= opt.channels_max,
+        "--channels-min {} exceeds --channels-max {}",
+        opt.channels_min,
+        opt.channels_max
+    );
+
+    // Silently clamp rather than fail: the default `--channels-max 13` is meant
+    // to mean "as wide as this build goes".
+    let channels_max = opt.channels_max.min(MAX_CHANNELS);
+    if channels_max < opt.channels_max {
+        eprintln!(
+            "# this build supports at most {} channels; capping --channels-max {} to {}",
+            MAX_CHANNELS, opt.channels_max, channels_max
+        );
+    }
+    assert!(
+        opt.channels_min <= channels_max,
+        "this build supports at most {} channels (requested --channels-min {}); \
+         rebuild with `--features wide12` or `--features wide13`",
+        MAX_CHANNELS,
+        opt.channels_min,
+    );
+
+    let status = if opt.timing {
+        run_timing(&opt, channels_max)
+    } else {
+        run_diff(&opt, channels_max)
+    };
+
+    exit(status);
+}
diff -ruN a/src/bin/zm_bench.rs b/src/bin/zm_bench.rs
--- a/src/bin/zm_bench.rs	1970-01-01 07:30:00
+++ b/src/bin/zm_bench.rs	2026-08-18 05:01:36
@@ -0,0 +1,397 @@
+//! ZM-V3: single-threaded deterministic microbenchmark for the Lemma Z /
+//! Lemma M kernels.
+//!
+//! In-engine the Lemma M filter removes 91% of the exact
+//! `subsumes_permuted_packed` calls but costs nearly as much per call, so the
+//! net instruction win does not show up in cycles. This harness isolates the
+//! five kernels that decide that trade so a change can be attributed to one of
+//! them:
+//!
+//! ```text
+//! a  abstraction            OutputSet::abstraction()            (Lemma Z route)
+//! b  abstraction_reference  OutputSet::abstraction_reference()  (upstream route)
+//! c  blocks_from_packed     zeta::ChannelBlocks::from_packed
+//! d  gamma_has_matching     matching::gamma_has_matching        (both polarities)
+//! e  subsumes_permuted      output_set::subsumes_permuted_packed  <- must beat
+//! ```
+//!
+//! plus the derived `match_allows = c + d`, which is what the guard in
+//! `index.rs` actually pays per candidate, and which is the thing that has to
+//! come out an order of magnitude under `e`.
+//!
+//! Everything is driven by one xorshift64 stream from a fixed seed, so two
+//! runs of the same binary options see byte-identical inputs. The printed
+//! `corpus_checksum` proves that across a code change: it hashes the packed
+//! bitmap of every corpus set and the whole pair list, and it must not move.
+//!
+//! Rounds are *interleaved* (one pass of every kernel, then the next round)
+//! rather than batched per kernel, so a thermal or frequency excursion hits
+//! all five roughly equally instead of penalising whichever kernel happened to
+//! run during it. `min` is the least contaminated estimate; `median` is
+//! reported alongside so a suspiciously lucky `min` is visible.
+//!
+//! Memory is deliberately tiny: a few hundred sets per width, one width live
+//! at a time, so this can run next to a search without disturbing it.
+//!
+//! ```text
+//! zm_bench                                     # widths 8..=11, defaults
+//! zm_bench --channels-min 9 --channels-max 9 --corpus 512 --rounds 9
+//! ```
+
+use std::{hint::black_box, time::Instant};
+
+use structopt::StructOpt;
+
+use sortnetopt::output_set::{
+    matching::gamma_has_matching,
+    packed::PackedSet,
+    subsumes_permuted_packed,
+    zeta::{ChannelBlocks, PairCounts},
+    OutputSet, MAX_CHANNELS,
+};
+
+#[derive(Debug, StructOpt)]
+#[structopt(
+    name = "zm_bench",
+    about = "ZM-V3 microbenchmark: Lemma Z / Lemma M kernels vs the exact arbiter"
+)]
+struct Opt {
+    /// Lowest width to benchmark
+    #[structopt(long, default_value = "8")]
+    channels_min: usize,
+    /// Highest width to benchmark; capped at this build's MAX_CHANNELS
+    #[structopt(long, default_value = "11")]
+    channels_max: usize,
+    /// Output sets per width
+    #[structopt(long, default_value = "256")]
+    corpus: usize,
+    /// `(a, b)` pairs per width for the matching / exact kernels
+    #[structopt(long, default_value = "256")]
+    pairs: usize,
+    /// Interleaved timing rounds; min and median over these are reported
+    #[structopt(long, default_value = "7")]
+    rounds: usize,
+    /// PRNG seed
+    #[structopt(long, default_value = "1")]
+    seed: u64,
+}
+
+// ---------------------------------------------------------------------------
+// PRNG
+// ---------------------------------------------------------------------------
+
+/// Marsaglia xorshift64, same shift triple as `bin/zeta_diff` and the unit
+/// tests in `output_set::{packed, zeta, matching}`.
+struct Xorshift64(u64);
+
+impl Xorshift64 {
+    fn new(seed: u64) -> Self {
+        Self(seed | 1)
+    }
+
+    fn next(&mut self) -> u64 {
+        let mut x = self.0;
+        x ^= x << 13;
+        x ^= x >> 7;
+        x ^= x << 17;
+        self.0 = x;
+        x
+    }
+
+    fn below(&mut self, bound: usize) -> usize {
+        (self.next() % bound as u64) as usize
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Corpus
+// ---------------------------------------------------------------------------
+
+/// Reachable output sets: random comparator chains from the full cube, keeping
+/// every intermediate set, restarting periodically so the stream keeps hitting
+/// the whole density range instead of converging on sorted sets. Same shape as
+/// the `zeta` / `matching` unit-test corpora and `zeta_diff`'s `SetGen`.
+fn build_corpus(channels: usize, size: usize, rng: &mut Xorshift64) -> Vec<OutputSet<Vec<bool>>> {
+    let restart_period = 3 * channels + 8;
+    let mut out = Vec::with_capacity(size);
+    let mut current = OutputSet::all_values(channels);
+    let mut since_restart = 0usize;
+
+    while out.len() < size {
+        out.push(current.clone());
+        if since_restart >= restart_period {
+            current = OutputSet::all_values(channels);
+            since_restart = 0;
+            continue;
+        }
+        since_restart += 1;
+        let a = rng.below(channels);
+        let b = rng.below(channels);
+        if a != b {
+            current.apply_comparator([a.max(b), a.min(b)]);
+        }
+    }
+
+    out
+}
+
+/// FNV-1a over the packed bitmaps and the pair list. Any change to the inputs
+/// moves this; no change to the *code under test* may.
+fn checksum(packed: &[PackedSet], pairs: &[(usize, usize, bool)]) -> u64 {
+    let mut h = 0xcbf2_9ce4_8422_2325u64;
+    let mut eat = |v: u64| {
+        h ^= v;
+        h = h.wrapping_mul(0x100_0000_01b3);
+    };
+    for set in packed {
+        eat(set.channels() as u64);
+        for &word in set.bits() {
+            eat(word);
+        }
+    }
+    for &(a, b, inv) in pairs {
+        eat(a as u64);
+        eat(b as u64);
+        eat(inv as u64);
+    }
+    h
+}
+
+// ---------------------------------------------------------------------------
+// Timing
+// ---------------------------------------------------------------------------
+
+/// Per-kernel per-round nanoseconds-per-call samples.
+struct Samples {
+    label: &'static str,
+    ns: Vec<f64>,
+}
+
+impl Samples {
+    fn new(label: &'static str, rounds: usize) -> Self {
+        Self {
+            label,
+            ns: Vec::with_capacity(rounds),
+        }
+    }
+
+    fn min(&self) -> f64 {
+        self.ns.iter().cloned().fold(f64::INFINITY, f64::min)
+    }
+
+    fn median(&self) -> f64 {
+        let mut sorted = self.ns.clone();
+        sorted.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        sorted[sorted.len() / 2]
+    }
+}
+
+fn time<F: FnMut()>(calls: usize, mut body: F) -> f64 {
+    let start = Instant::now();
+    body();
+    start.elapsed().as_nanos() as f64 / calls as f64
+}
+
+fn run_width(opt: &Opt, channels: usize) {
+    let mut rng = Xorshift64::new(opt.seed ^ (0x9E37_79B9_7F4A_7C15u64.wrapping_mul(channels as u64)));
+
+    let sets = build_corpus(channels, opt.corpus.max(1), &mut rng);
+    let packed: Vec<PackedSet> = sets
+        .iter()
+        .map(|set| PackedSet::from_bitmap(set.as_ref()))
+        .collect();
+    let blocks: Vec<ChannelBlocks> = packed.iter().map(ChannelBlocks::from_packed).collect();
+
+    // Pairs are drawn once and reused by kernels d and e, so the matching
+    // filter and the exact arbiter are compared on identical work. The
+    // `invert_a` polarity is drawn too, since `LowerInvert` exercises both.
+    let pairs: Vec<(usize, usize, bool)> = (0..opt.pairs.max(1))
+        .map(|_| {
+            let a = rng.below(sets.len());
+            let b = rng.below(sets.len());
+            let inv = rng.next() & 1 != 0;
+            (a, b, inv)
+        })
+        .collect();
+
+    // `subsumes_permuted_packed(A, B)` with `A` complemented, matching
+    // `match_allows(.., invert_a)`'s orientation: only the `a` side inverts.
+    let inverted: Vec<PackedSet> = packed
+        .iter()
+        .map(|set| {
+            let mut copy = *set;
+            copy.invert();
+            copy
+        })
+        .collect();
+
+    println!(
+        "# width={} corpus={} pairs={} rounds={} corpus_checksum=0x{:016x}",
+        channels,
+        sets.len(),
+        pairs.len(),
+        opt.rounds.max(1),
+        checksum(&packed, &pairs),
+    );
+
+    // Warm up every kernel once (page-in, branch predictors, the thread-local
+    // caches inside `subsume.rs`) so round 0 is not systematically the slowest.
+    for set in &sets {
+        black_box(set.abstraction());
+        black_box(set.abstraction_reference());
+    }
+    for set in &packed {
+        black_box(ChannelBlocks::from_packed(set));
+    }
+    for &(a, b, inv) in &pairs {
+        black_box(gamma_has_matching(&blocks[a], &blocks[b], inv));
+        let left = if inv { &inverted[a] } else { &packed[a] };
+        black_box(subsumes_permuted_packed(left, &packed[b]).is_some());
+    }
+
+    let rounds = opt.rounds.max(1);
+    let n_sets = sets.len();
+    let n_pairs = pairs.len();
+
+    let mut abstraction = Samples::new("abstraction", rounds);
+    let mut reference = Samples::new("abstraction_reference", rounds);
+    let mut from_packed = Samples::new("blocks_from_packed", rounds);
+    let mut gamma = Samples::new("gamma_has_matching", rounds);
+    let mut exact = Samples::new("subsumes_permuted", rounds);
+    let mut allows = Samples::new("match_allows", rounds);
+    // Diagnostic split of `blocks_from_packed` into its two halves, so a
+    // regression can be attributed to the popcount pass or to the sort/scatter.
+    let mut counts_only = Samples::new("  .paircounts_packed", rounds);
+    let mut blocks_only = Samples::new("  .blocks_from_counts", rounds);
+
+    let counts: Vec<PairCounts> = packed.iter().map(PairCounts::from_packed).collect();
+
+    for _ in 0..rounds {
+        abstraction.ns.push(time(n_sets, || {
+            for set in &sets {
+                black_box(black_box(set).abstraction());
+            }
+        }));
+        reference.ns.push(time(n_sets, || {
+            for set in &sets {
+                black_box(black_box(set).abstraction_reference());
+            }
+        }));
+        from_packed.ns.push(time(n_sets, || {
+            for set in &packed {
+                black_box(ChannelBlocks::from_packed(black_box(set)));
+            }
+        }));
+        counts_only.ns.push(time(n_sets, || {
+            for set in &packed {
+                black_box(PairCounts::from_packed(black_box(set)));
+            }
+        }));
+        blocks_only.ns.push(time(n_sets, || {
+            for c in &counts {
+                black_box(ChannelBlocks::from_counts(black_box(c)));
+            }
+        }));
+        gamma.ns.push(time(n_pairs, || {
+            for &(a, b, inv) in &pairs {
+                black_box(gamma_has_matching(
+                    black_box(&blocks[a]),
+                    black_box(&blocks[b]),
+                    inv,
+                ));
+            }
+        }));
+        exact.ns.push(time(n_pairs, || {
+            for &(a, b, inv) in &pairs {
+                let left = if inv { &inverted[a] } else { &packed[a] };
+                black_box(subsumes_permuted_packed(black_box(left), black_box(&packed[b])).is_some());
+            }
+        }));
+        // What the `index.rs` guard actually pays per candidate: build the
+        // candidate's blocks, then run the matching. Timed as one body rather
+        // than added up afterwards so the `ChannelBlocks` really does travel
+        // from producer to consumer the way it does in the engine.
+        allows.ns.push(time(n_pairs, || {
+            for &(a, b, inv) in &pairs {
+                let cand = ChannelBlocks::from_packed(black_box(&packed[a]));
+                black_box(gamma_has_matching(&cand, black_box(&blocks[b]), inv));
+            }
+        }));
+    }
+
+    let baseline = exact.min();
+    for s in [
+        &abstraction,
+        &reference,
+        &from_packed,
+        &counts_only,
+        &blocks_only,
+        &gamma,
+        &allows,
+        &exact,
+    ] {
+        println!(
+            "width={} kernel={:<21} min_ns={:>9.2} median_ns={:>9.2} vs_exact={:>7.2}x",
+            channels,
+            s.label,
+            s.min(),
+            s.median(),
+            baseline / s.min(),
+        );
+    }
+}
+
+fn main() {
+    let opt = Opt::from_args();
+
+    assert!(
+        opt.channels_min >= 3,
+        "the search never sees fewer than 3 channels (requested --channels-min {})",
+        opt.channels_min
+    );
+    assert!(
+        opt.channels_min <= opt.channels_max,
+        "--channels-min {} exceeds --channels-max {}",
+        opt.channels_min,
+        opt.channels_max
+    );
+
+    let channels_max = opt.channels_max.min(MAX_CHANNELS);
+    if channels_max < opt.channels_max {
+        eprintln!(
+            "# this build supports at most {} channels; capping --channels-max {} to {}",
+            MAX_CHANNELS, opt.channels_max, channels_max
+        );
+    }
+    assert!(
+        opt.channels_min <= channels_max,
+        "this build supports at most {} channels (requested --channels-min {}); \
+         rebuild with `--features wide12` or `--features wide13`",
+        MAX_CHANNELS,
+        opt.channels_min,
+    );
+
+    println!("# zm_bench seed={} (single-threaded, deterministic)", opt.seed);
+
+    // Global warm-up: the first width measured was otherwise systematically
+    // slow and noisy (median well above min) because the core had not yet
+    // ramped. Burn a fixed wall-clock budget on the real kernels first.
+    {
+        let mut rng = Xorshift64::new(opt.seed);
+        let sets = build_corpus(opt.channels_min, 64, &mut rng);
+        let packed: Vec<PackedSet> = sets
+            .iter()
+            .map(|set| PackedSet::from_bitmap(set.as_ref()))
+            .collect();
+        let start = Instant::now();
+        while start.elapsed().as_millis() < 200 {
+            for set in &packed {
+                black_box(ChannelBlocks::from_packed(black_box(set)));
+            }
+        }
+    }
+
+    for channels in opt.channels_min..=channels_max {
+        run_width(&opt, channels);
+    }
+}
