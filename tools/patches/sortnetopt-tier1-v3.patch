+    /// Builds a permutation array (as tracked by `Subsume::search`'s
+    /// `perms[side]` bookkeeping: see `apply_perm_convention` below) by
+    /// composing `swaps` random transpositions onto the identity.
+    fn random_perm(channels: usize, rng: &mut Xorshift64, swaps: usize) -> Vec<usize> {
+        let mut perm: Vec<usize> = (0..channels).collect();
+        for _ in 0..swaps {
+            if let Some([a, b]) = rng.pair(channels) {
+                perm.swap(a, b);
+            }
+        }
+        perm
+    }
