+/// per candidate.
+#[derive(Clone)]
+pub struct SubsumeFilter {
+    pub packed: PackedSet,
+    pub hist: WVec<u32>,
+    pub hist_rev: WVec<u32>,
+    pub sig: u64,
+    pub sig_rev: u64,
+}
+
+impl SubsumeFilter {
+    pub fn from_packed(packed: PackedSet) -> Self {
+        let channels = packed.channels();
+        let hist = packed.weight_histogram();
+        let hist_rev = packed::reverse_histogram(&hist);
+        let sig = packed::histogram_signature(channels, &hist);
+        let sig_rev = packed::histogram_signature(channels, &hist_rev);
+        Self {
+            packed,
+            hist,
+            hist_rev,
+            sig,
+            sig_rev,
+        }
+    }
+
+    pub fn from_output_set(set: OutputSet<&[bool]>) -> Self {
+        Self::from_packed(PackedSet::from_bitmap(set))
+    }
+
+    pub fn from_packed_bytes(channels: usize, bytes: &[u8]) -> Self {
+        Self::from_packed(PackedSet::from_packed_bytes(channels, bytes))
+    }
