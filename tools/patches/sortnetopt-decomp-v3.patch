+/// Increment the live count for `(channels, popcount)`. Callers must already
+/// have checked [`shell_stats_enabled`] and computed `popcount` themselves
+/// (e.g. `key.iter().map(|b| b.count_ones() as u64).sum()` on the packed
+/// key); this is the sibling of [`record_entry_added`], called from the
+/// same sites in `search::states`.
+#[inline]
+pub fn record_entry_added_shell(channels: usize, popcount: u64) {
+    if channels < MAX_TRACKED_CHANNELS {
+        if let Some(slot) = shell_census_table()[channels].get(popcount as usize) {
+            slot.fetch_add(1, Relaxed);
+        }
+    }
+}
+
+/// Sibling of [`record_entry_removed`]; see [`record_entry_added_shell`].
+#[inline]
+pub fn record_entry_removed_shell(channels: usize, popcount: u64) {
+    if channels < MAX_TRACKED_CHANNELS {
+        if let Some(slot) = shell_census_table()[channels].get(popcount as usize) {
+            slot.fetch_sub(1, Relaxed);
+        }
+    }
+}
