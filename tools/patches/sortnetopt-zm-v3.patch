+//! ZM-V3, Lemma M: the bipartite matching filter over the per-channel
+//! abstraction blocks of [`super::zeta::ChannelBlocks`].
+//!
+//! # The lemma
+//!
+//! For an output set `X` and a channel `i`, let
+//! `v_i(X) in Z^{4(n-1)}` be the per-channel abstraction block: the four
+//! `channel_pair_abstraction([i, j])` groups over `j != i`, each sorted
+//! descending. That is exactly `ChannelBlocks::row(i)`.
+//!
+//! Suppose `pi` is a channel permutation with `pi(A) subset-of B`. Applying
+//! `pi` renames channels, so the quadrant counts of `pi(A)` at the pair
+//! `(pi(i), pi(j))` equal those of `A` at `(i, j)`, and `pi(A) subset-of B`
+//! makes every quadrant count of `pi(A)` at most the corresponding count of
+//! `B`. Hence
+//!
+//! ```text
+//! for all i, all j != i, all groups g:
+//!     quadrant_A(i, j)[g] <= quadrant_B(pi(i), pi(j))[g].
+//! ```
+//!
+//! For fixed `i` and `g`, `j |-> pi(j)` is a bijection from `{j : j != i}` onto
+//! `{j' : j' != pi(i)}` under which each entry of the first multiset is
+//! dominated by its image; sorting both multisets descending therefore
+//! preserves the domination rank by rank. So `v_i(A) <= v_{pi(i)}(B)`
+//! coordinatewise, for *every* `i`.
+//!
+//! In other words `pi` is a perfect matching in the bipartite graph
+//!
+//! ```text
+//! Gamma(A, B) = { (i, j) : v_i(A) <= v_j(B) coordinatewise }.
+//! ```
+//!
+//! Contrapositive: **if `Gamma(A, B)` has no perfect matching then no channel
+//! permutation `pi` satisfies `pi(A) subset-of B`**. That is a sound rejection
+//! of the exact arbiter `subsumes_permuted_packed(A, B)`, and it is one-sided:
+//! it can only ever reject pairs the exact test would also reject.
+//!
+//! # Why it is strictly stronger than the deployed coordinatewise filter
+//!
+//! `OutputSet::abstraction` takes exactly this data and, at each
+//! `(group, rank)` coordinate, sorts the values *across channels*. The
+//! deployed `Lower::test_abstraction` then compares the two sorted vectors
+//! coordinatewise. A perfect matching `pi` of `Gamma` dominates, coordinate by
+//! coordinate, one multiset over channels by the other under a *single*
+//! bijection, which implies the sorted vectors dominate at every coordinate.
+//! So
+//!
+//! ```text
+//! Gamma(A, B) has a perfect matching  ==>  test_abstraction(abs(A), abs(B)),
+//! ```
+//!
+//! i.e. Lemma M rejects everything the coordinatewise test rejects and
+//! sometimes more: the coordinatewise test is free to use a *different*
+//! bijection at each coordinate, Lemma M insists on one bijection for all of
+//! them. The implication is asserted on a random reachable corpus by
+//! [`tests::gamma_implies_coordinatewise`], and the strictness is measured by
+//! the same test.
+//!
+//! # Complement polarity
+//!
+//! Complementing the cube swaps the quadrants `(1,1) <-> (0,0)` and
+//! `(0,1) <-> (1,0)` and leaves the descending order within a group alone, so
+//! it acts on a row as the index permutation `t |-> t ^ 3` (see
+//! `ChannelBlocks`). `invert_a` selects
+//! `ChannelBlocks::row_dominated_by_inverted`, which applies exactly that
+//! relabelling on the fly; no second `ChannelBlocks` is built.
+
+use super::zeta::ChannelBlocks;
+
+/// Adjacency masks are `u16`, so the matching code handles up to 16 channels
+/// -- comfortably above every `MAX_CHANNELS` the `wide12` / `wide13` features
+/// select.
+pub const MAX_MATCH: usize = 16;
+
+/// Does the bipartite graph with left vertices `0..n`, right vertices `0..n`
+/// and `adj[i]` the bitmask of right vertices adjacent to `i` admit a perfect
+/// matching?
+///
+/// Kuhn's augmenting-path algorithm (`O(V * E)` = `O(n^3)` worst case) rather
+/// than Hopcroft-Karp (`O(E sqrt(V))`): at `n <= 13` the whole graph is 13
+/// `u16`s, an augmenting DFS visits at most 13 right vertices with the visited
+/// set held in a single `u16`, and the asymptotic win would be swamped by
+/// Hopcroft-Karp's per-phase BFS bookkeeping. The greedy seed below already
+/// finds the complete matching outright on the overwhelming majority of the
+/// pairs that reach this point, leaving only a handful of augmentations.
+pub fn has_perfect_matching(adj: &[u16], n: usize) -> bool {
+    debug_assert!(n <= MAX_MATCH);
+    debug_assert!(adj.len() >= n);
+    if n == 0 {
+        return true;
+    }
+
+    // Hall pre-checks. Both are instances of Hall's condition on a specific
+    // family of left sets, so failing either genuinely proves no perfect
+    // matching exists:
+    //
+    // * `adj[i] == 0` is Hall on the singleton `{i}`;
+    // * `popcount(union of all adj[i]) < n` is Hall on the whole left side.
+    //
+    // Neither can reject a graph that has a perfect matching, so both are
+    // sound; they only ever save the augmenting search.
+    let mut union = 0u16;
+    for &mask in adj[..n].iter() {
+        if mask == 0 {
+            return false;
+        }
+        union |= mask;
+    }
+    if (union.count_ones() as usize) < n {
+        return false;
+    }
+
+    let mut match_left = [usize::MAX; MAX_MATCH];
+    let mut match_right = [usize::MAX; MAX_MATCH];
+
+    // Greedy seed: take the lowest still-unmatched neighbour of each left
+    // vertex. Purely an optimisation -- the augmenting loop below completes
+    // any partial matching to a maximum one.
+    let mut taken = 0u16;
+    for i in 0..n {
+        let free = adj[i] & !taken;
+        if free != 0 {
+            let j = free.trailing_zeros() as usize;
+            taken |= 1 << j;
+            match_left[i] = j;
+            match_right[j] = i;
+        }
+    }
+
+    for i in 0..n {
+        if match_left[i] != usize::MAX {
+            continue;
+        }
+        let mut visited = 0u16;
+        if !augment(adj, i, &mut visited, &mut match_left, &mut match_right) {
+            // No augmenting path from `i` in the current maximum-so-far
+            // matching: by Berge's lemma the matching is maximum, and it
+            // misses `i`, so there is no perfect matching.
+            return false;
+        }
+    }
+
+    true
+}
+
+/// One augmenting DFS from left vertex `i`. `visited` is the set of right
+/// vertices already explored in this DFS; recursion depth is bounded by the
+/// number of channels (`<= 16`).
+fn augment(
+    adj: &[u16],
+    i: usize,
+    visited: &mut u16,
+    match_left: &mut [usize; MAX_MATCH],
+    match_right: &mut [usize; MAX_MATCH],
+) -> bool {
+    let mut rest = adj[i];
+    while rest != 0 {
+        let j = rest.trailing_zeros() as usize;
+        rest &= rest - 1;
+        let bit = 1u16 << j;
+        if *visited & bit != 0 {
+            continue;
+        }
+        *visited |= bit;
+        let owner = match_right[j];
+        if owner == usize::MAX || augment(adj, owner, visited, match_left, match_right) {
+            match_right[j] = i;
+            match_left[i] = j;
+            return true;
+        }
+    }
+    false
+}
+
+/// The Lemma M test: does `Gamma(A, B)` admit a perfect matching?
+///
+/// `false` is a sound rejection of `exists pi : pi(A) subset-of B`, where `A`
+/// is the set whose blocks are `a` (or its complement, when `invert_a`) and
+/// `B` is the set whose blocks are `b`. `true` is *not* a proof of anything --
+/// the exact arbiter still has to run.
+///
+/// Note the asymmetry of `invert_a`: only the `a` side is complemented, which
+/// is what the two `LowerInvert` branches need (identity vs. complement), and
+/// which is why the two branches must keep their own separate guards rather
+/// than share one disjunctive test.
+pub fn gamma_has_matching(a: &ChannelBlocks, b: &ChannelBlocks, invert_a: bool) -> bool {
+    let channels = a.channels();
+    debug_assert_eq!(channels, b.channels());
+    debug_assert_eq!(a.block_len(), b.block_len());
+    debug_assert!(channels <= MAX_MATCH);
+
+    let mut adj = [0u16; MAX_MATCH];
+    for i in 0..channels {
+        let mut mask = 0u16;
+        for j in 0..channels {
+            let dominated = if invert_a {
+                a.row_dominated_by_inverted(i, b, j)
+            } else {
+                a.row_dominated_by(i, b, j)
+            };
+            if dominated {
+                mask |= 1 << j;
+            }
+        }
+        if mask == 0 {
+            // Hall on `{i}`: short-circuit before building the rest of the
+            // graph. This is the common rejection by a wide margin.
+            return false;
+        }
+        adj[i] = mask;
+    }
+
