+        let target = ShardedSubsumeIndex::new(channels, point_dim);
+        source.for_each_entry(&mut |packed, value, abstraction| {
+            target.restore_entry(packed, value, abstraction);
+        });
+
+        assert_eq!(target.len(), source.len());
+
+        for set in sets.iter() {
+            let abstraction = set.abstraction_prefix(source.point_dim());
+            assert_eq!(
+                target.lookup(set.as_ref(), &abstraction),
+                source.lookup(set.as_ref(), &abstraction),
+                "lookup disagreed after restore"
