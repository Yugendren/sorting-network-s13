+    /// The pre-optimisation `ChannelBlocks::from_counts`: one
+    /// `sort_unstable_by` per `(channel, group)` and a separate scatter. Kept
+    /// as the oracle for the SWAR rank sort that replaced it.
+    fn blocks_rows_by_sorting(counts: &PairCounts) -> Vec<Vec<u16>> {
+        let channels = counts.channels();
+        let mut out = vec![vec![0u16; PAIR_ABSTRACTION_GROUPS * (channels - 1)]; channels];
+        let mut groups = [[0u16; MAX_CHANNELS - 1]; PAIR_ABSTRACTION_GROUPS];
+
+        for channel in 0..channels {
+            let mut k = 0usize;
+            for other in 0..channels {
+                if other == channel {
+                    continue;
+                }
+                let q = counts.quadrants(channel, other);
+                for g in 0..PAIR_ABSTRACTION_GROUPS {
+                    groups[g][k] = q[g] as u16;
+                }
+                k += 1;
+            }
+            for g in 0..PAIR_ABSTRACTION_GROUPS {
+                let slice = &mut groups[g][..k];
+                slice.sort_unstable_by(|a, b| b.cmp(a));
+                for (rank, &v) in slice.iter().enumerate() {
+                    out[channel][PAIR_ABSTRACTION_GROUPS * rank + g] = v;
+                }
+            }
+        }
+
+        out
+    }
+
+    #[test]
+    fn blocks_match_sorted_reference() {
+        for channels in 3..=super::MAX_CHANNELS {
+            for set in corpus(channels, 6, 0x5ea1_0000 + channels as u64) {
+                let packed = PackedSet::from_bitmap(set.as_ref());
+                let counts = PairCounts::from_packed(&packed);
+                let blocks = ChannelBlocks::from_counts(&counts);
+                let want = blocks_rows_by_sorting(&counts);
+                for i in 0..channels {
+                    assert_eq!(blocks.row(i), &want[i][..], "channels={} i={}", channels, i);
+                }
+            }
+        }
+    }
+
+    /// `row_dominated_by` / `row_dominated_by_inverted` compare the full
+    /// `MAX_BLOCK`-wide row instead of `..block`, which is only equivalent
+    /// because the tail is zero in every row. Pin both halves of that: the
+    /// invariant itself, and the agreement with the `..block` definition.
+    #[test]
+    fn row_domination_matches_block_width_definition() {
+        for channels in 3..=super::MAX_CHANNELS {
+            let sets = corpus(channels, 3, 0x7e51_0000 + channels as u64);
+            let blocks = sets
+                .iter()
+                .map(|set| ChannelBlocks::from_packed(&PackedSet::from_bitmap(set.as_ref())))
+                .collect::<Vec<_>>();
+
+            for b in blocks.iter() {
+                for i in 0..MAX_CHANNELS {
+                    let live = if i < channels { b.block_len() } else { 0 };
+                    for t in live..MAX_BLOCK {
+                        assert_eq!(b.rows[i][t], 0, "channels={} i={} t={}", channels, i, t);
+                    }
+                }
+            }
+
+            for a in blocks.iter() {
+                for b in blocks.iter() {
+                    for i in 0..channels {
+                        for j in 0..channels {
+                            let block = a.block_len();
+                            let want = (0..block).all(|t| a.row(i)[t] <= b.row(j)[t]);
+                            let want_inv = (0..block).all(|t| a.row(i)[t] <= b.row(j)[t ^ 3]);
+                            assert_eq!(
+                                a.row_dominated_by(i, b, j),
+                                want,
+                                "channels={} i={} j={}",
+                                channels,
+                                i,
+                                j
+                            );
+                            assert_eq!(
+                                a.row_dominated_by_inverted(i, b, j),
+                                want_inv,
+                                "channels={} i={} j={} (inverted)",
+                                channels,
+                                i,
+                                j
+                            );
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn blocks_complement_is_group_xor3() {
+        for channels in 3..=super::MAX_CHANNELS {
+            for set in corpus(channels, 4, 0xfeed_face + channels as u64) {
+                let packed = PackedSet::from_bitmap(set.as_ref());
+                let blocks = ChannelBlocks::from_packed(&packed);
+                let mut inv = packed;
+                inv.invert();
+                let inv_blocks = ChannelBlocks::from_packed(&inv);
+                for i in 0..channels {
+                    for t in 0..blocks.block_len() {
+                        assert_eq!(
+                            inv_blocks.row(i)[t],
+                            blocks.row(i)[t ^ 3],
+                            "channels={} i={} t={}",
+                            channels,
+                            i,
+                            t
+                        );
+                    }
+                }
+            }
+        }
+    }
