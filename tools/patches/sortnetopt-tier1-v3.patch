+
+    /// All `n!` permutations of `0..n`, generated once via Heap's algorithm
+    /// and reused across every pair for a given `channels` count (only
+    /// called for `channels <= 7`, so at most `5040` permutations).
+    fn all_permutations(n: usize) -> Vec<Vec<usize>> {
+        let mut items: Vec<usize> = (0..n).collect();
+        let mut result = Vec::new();
+        if n == 0 {
+            result.push(items);
+            return result;
+        }
+
+        fn heap(items: &mut Vec<usize>, k: usize, result: &mut Vec<Vec<usize>>) {
+            if k == 1 {
+                result.push(items.clone());
+                return;
+            }
+            for i in 0..k {
+                heap(items, k - 1, result);
+                if k % 2 == 0 {
+                    items.swap(i, k - 1);
+                } else {
+                    items.swap(0, k - 1);
+                }
+            }
+        }
+
+        heap(&mut items, n, &mut result);
+        result
+    }
+
+    /// Generates one `(a, b)` pair via one of three constructions, mixed at
+    /// random: independent random comparator chains (mostly no genuine
+    /// subsumption); a set vs. a randomly channel-permuted copy of itself
+    /// (guaranteed direct hit, since some permutation makes the two sets
+    /// bitmap-equal, and equal sets always mutually subsume); and a set vs.
+    /// a permuted copy with extra comparators applied on top (mixed --
+    /// tested in a random direction, since applying a comparator can move a
+    /// set either strictly below or leave it incomparable to the original
+    /// depending on direction).
+    fn generate_pair(channels: usize, rng: &mut Xorshift64) -> (OutputSet<Vec<bool>>, OutputSet<Vec<bool>>) {
+        match rng.below(3) {
+            0 => {
+                let steps_a = 6 + rng.below(10);
+                let a = random_chain(channels, rng, steps_a);
+                let steps_b = 6 + rng.below(10);
+                let b = random_chain(channels, rng, steps_b);
+                (a, b)
+            }
+            1 => {
+                let steps = 4 + rng.below(8);
+                let b = random_chain(channels, rng, steps);
+                let perm = random_perm(channels, rng, channels);
+                let a = apply_perm_convention(&b, &perm);
+                (a, b)
+            }
+            _ => {
+                let steps = 4 + rng.below(8);
+                let s = random_chain(channels, rng, steps);
+                let perm = random_perm(channels, rng, channels);
+                let mut extra = apply_perm_convention(&s, &perm);
+                for _ in 0..(1 + rng.below(3)) {
+                    if let Some(pair) = rng.pair(channels) {
+                        extra.apply_comparator(pair);
+                    }
+                }
+                if rng.below(2) == 0 {
+                    (extra, s)
+                } else {
+                    (s, extra)
+                }
+            }
+        }
+    }
