+#[cfg(test)]
+mod limits_tests {
+    use super::*;
+    use crate::output_set::OutputSet;
+
+    /// LIMITS-V3: `OutputSetMap` must have a real arm for **every** width from
+    /// 3 to `MAX_CHANNELS`.
+    ///
+    /// This is the specific trap the limits raise had to defuse. Upstream's
+    /// fall-through arms are asymmetric: `get_with_packed` returns `None` and
+    /// `set_with_packed`/`remove_with_packed` hit `unreachable!()`. A width
+    /// with no arm therefore does not fail loudly on the read path — it
+    /// silently reports "not memoised" for every query, which turns the DP
+    /// into an exponential re-exploration and is invisible except as
+    /// inexplicable slowness. Nothing else in the test suite touches widths
+    /// above 6 (`checkpoint::tests::round_trip_states` uses 6), so without
+    /// this test a missing 12- or 13-channel arm would ship.
+    ///
+    /// Covered per width: insert-returns-new, get round-trips the value,
+    /// insert-again-returns-not-new and updates, `for_each_packed_at` visits
+    /// the entry with the right key bytes, `add_len_by_channels` counts it in
+    /// the right census slot, and `remove_with_packed` actually removes.
+    #[test]
+    fn output_set_map_has_an_arm_at_every_width() {
+        for channels in 3..=MAX_CHANNELS {
+            let len = OutputSet::packed_len_for_channels(channels);
+            let mut map: OutputSetMap<u32> = Default::default();
+
+            // Two distinct keys of the right length; the byte pattern varies
+            // along the key so a wrong `array_ref!` length would collide.
+            let key_a: Vec<u8> = (0..len).map(|i| (i as u8).wrapping_mul(31) | 1).collect();
+            let mut key_b = key_a.clone();
+            key_b[len - 1] ^= 0x80;
+
+            assert!(
+                map.set_with_packed(channels, &key_a, 111),
+                "width {}: first insert did not report a new key",
+                channels
+            );
+            assert_eq!(
+                map.get_with_packed(channels, &key_a),
+                Some(111),
+                "width {}: get missed a key that was just set — this is the \
+                 SILENT memoisation loss a missing arm produces",
+                channels
+            );
+            assert_eq!(
+                map.get_with_packed(channels, &key_b),
+                None,
+                "width {}: get returned a value for a key that was never set",
+                channels
+            );
+
+            assert!(
+                !map.set_with_packed(channels, &key_a, 222),
+                "width {}: overwrite reported a new key",
+                channels
+            );
+            assert_eq!(map.get_with_packed(channels, &key_a), Some(222));
+
+            map.set_with_packed(channels, &key_b, 333);
+            assert_eq!(map.len(), 2, "width {}: wrong population", channels);
+
+            let mut census = Census::default();
+            map.add_len_by_channels(&mut census);
+            assert_eq!(
+                census.entries[channels], 2,
+                "width {}: census counted the entries in the wrong slot",
+                channels
+            );
+            assert_eq!(census.total(), 2);
+
+            let mut seen: Vec<(Vec<u8>, u32)> = vec![];
+            map.for_each_packed_at(channels, &mut |packed, value| {
+                seen.push((packed.to_vec(), *value))
+            });
+            seen.sort();
+            let mut want = vec![(key_a.clone(), 222u32), (key_b.clone(), 333u32)];
+            want.sort();
+            assert_eq!(
+                seen, want,
+                "width {}: for_each_packed_at did not reproduce the stored keys \
+                 (checkpointing would silently drop this width)",
+                channels
+            );
+
+            assert!(map.remove_with_packed(channels, &key_a));
+            assert!(!map.remove_with_packed(channels, &key_a));
+            assert_eq!(map.get_with_packed(channels, &key_a), None);
+            assert_eq!(map.get_with_packed(channels, &key_b), Some(333));
+            assert_eq!(map.len(), 1);
+        }
+    }
