+    /// unique sorting comparator.
+    #[test]
+    fn bound1_unique_pair_finds_the_comparator() {
+        let set = set_from_values(3, &[0, 1, 2, 3, 7]);
+        assert_eq!(bound1_unique_pair(set.as_ref()), Some([1, 0]));
+
+        // Sanity: applying it really does sort the set.
+        let mut applied = set.clone();
+        assert!(applied.as_mut().apply_comparator([1, 0]));
+        assert!(applied.as_ref().is_sorted());
+    }
+
+    #[test]
+    fn bound1_unique_pair_rejects_oversized_class() {
+        // Weight-1 class now has 3 members (values 1, 2, 4): not bound 1.
+        let set = set_from_values(3, &[0, 1, 2, 4, 7]);
+        assert_eq!(bound1_unique_pair(set.as_ref()), None);
+    }
+
+    #[test]
+    fn bound1_unique_pair_rejects_inconsistent_pairs() {
+        // Two *different-weight* size-2 classes that disagree on which
+        // channel pair differs, channels = 4:
+        //   weight-1 class {0001, 0010} = {1, 2}: diff 0011 -> pair [1, 0]
+        //   weight-3 class {1110, 1011} = {14, 11}: diff 0101 -> pair [2, 0]
+        // [1,0] != [2,0], so the structural precondition fails.
+        let set = set_from_values(4, &[1, 2, 14, 11]);
+        assert_eq!(bound1_unique_pair(set.as_ref()), None);
+    }
+
+    #[test]
+    fn bound1_unique_pair_rejects_popcount_ne_2() {
+        // Weight-2 class {0011, 1100}: diff = 1111, popcount 4.
+        let set = set_from_values(4, &[0b0011, 0b1100]);
+        assert_eq!(bound1_unique_pair(set.as_ref()), None);
+    }
+
+    #[test]
+    fn halving_ok_matches_max_weight_class() {
+        // channels = 3, weight-1 class has 3 members (values 1,2,4): needs
+        // >= ceil(log2 3) = 2 comparators, so b=2 (cap = 1<<1 = 2) rejects it
+        // and b=3 (cap = 1<<2 = 4) accepts it.
+        let set = set_from_values(3, &[0, 1, 2, 4, 7]);
+        assert!(!halving_ok(set.as_ref(), 2));
+        assert!(halving_ok(set.as_ref(), 3));
+    }
+
+    #[test]
+    fn halving_ok_skips_when_shift_saturates() {
+        let set = set_from_values(3, &[0, 1, 2, 4, 7]);
+        assert!(halving_ok(set.as_ref(), 255));
+    }
+
+    #[test]
+    fn live_support_counts_disagreeing_channels_within_a_weight_class() {
+        // channels = 3, weight-1 class {001, 010} (values 1, 2): OR=011,
+        // AND=000, so both channel 0 and channel 1 are live; channel 2 is
+        // not touched by any weight-1 disagreement and no other class has
+        // >= 2 members, so L = {0, 1}, |L| = 2.
+        let set = set_from_values(3, &[0, 1, 2, 3, 7]);
+        assert_eq!(live_support(set.as_ref()), 2);
+    }
+
+    #[test]
+    fn live_support_zero_when_sorted() {
+        // A genuinely sorted chain: one vector per weight, so every weight
+        // class has < 2 members and L is empty.
+        let set = set_from_values(3, &[0, 1, 3, 7]);
+        assert!(set.as_ref().is_sorted());
+        assert_eq!(live_support(set.as_ref()), 0);
+    }
+
+    #[test]
+    fn live_budget_ok_matches_live_support() {
+        let set = set_from_values(3, &[0, 1, 2, 3, 7]);
+        // live_support == 2, so b-1 must be >= 1, i.e. b >= 2.
+        assert!(!live_budget_ok(set.as_ref(), 1));
+        assert!(live_budget_ok(set.as_ref(), 2));
+    }
+
+    #[test]
+    fn env_defaults_are_off() {
+        // These read real process environment variables; in a default test
+        // run (no SORTNETOPT_ENDGAME* set) they must be off/default, which
+        // is the G1 inertness contract the whole feature depends on.
+        if env::var("SORTNETOPT_ENDGAME").is_err() {
+            assert!(!enabled());
+        }
+        if env::var("SORTNETOPT_ENDGAME_AUDIT").is_err() {
+            assert!(!audit_enabled());
+        }
+        if env::var("SORTNETOPT_ENDGAME_BUDGET").is_err() {
+            assert_eq!(budget_cap(), 4);
+        }
+    }
+}
