+    #[test]
+    fn hist_subsumes_signature_implication_random() {
+        for channels in 1..=MAX_CHANNELS {
+            let mut rng = Xorshift64::new(0xA5A5_5A5A ^ (channels as u64));
+            let len = channels + 1;
+
+            for _ in 0..300 {
+                // Ordered pair: b = a + nonneg noise, so hist_subsumes(a, b)
+                // is guaranteed -- exercises the "implication must hold"
+                // side on every iteration.
+                let a: WVec<u32> = (0..len).map(|_| rng.below(40) as u32).collect();
+                let b: WVec<u32> = a.iter().map(|&av| av + rng.below(20) as u32).collect();
+                assert!(hist_subsumes(&a, &b));
+                let sig_a = histogram_signature(channels, &a);
+                let sig_b = histogram_signature(channels, &b);
+                assert_eq!(
+                    sig_a & !sig_b,
+                    0,
+                    "channels={channels} a={a:?} b={b:?} sig_a={sig_a:#x} sig_b={sig_b:#x}"
+                );
+
+                // Independent (mostly unordered) pair: only check the
+                // implication when hist_subsumes actually holds.
+                let c: WVec<u32> = (0..len).map(|_| rng.below(40) as u32).collect();
+                let d: WVec<u32> = (0..len).map(|_| rng.below(40) as u32).collect();
+                if hist_subsumes(&c, &d) {
+                    let sig_c = histogram_signature(channels, &c);
+                    let sig_d = histogram_signature(channels, &d);
+                    assert_eq!(sig_c & !sig_d, 0, "channels={channels} c={c:?} d={d:?}");
+                }
+
+                // hist_subsumes_inverted(a, b) must agree with the
+                // reverse-then-hist_subsumes definition, and the inverted
+                // implication must hold whenever it applies.
+                let rev_a = reverse_histogram(&a);
+                assert_eq!(hist_subsumes_inverted(&a, &b), hist_subsumes(&rev_a, &b));
+                if hist_subsumes_inverted(&c, &d) {
+                    let sig_rev_c = histogram_signature(channels, &reverse_histogram(&c));
+                    let sig_d = histogram_signature(channels, &d);
+                    assert_eq!(sig_rev_c & !sig_d, 0, "channels={channels} c={c:?} d={d:?}");
+                }
+            }
+        }
+    }
